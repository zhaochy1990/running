# stride-web image: static Vite SPA (no Node/Hono BFF). Caddy is the single
# ingress that routes /api/* to the backends; this container only serves the
# built SPA + strength illustration assets.
#
#   docker build -f Dockerfile.web -t stride-web \
#     --build-arg VITE_AUTH_CLIENT_ID=... --build-arg VITE_AMAP_KEY=... \
#     --build-arg VITE_API_BASE_URL=https://api.stride-running.cn .

# ---- Stage 1: build the SPA (Vite) ----
FROM node:24-alpine AS spa-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install
COPY frontend/ ./

# Vite bakes VITE_* into the bundle at build time — no runtime injection path.
# (AMap key/securityJsCode are gated by the AMap console domain whitelist, not
# secrecy; sourced from stride-kv-common AKV in CI.)
# VITE_API_BASE_URL: the API gateway the browser calls directly (cross-origin;
# CORS must allow the SPA origin). Defaults to the prod gateway.
ARG VITE_AUTH_CLIENT_ID
ARG VITE_APPLICATIONINSIGHTS_CONNECTION_STRING
ARG VITE_AMAP_KEY
ARG VITE_AMAP_SECURITY_CODE
ARG VITE_GO_ONBOARDING=true
ARG VITE_API_BASE_URL=https://api.stride-running.cn
ENV VITE_AUTH_CLIENT_ID=$VITE_AUTH_CLIENT_ID \
    VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=$VITE_APPLICATIONINSIGHTS_CONNECTION_STRING \
    VITE_AMAP_KEY=$VITE_AMAP_KEY \
    VITE_AMAP_SECURITY_CODE=$VITE_AMAP_SECURITY_CODE \
    VITE_GO_ONBOARDING=$VITE_GO_ONBOARDING \
    VITE_API_BASE_URL=$VITE_API_BASE_URL

RUN npm run build

# ---- Stage 2: runtime (nginx static) ----
FROM nginx:1.27-alpine
WORKDIR /usr/share/nginx/html

# Built SPA + strength illustration library (served same-origin relative to the
# SPA host — Caddy routes /strength_illustrations/* to this container).
COPY --from=spa-build /app/frontend/dist /usr/share/nginx/html
COPY strength_illustrations/output /usr/share/nginx/html/strength_illustrations/output
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Keep the ingress target port at 8080 (matches the previous BFF container, so
# the ACA ingress port doesn't change).
EXPOSE 8080
