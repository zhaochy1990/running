# stride-web image (ADR 0017): static Vite SPA + Node/Hono BFF, the single
# front door. Built and deployed independently of the Python backend image.
#
#   docker build -f Dockerfile.web -t stride-web \
#     --build-arg VITE_AUTH_CLIENT_ID=... --build-arg VITE_AMAP_KEY=... . \
#   docker run -p 8080:8080 \
#     -e PYTHON_API_URL=https://stride-app... \
#     -e AUTH_UPSTREAM_URL=https://auth... \
#     stride-web

# ---- Stage 1: build the SPA (Vite) ----
FROM node:24-alpine AS spa-build
WORKDIR /app/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install
COPY frontend/ ./

# Vite bakes VITE_* into the bundle at build time — no runtime injection path.
# (AMap key/securityJsCode are gated by the AMap console domain whitelist, not
# secrecy; sourced from stride-kv-common AKV in CI.) NOTE: VITE_AUTH_BASE_URL is
# no longer used for request routing (auth goes same-origin via the BFF), but is
# kept as a build arg for backward compatibility / the Vite dev-proxy fallback.
ARG VITE_AUTH_BASE_URL
ARG VITE_AUTH_CLIENT_ID
ARG VITE_APPLICATIONINSIGHTS_CONNECTION_STRING
ARG VITE_AMAP_KEY
ARG VITE_AMAP_SECURITY_CODE
ARG VITE_GO_ONBOARDING=true
ENV VITE_AUTH_BASE_URL=$VITE_AUTH_BASE_URL \
    VITE_AUTH_CLIENT_ID=$VITE_AUTH_CLIENT_ID \
    VITE_APPLICATIONINSIGHTS_CONNECTION_STRING=$VITE_APPLICATIONINSIGHTS_CONNECTION_STRING \
    VITE_AMAP_KEY=$VITE_AMAP_KEY \
    VITE_AMAP_SECURITY_CODE=$VITE_AMAP_SECURITY_CODE \
    VITE_GO_ONBOARDING=$VITE_GO_ONBOARDING

RUN npm run build

# ---- Stage 2: build the BFF (tsc) ----
FROM node:24-alpine AS bff-build
WORKDIR /app/server
COPY frontend/server/package.json frontend/server/package-lock.json ./
RUN npm ci
COPY frontend/server/ ./
RUN npm run build
# Re-resolve to production-only deps for the runtime image.
RUN npm ci --omit=dev

# ---- Stage 3: runtime ----
FROM node:24-alpine
WORKDIR /app/server
ENV NODE_ENV=production

# BFF: compiled output + production node_modules.
COPY --from=bff-build /app/server/dist ./dist
COPY --from=bff-build /app/server/node_modules ./node_modules
COPY --from=bff-build /app/server/package.json ./package.json

# Served static: built SPA + strength illustration library (moved into the web
# image per ADR 0017 — the Python API returns relative /strength_illustrations
# URLs the browser fetches here, same-origin).
COPY --from=spa-build /app/frontend/dist /app/web/dist
COPY strength_illustrations/output /app/web/strength_illustrations/output

# Absolute static roots (serveStatic + readFileSync accept absolute paths).
# PYTHON_API_URL / AUTH_UPSTREAM_URL / GO_API_URL are injected at deploy time;
# the BFF fails fast at boot if the required ones are missing.
ENV STATIC_DIR=/app/web/dist \
    STRENGTH_DIR=/app/web/strength_illustrations/output \
    PORT=8080 \
    STRIDE_ROUTE_GET_USERS_ME_MASTER_PLAN_CURRENT=go \
    STRIDE_ROUTE_GET_USERS_ME_TRAINING_GOAL=go \
    STRIDE_ROUTE_POST_USERS_ME_TRAINING_GOAL=go \
    STRIDE_ROUTE_PUT_USERS_ME_TRAINING_GOAL=go \
    STRIDE_ROUTE_GET_USERS_ME_PROFILE=go \
    STRIDE_ROUTE_POST_USERS_ME_PROFILE=go \
    STRIDE_ROUTE_GET_USERS_ME_WATCH=go \
    STRIDE_ROUTE_DELETE_USERS_ME_WATCH=go \
    STRIDE_ROUTE_DELETE_USERS_ME=go \
    STRIDE_ROUTE_POST_USERS_ME_WATCH_LOGIN=go \
    STRIDE_ROUTE_POST_USER_SYNC=go \
    STRIDE_ROUTE_GET_PIPELINES_RUNID=go \
    STRIDE_ROUTE_GET_JOBS_JOBID=go \
    STRIDE_ROUTE_GET_USERS_USER_PIPELINES=go \
    STRIDE_ROUTE_GET_USER_ACTIVITIES=go \
    STRIDE_ROUTE_GET_USER_ACTIVITIES_LABELID=go \
    STRIDE_ROUTE_GET_USER_HEALTH=go \
    STRIDE_ROUTE_GET_USER_HRV=go \
    STRIDE_ROUTE_GET_USER_PMC=go \
    STRIDE_ROUTE_GET_USER_STRIDE_TRAINING_LOAD=go \
    STRIDE_ROUTE_GET_USER_STRIDE_ZONES=go

EXPOSE 8080
CMD ["node", "dist/index.js"]
