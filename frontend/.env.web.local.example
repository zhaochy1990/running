# Local web frontend dev. The frontend is a static container; in dev the SPA uses
# relative /api/* and the Vite dev server proxies them to the API gateway
# (server-side, no browser CORS). VITE_API_BASE_URL stays unset locally.
VITE_DEV_PORT=5174
VITE_AUTH_CLIENT_ID=app_62978bf2803346878a2e4805
VITE_GO_ONBOARDING=true

# Vite dev proxy targets (server-side forwarding; the browser only talks to the
# dev server, so no CORS is involved). Defaults below are the prod gateway and
# the prod static frontend host.
VITE_DEV_API_PROXY=https://api.stride-running.cn
VITE_DEV_STRENGTH_PROXY=https://stride-running.cn
