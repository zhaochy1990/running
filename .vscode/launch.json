{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    //
    // coach_agent_api debugging. It is an ESM + TypeScript package compiled by
    // `tsc` to `dist/` (sourceMap: true in each package's tsconfig), so the
    // Node debugger resolves `.map` files and you can step through the original
    // TS. `outFiles` must cover ALL three workspace packages so a breakpoint in
    // @stride/contract or coach_agent source also binds.
    //
    // Prerequisites before F5:
    //   - Node 24 (`node -v`).
    //   - MySQL from `src/go/docker-compose.yml` dev profile is up:
    //       docker compose --profile dev up -d
    //     The API eagerly connects to MySQL at startup, including for /health.
    //   - The persistence database `coach_agent` exists (docker dev only creates
    //     `stride`). Create it once if missing:
    //       docker exec -i <mysql-container> mysql -uroot -pdevroot -e 'CREATE DATABASE IF NOT EXISTS coach_agent'
    //   - JWT public key `src/coach_agent_api/config/auth-public.pem` (committed; already on disk).
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "test:api",
            "runtimeExecutable": "pnpm",
            "cwd": "${workspaceFolder}/src/coach_agent_api",
            "runtimeArgs": [
                "run",
                "dev"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/src/coach_agent_api/dist/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "tests:coach_agent",
            "runtimeExecutable": "pnpm",
            "cwd": "${workspaceFolder}/src/coach_agent_api",
            "runtimeArgs": [
                "run",
                "test:deepagent"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/src/coach_agent_api/dist/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true
        },
        {
            "type": "node",
            "request": "launch",
            "name": "tests:qa",
            "runtimeExecutable": "pnpm",
            "cwd": "${workspaceFolder}/src/coach_agent_api",
            "runtimeArgs": [
                "run",
                "test:deepagent:qa"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/src/coach_agent_api/dist/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "env": {
                "LANGFUSE_PUBLIC_KEY":"pk-lf-eaa02a6b-43d1-4736-8f8b-9b673e4f3300",
                "LANGFUSE_SECRET_KEY":"sk-lf-f9ed8da7-a7e0-4c92-8e07-8034aa3ea482",
                "LANGFUSE_BASE_URL":"http://localhost:4000"
            }
        },
        {
            "type": "node",
            "request": "launch",
            "name": "weekly-plan-graph",
            "runtimeExecutable": "pnpm",
            "cwd": "${workspaceFolder}/src/coach_agent_api",
            "runtimeArgs": [
                "run",
                "test:weekly-plan-graph",
                "zhaochaoyi"
            ],
            "skipFiles": [
                "<node_internals>/**"
            ],
            "outFiles": [
                "${workspaceFolder}/src/coach_agent_api/dist/**/*.js"
            ],
            "sourceMaps": true,
            "console": "integratedTerminal",
            "autoAttachChildProcesses": true,
            "env": {
                "LANGFUSE_PUBLIC_KEY":"pk-lf-eaa02a6b-43d1-4736-8f8b-9b673e4f3300",
                "LANGFUSE_SECRET_KEY":"sk-lf-f9ed8da7-a7e0-4c92-8e07-8034aa3ea482",
                "LANGFUSE_BASE_URL":"http://localhost:4000",
                "STRIDE_COACH_ENV":"prod",
            },
            "nodeVersionHint": 24
        }
    ]
}
