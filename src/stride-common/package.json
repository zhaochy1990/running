{
  "name": "@stride/common",
  "version": "1.0.0",
  "description": "Shared utilities for the STRIDE TypeScript/Node packages (pino logger, ...).",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tsc": "node node_modules/typescript/lib/tsc.js",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run tsc",
    "test": "npm run build && node --test dist/*.test.js dist/llm/*.test.js",
    "typecheck:e2e": "node node_modules/typescript/lib/tsc.js -p tsconfig.e2e.json",
    "test:e2e": "npm run build && npm run typecheck:e2e && node --test e2e/models.test.ts",
    "format": "biome format --write src scripts e2e",
    "lint": "biome lint src scripts e2e",
    "check": "biome check src scripts e2e",
    "check:fix": "biome check --write src scripts e2e"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@langchain/core": "^1.2.5",
    "@langchain/openai": "^1.5.6",
    "convict": "^6.2.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/convict": "^6.1.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
