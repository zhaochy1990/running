{
  "name": "@stride/common",
  "version": "1.0.0",
  "description": "Shared utilities for the STRIDE TypeScript/Node packages (pino logger, ...).",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tsc": "node node_modules/typescript/lib/tsc.js",
    "clean": "rm -rf dist",
    "build": "npm run clean && npm run tsc",
    "test": "npm run build && node --test dist/*.test.js",
    "format": "biome format --write src scripts",
    "lint": "biome lint src scripts",
    "check": "biome check src scripts",
    "check:fix": "biome check --write src scripts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
