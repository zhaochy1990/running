# Copy to .env and fill in real values. NEVER commit .env (it holds secrets).
# Loaded by docker-compose (env_file) and read by the worker via os.Getenv.

# --- required secrets ---
# MySQL DSN (go-sql-driver format). The worker forces parseTime=true & loc=UTC.
#   Local dev (compose --profile dev):
#     root:devroot@tcp(mysql:3306)/stride
#   Prod (TencentDB):
#     stride:CHANGEME@tcp(<tencentdb-host>:3306)/stride
STRIDE_WORKER_MYSQL_DSN=root:devroot@tcp(mysql:3306)/stride

# RabbitMQ AMQP URL.
#   Local/CVM (co-located broker): amqp://guest:guest@rabbitmq:5672/
#   Later (TDMQ for RabbitMQ):     amqp://<user>:<pass>@<tdmq-host>:5672/<vhost>
STRIDE_WORKER_AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# --- optional (defaults shown) ---
# STRIDE_WORKER_WORK_QUEUE=stride.jobs
# STRIDE_WORKER_RETRY_QUEUE=stride.jobs.retry
# STRIDE_WORKER_POISON_QUEUE=stride.jobs.poison
# STRIDE_WORKER_MAX_ATTEMPTS=5
# STRIDE_WORKER_BASE_BACKOFF=5s
# STRIDE_WORKER_MAX_BACKOFF=5m
# STRIDE_WORKER_PREFETCH=1
# STRIDE_WORKER_HEALTH_ADDR=:8081
# STRIDE_WORKER_LOG_LEVEL=info

# --- local dev MySQL container (compose --profile dev) ---
# MYSQL_ROOT_PASSWORD=devroot
# MYSQL_DATABASE=stride
