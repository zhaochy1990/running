# Copy to .env and fill in real values. NEVER commit .env (it holds secrets).
# Loaded by docker-compose (env_file) and overlaid onto config.yml by the worker.
#
# Non-secret defaults live in config.yml. Any key there can be overridden by an
# env var named STRIDE_WORKER_<PATH> with "-"/"." replaced by "_", e.g.
#   queues.work        -> STRIDE_WORKER_QUEUES_WORK
#   retry.max-attempts -> STRIDE_WORKER_RETRY_MAX_ATTEMPTS
#   runtime.prefetch   -> STRIDE_WORKER_RUNTIME_PREFETCH
#   logger.level       -> STRIDE_WORKER_LOGGER_LEVEL

# --- required secrets (env-only; kept out of config.yml) ---
# MySQL DSN (go-sql-driver format). The worker forces parseTime=true & loc=UTC.
#   Local dev (compose --profile dev):  root:devroot@tcp(mysql:3306)/stride
#   Prod (TencentDB):                   stride:CHANGEME@tcp(<host>:3306)/stride
STRIDE_WORKER_MYSQL_DSN=root:devroot@tcp(mysql:3306)/stride

# RabbitMQ AMQP URL.
#   Local/CVM (co-located broker): amqp://guest:guest@rabbitmq:5672/
#   Later (TDMQ for RabbitMQ):     amqp://<user>:<pass>@<tdmq-host>:5672/<vhost>
STRIDE_WORKER_AMQP_URL=amqp://guest:guest@rabbitmq:5672/

# --- optional overrides (defaults in config.yml) ---
# CONFIG_PATH=/app/config.yml
# STRIDE_WORKER_LOGGER_LEVEL=info
# STRIDE_WORKER_QUEUES_WORK=stride.jobs
# STRIDE_WORKER_RETRY_MAX_ATTEMPTS=5
# STRIDE_WORKER_RETRY_BASE_BACKOFF=5s
# STRIDE_WORKER_RETRY_MAX_BACKOFF=5m
# STRIDE_WORKER_RUNTIME_PREFETCH=1
# STRIDE_WORKER_RUNTIME_HEALTH_ADDR=:8081

# --- local dev MySQL container (compose --profile dev) ---
# MYSQL_ROOT_PASSWORD=devroot
# MYSQL_DATABASE=stride
