{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stride-running.cn/schemas/strength-workout-v1.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "strength-workout/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "exercises": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "canonical_id": {
            "type": "string",
            "minLength": 1
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "sets": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "target_kind": {
            "type": "string",
            "enum": [
              "reps",
              "time_s"
            ]
          },
          "target_value": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "rest_seconds": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "note": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "provider_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^T\\d+$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "canonical_id",
          "display_name",
          "sets",
          "target_kind",
          "target_value",
          "rest_seconds",
          "note",
          "provider_id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "name",
    "date",
    "note",
    "exercises"
  ],
  "additionalProperties": false
}
