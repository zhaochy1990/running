{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stride-running.cn/schemas/run-workout-v1-lenient.json",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "run-workout/v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "note": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "blocks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "repeat": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "steps": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_kind": {
                  "type": "string",
                  "enum": [
                    "warmup",
                    "work",
                    "recovery",
                    "cooldown",
                    "rest"
                  ]
                },
                "duration": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "distance_m",
                            "time_s"
                          ]
                        },
                        "value": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "open"
                        },
                        "value": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "kind",
                        "value"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "target": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "enum": [
                            "pace_s_km",
                            "hr_bpm",
                            "power_w",
                            "cadence_spm"
                          ]
                        },
                        "low": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "high": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        }
                      },
                      "required": [
                        "kind",
                        "low",
                        "high"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "open"
                        },
                        "low": {
                          "type": "null"
                        },
                        "high": {
                          "type": "null"
                        }
                      },
                      "required": [
                        "kind",
                        "low",
                        "high"
                      ],
                      "additionalProperties": false
                    }
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hr_cap_bpm": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rest": {
                  "anyOf": [
                    {
                      "oneOf": [
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "time_s",
                                "hr_bpm"
                              ]
                            },
                            "value": {
                              "type": "number",
                              "exclusiveMinimum": 0
                            }
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        },
                        {
                          "type": "object",
                          "properties": {
                            "kind": {
                              "type": "string",
                              "const": "manual"
                            },
                            "value": {
                              "type": "null"
                            }
                          },
                          "required": [
                            "kind",
                            "value"
                          ],
                          "additionalProperties": false
                        }
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "step_kind",
                "duration",
                "target"
              ]
            }
          }
        },
        "required": [
          "repeat",
          "steps"
        ]
      }
    }
  },
  "required": [
    "name",
    "date",
    "blocks"
  ]
}
