{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "requested_mode": {
      "type": "string",
      "enum": [
        "general_fitness",
        "base_development",
        "weight_management",
        "new_season",
        "continue_existing",
        "replan_remaining_season",
        "race_salvage",
        "taper_only",
        "completion_strategy",
        "post_race_transition",
        "return_to_run",
        "multi_race_season",
        "review_existing_strategy",
        "coach_collaboration",
        "strategy_preview",
        "scenario_comparison",
        "baseline_assessment",
        "goal_negotiation",
        "multi_cycle_development"
      ]
    },
    "requested_modifiers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goals": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "race_name": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "distance": {
            "type": "string",
            "enum": [
              "FM",
              "HM"
            ]
          },
          "race_date": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "target_time": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{1,2}:[0-5]\\d:[0-5]\\d$"
              },
              {
                "type": "null"
              }
            ]
          },
          "finish_only": {
            "type": "boolean"
          },
          "priority": {
            "type": "string",
            "enum": [
              "A",
              "B",
              "C"
            ]
          }
        },
        "required": [
          "race_name",
          "distance",
          "race_date",
          "target_time",
          "finish_only",
          "priority"
        ],
        "additionalProperties": false
      }
    },
    "availability": {
      "type": "object",
      "properties": {
        "weekly_run_days_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "available_training_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              },
              "start_time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end_time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "required": [
              "day",
              "start_time",
              "end_time"
            ],
            "additionalProperties": false
          }
        },
        "unavailable_days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "max_session_duration_min": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "allows_double_sessions": {
          "type": "boolean"
        },
        "preferred_long_run_day": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday",
                "sunday"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "strength_sessions_per_week": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "strength_available_days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        }
      },
      "required": [
        "weekly_run_days_max",
        "available_training_windows",
        "unavailable_days",
        "allows_double_sessions",
        "preferred_long_run_day",
        "strength_sessions_per_week",
        "strength_available_days"
      ],
      "additionalProperties": false
    },
    "injury_declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "current",
              "historical"
            ]
          },
          "body_area": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "training_impact": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "body_area",
          "status",
          "training_impact"
        ],
        "additionalProperties": false
      }
    },
    "environment_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "travel_constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "preferences": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "prohibited_arrangements": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "active_plan_action": {
      "type": "string",
      "enum": [
        "none",
        "continue",
        "replan_remaining",
        "replace",
        "review_only"
      ]
    },
    "source_artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "comparison_hypotheses": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "user_confirmations": {
      "type": "object",
      "properties": {
        "intake_complete": {
          "type": "boolean",
          "const": true
        },
        "goals_confirmed": {
          "type": "boolean",
          "const": true
        },
        "availability_confirmed": {
          "type": "boolean",
          "const": true
        },
        "injury_history_confirmed": {
          "type": "boolean",
          "const": true
        },
        "constraints_confirmed": {
          "type": "boolean",
          "const": true
        }
      },
      "required": [
        "intake_complete",
        "goals_confirmed",
        "availability_confirmed",
        "injury_history_confirmed",
        "constraints_confirmed"
      ],
      "additionalProperties": false
    },
    "requested_as_of": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "request_id",
    "requested_mode",
    "requested_modifiers",
    "goals",
    "availability",
    "injury_declarations",
    "environment_constraints",
    "travel_constraints",
    "preferences",
    "prohibited_arrangements",
    "active_plan_action",
    "user_confirmations"
  ],
  "additionalProperties": false
}
