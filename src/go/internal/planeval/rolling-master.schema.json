{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "start_date": {
      "type": "string",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
    },
    "total_weeks": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "goal": {
      "type": "object",
      "properties": {
        "race_name": {
          "type": "string",
          "minLength": 1
        },
        "distance": {
          "type": "string",
          "enum": [
            "FM",
            "HM"
          ]
        },
        "race_date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "target_time": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "race_name",
        "distance",
        "race_date",
        "target_time"
      ]
    },
    "availability": {
      "type": "object",
      "properties": {
        "available_training_windows": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "day": {
                "type": "string",
                "enum": [
                  "monday",
                  "tuesday",
                  "wednesday",
                  "thursday",
                  "friday",
                  "saturday",
                  "sunday"
                ]
              },
              "start_time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              },
              "end_time": {
                "type": "string",
                "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
              }
            },
            "required": [
              "day",
              "start_time",
              "end_time"
            ],
            "additionalProperties": false
          }
        },
        "unavailable_days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "monday",
              "tuesday",
              "wednesday",
              "thursday",
              "friday",
              "saturday",
              "sunday"
            ]
          }
        },
        "allows_double_sessions": {
          "type": "boolean"
        },
        "weekly_run_days_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      },
      "required": [
        "weekly_run_days_max"
      ],
      "additionalProperties": {}
    },
    "policy": {
      "type": "object",
      "properties": {
        "phases": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "canonical": {
                "type": "string",
                "enum": [
                  "recovery",
                  "foundation",
                  "early_quality",
                  "transition_quality",
                  "final_quality"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "start_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "end_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "primary_goal": {
                "type": "string",
                "enum": [
                  "recovery",
                  "aerobic_base",
                  "speed",
                  "threshold",
                  "race_specificity"
                ]
              },
              "training_goal": {
                "type": "string",
                "minLength": 1
              },
              "block_mode": {
                "type": "string",
                "enum": [
                  "light",
                  "progressive",
                  "progressive_quality",
                  "plateau"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "canonical",
              "name",
              "start_week",
              "end_week",
              "primary_goal",
              "training_goal",
              "block_mode",
              "rationale"
            ]
          }
        },
        "taper_weeks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "milestones": {
          "minItems": 1,
          "maxItems": 8,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "phase",
              "signal",
              "criterion"
            ]
          }
        },
        "gates": {
          "minItems": 2,
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "action_if_missed": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "phase",
              "signal",
              "criterion",
              "action_if_missed"
            ]
          }
        },
        "volume_bands": {
          "minItems": 1,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "weekly_km_min": {
                "type": "number",
                "minimum": 0
              },
              "weekly_km_max": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "phase",
              "weekly_km_min",
              "weekly_km_max"
            ]
          }
        }
      },
      "required": [
        "phases",
        "taper_weeks",
        "milestones",
        "gates",
        "volume_bands"
      ]
    },
    "skeleton": {
      "type": "object",
      "properties": {
        "weeks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canonical": {
                "type": "string",
                "enum": [
                  "recovery",
                  "foundation",
                  "early_quality",
                  "transition_quality",
                  "final_quality"
                ]
              },
              "block": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "role": {
                "type": "string",
                "enum": [
                  "progress",
                  "absorb",
                  "taper",
                  "race"
                ]
              },
              "km": {
                "type": "number",
                "minimum": 0
              },
              "lr": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "q": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "week",
              "canonical",
              "block",
              "role",
              "km",
              "lr",
              "q"
            ]
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "canonical": {
                "type": "string",
                "enum": [
                  "recovery",
                  "foundation",
                  "early_quality",
                  "transition_quality",
                  "final_quality"
                ]
              },
              "start_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "end_week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "absorb_weeks": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                }
              },
              "boundary": {
                "type": "string",
                "enum": [
                  "phase_start",
                  "absorb_cut"
                ]
              }
            },
            "required": [
              "block",
              "canonical",
              "start_week",
              "end_week",
              "absorb_weeks",
              "boundary"
            ]
          }
        },
        "recovery_policy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "enum": [
                  "normal",
                  "fatigue",
                  "overshoot"
                ]
              },
              "trigger": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "type": "string",
                "minLength": 1
              },
              "depth": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "trigger",
              "action",
              "depth"
            ]
          }
        },
        "strength_policy": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "canonical": {
                "type": "string",
                "enum": [
                  "recovery",
                  "foundation",
                  "early_quality",
                  "transition_quality",
                  "final_quality"
                ]
              },
              "strength_focus": {
                "type": "string",
                "minLength": 1
              },
              "quality_family": {
                "type": "string",
                "minLength": 1
              },
              "strides_note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "canonical",
              "strength_focus",
              "quality_family",
              "strides_note"
            ]
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "pass": {
                "type": "boolean"
              },
              "detail": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "pass",
              "detail"
            ]
          }
        },
        "milestones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "signal": {
                "type": "string",
                "minLength": 1
              },
              "criterion": {
                "type": "string",
                "minLength": 1
              },
              "week": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "phase",
              "signal",
              "criterion",
              "week"
            ]
          }
        }
      },
      "required": [
        "weeks",
        "blocks",
        "recovery_policy",
        "strength_policy",
        "checks",
        "milestones"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "as_of": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "vdot": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "vdot_source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "seed": {
          "type": "object",
          "properties": {
            "ctl": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "atl": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "ctl",
            "atl"
          ]
        },
        "coefficient_version": {
          "type": "string",
          "minLength": 1
        },
        "projection": {
          "type": "object",
          "properties": {
            "capped": {
              "type": "boolean"
            },
            "residual": {
              "type": "number"
            }
          },
          "required": [
            "capped",
            "residual"
          ]
        }
      },
      "required": [
        "as_of",
        "vdot",
        "vdot_source",
        "seed",
        "coefficient_version",
        "projection"
      ]
    }
  },
  "required": [
    "start_date",
    "total_weeks",
    "goal",
    "availability",
    "policy",
    "skeleton",
    "anchor"
  ],
  "additionalProperties": {}
}
