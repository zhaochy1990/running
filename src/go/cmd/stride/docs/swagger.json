{
    "swagger": "2.0",
    "info": {
        "description": "HTTP API fronting the STRIDE worker: create and track async jobs and pipeline runs, and manage user profile, onboarding, and watch-provider login.",
        "title": "STRIDE API",
        "contact": {},
        "version": "1.0"
    },
    "paths": {
        "/api/users/me/profile": {
            "get": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Get the current user's profile, onboarding state and features",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.profileResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            },
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Persists the five onboarding core fields, marks profile_ready, and best-effort mirrors the display name to the auth-service.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Save the current user's basic profile",
                "parameters": [
                    {
                        "description": "Profile core fields",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.profileInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "boolean"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "422": {
                        "description": "Unprocessable Entity",
                        "schema": {
                            "$ref": "#/definitions/api.validationErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/api/users/me/watch/login": {
            "post": {
                "security": [
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Authenticates the watch account, persists credentials, and marks watch_ready. Provider is selected in the body; region applies to Garmin. Triggers no sync.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "users"
                ],
                "summary": "Connect a watch provider (COROS/Garmin)",
                "parameters": [
                    {
                        "description": "Watch provider credentials",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.watchLoginInput"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.watchLoginResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs": {
            "post": {
                "security": [
                    {
                        "InternalToken": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Creates a job and publishes it to the worker. Internal callers may target any partition and any cataloged job type; user callers may only create user-initiable types and the partition is derived from their token. Supply an Idempotency-Key header to make retries safe.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Enqueue an async job",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Deduplicates creation; a repeat key returns the existing job (200)",
                        "name": "Idempotency-Key",
                        "in": "header"
                    },
                    {
                        "description": "Job to enqueue",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.createJobRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Existing job returned for a repeated Idempotency-Key",
                        "schema": {
                            "$ref": "#/definitions/api.enqueueJobResponse"
                        }
                    },
                    "202": {
                        "description": "Enqueued",
                        "schema": {
                            "$ref": "#/definitions/api.enqueueJobResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/jobs/{partition_key}/{job_id}": {
            "get": {
                "security": [
                    {
                        "InternalToken": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "jobs"
                ],
                "summary": "Get a job's status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Partition key (user id, or Global)",
                        "name": "partition_key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Job id",
                        "name": "job_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.jobStateResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/pipelines/{name}": {
            "post": {
                "security": [
                    {
                        "InternalToken": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "description": "Starts a named pipeline (a linear sequence of jobs). Internal callers may start any cataloged pipeline in any partition; user callers may only start user-initiable pipelines in their own partition. Supply an Idempotency-Key header to make retries safe.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pipelines"
                ],
                "summary": "Start a pipeline run",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Pipeline name",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Deduplicates creation; a repeat key returns the existing run (200)",
                        "name": "Idempotency-Key",
                        "in": "header"
                    },
                    {
                        "description": "Optional partition/input",
                        "name": "body",
                        "in": "body",
                        "schema": {
                            "$ref": "#/definitions/api.startPipelineRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Existing run returned for a repeated Idempotency-Key",
                        "schema": {
                            "$ref": "#/definitions/api.startPipelineResponse"
                        }
                    },
                    "202": {
                        "description": "Started",
                        "schema": {
                            "$ref": "#/definitions/api.startPipelineResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        },
        "/pipelines/{partition_key}/{run_id}": {
            "get": {
                "security": [
                    {
                        "InternalToken": []
                    },
                    {
                        "BearerAuth": []
                    }
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "pipelines"
                ],
                "summary": "Get a pipeline run's status",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Partition key (user id, or Global)",
                        "name": "partition_key",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Run id",
                        "name": "run_id",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/api.runStateResponse"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.errorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.createJobRequest": {
            "type": "object",
            "required": [
                "type"
            ],
            "properties": {
                "input": {
                    "type": "object"
                },
                "partition_key": {
                    "type": "string",
                    "example": "Global"
                },
                "type": {
                    "type": "string",
                    "example": "watch_sync"
                }
            }
        },
        "api.enqueueJobResponse": {
            "type": "object",
            "properties": {
                "deduplicated": {
                    "type": "boolean"
                },
                "job_id": {
                    "type": "string"
                },
                "partition_key": {
                    "type": "string"
                }
            }
        },
        "api.errorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "api.featureFlags": {
            "type": "object",
            "properties": {
                "coach_agent_weekly_plan": {
                    "type": "boolean"
                },
                "coach_chat": {
                    "type": "boolean"
                },
                "coach_chat_debug": {
                    "type": "boolean"
                },
                "coach_chat_max_message_chars": {
                    "type": "integer"
                },
                "sync_data_at_onboarding": {
                    "type": "boolean"
                }
            }
        },
        "api.jobStateResponse": {
            "type": "object",
            "properties": {
                "attempts": {
                    "type": "integer"
                },
                "completed_at": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "error_code": {
                    "type": "string"
                },
                "error_message": {
                    "type": "string"
                },
                "job_id": {
                    "type": "string"
                },
                "job_type": {
                    "type": "string"
                },
                "partition_key": {
                    "type": "string"
                },
                "progress_pct": {
                    "type": "integer"
                },
                "result_json": {
                    "type": "string"
                },
                "stage": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "api.onboardingState": {
            "type": "object",
            "properties": {
                "completed_at": {
                    "type": "string"
                },
                "profile_ready": {
                    "type": "boolean"
                },
                "watch_ready": {
                    "type": "boolean"
                }
            }
        },
        "api.pipelineStepResponse": {
            "type": "object",
            "properties": {
                "job_id": {
                    "type": "string"
                },
                "job_type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                }
            }
        },
        "api.profileCore": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "dob": {
                    "type": "string"
                },
                "height_cm": {
                    "type": "number"
                },
                "sex": {
                    "type": "string"
                },
                "weight_kg": {
                    "type": "number"
                }
            }
        },
        "api.profileInput": {
            "type": "object",
            "required": [
                "display_name",
                "dob",
                "height_cm",
                "sex",
                "weight_kg"
            ],
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "dob": {
                    "type": "string"
                },
                "height_cm": {
                    "type": "number"
                },
                "sex": {
                    "type": "string",
                    "enum": [
                        "male",
                        "female",
                        "other"
                    ]
                },
                "weight_kg": {
                    "type": "number"
                }
            }
        },
        "api.profileResponse": {
            "type": "object",
            "properties": {
                "display_name": {
                    "type": "string"
                },
                "features": {
                    "$ref": "#/definitions/api.featureFlags"
                },
                "id": {
                    "type": "string"
                },
                "onboarding": {
                    "$ref": "#/definitions/api.onboardingState"
                },
                "profile": {
                    "$ref": "#/definitions/api.profileCore"
                },
                "provider": {
                    "type": "string"
                }
            }
        },
        "api.runStateResponse": {
            "type": "object",
            "properties": {
                "completed_at": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string"
                },
                "current_step": {
                    "type": "integer"
                },
                "error_message": {
                    "type": "string"
                },
                "partition_key": {
                    "type": "string"
                },
                "pipeline_name": {
                    "type": "string"
                },
                "run_id": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.pipelineStepResponse"
                    }
                },
                "updated_at": {
                    "type": "string"
                }
            }
        },
        "api.startPipelineRequest": {
            "type": "object",
            "properties": {
                "input": {
                    "type": "object"
                },
                "partition_key": {
                    "type": "string"
                }
            }
        },
        "api.startPipelineResponse": {
            "type": "object",
            "properties": {
                "deduplicated": {
                    "type": "boolean"
                },
                "partition_key": {
                    "type": "string"
                },
                "pipeline_name": {
                    "type": "string"
                },
                "run_id": {
                    "type": "string"
                }
            }
        },
        "api.validationDetailItem": {
            "type": "object",
            "properties": {
                "loc": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "msg": {
                    "type": "string"
                }
            }
        },
        "api.validationErrorResponse": {
            "type": "object",
            "properties": {
                "detail": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/api.validationDetailItem"
                    }
                }
            }
        },
        "api.watchLoginInput": {
            "type": "object",
            "required": [
                "email",
                "password",
                "provider"
            ],
            "properties": {
                "email": {
                    "type": "string"
                },
                "password": {
                    "type": "string"
                },
                "provider": {
                    "type": "string",
                    "enum": [
                        "coros",
                        "garmin"
                    ]
                },
                "region": {
                    "type": "string",
                    "enum": [
                        "cn",
                        "global"
                    ]
                }
            }
        },
        "api.watchLoginResponse": {
            "type": "object",
            "properties": {
                "ok": {
                    "type": "boolean"
                },
                "region": {
                    "type": "string"
                },
                "user_id": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "BearerAuth": {
            "description": "\"Bearer \u003cJWT\u003e\" for end-user callers (RS256).",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        },
        "InternalToken": {
            "description": "Shared secret for server-to-server callers.",
            "type": "apiKey",
            "name": "X-Internal-Token",
            "in": "header"
        }
    }
}