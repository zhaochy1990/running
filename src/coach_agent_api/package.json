{
  "name": "coach_agent_api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "pnpm --filter @stride/contract build && pnpm --filter coach_agent build",
    "build": "npm run clean && tsc",
    "build:all": "npm run build:core && npm run build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/server.js",
    "test": "npm run build:all && node --test dist/*.test.js dist/data/*.test.js dist/persistence/*.test.js",
    "test:deepagent": "npm run build:all && node dist/tests/test.js",
    "test:masterplan-graph": "npm run build:all && node dist/tests/test_master_plan.js",
    "test:race-analysis": "npm run build:all && node dist/tests/test_race_analysis.js",
    "test:weekly-plan": "npm run build:all && node dist/tests/test_weekly_plan.js",
    "test:weekly-plan-graph": "npm run build:all && node dist/tests/test_weekly_plan_graph.js",
    "format": "biome format --write src scripts",
    "check": "biome check src scripts",
    "check:fix": "biome check --write src scripts",
    "smoke": "npm run build:all && node dist/smoke.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.10",
    "@hono/swagger-ui": "^0.6.1",
    "coach_agent": "workspace:*",
    "convict": "^6.2.5",
    "hono": "^4.10.3",
    "jose": "^6.1.3",
    "mysql2": "^3.23.2",
    "pino": "^10.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/convict": "^6.1.6",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
