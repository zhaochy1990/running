{
  "name": "coach_agent_api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:core": "pnpm --filter @stride/common build && pnpm --filter @stride/contract build && pnpm --filter coach_agent build",
    "build": "npm run clean && tsc",
    "tsc": "pnpm clean && tsc",
    "build:all": "npm run build:core && npm run build",
    "clean": "node scripts/clean.mjs",
    "start": "node dist/src/server.js",
    "dev": "pnpm tsc && pnpm start",
    "test": "npm run build:all && node --test dist/tests/*.test.js dist/tests/data/*.test.js dist/tests/persistence/*.test.js",
    "test:deepagent": "pnpm -r tsc && node dist/scripts/test.js",
    "test:deepagent:qa": "pnpm -r tsc && node dist/scripts/deep_agent_qa.js",
    "test:masterplan-graph": "npm run build:all && node dist/scripts/test_master_plan.js",
    "test:race-analysis": "npm run build:all && node dist/scripts/test_race_analysis.js",
    "test:weekly-plan": "npm run build:all && node dist/scripts/test_weekly_plan.js",
    "test:weekly-plan-graph": "npm run build:all && node dist/scripts/test_weekly_plan_graph.js",
    "format": "biome format --write src scripts tests",
    "check": "biome check src scripts tests",
    "check:fix": "biome check --write src scripts tests",
    "smoke": "npm run build:all && node dist/scripts/smoke.js"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.10",
    "@hono/swagger-ui": "^0.6.1",
    "@stride/common": "workspace:*",
    "@stride/contract": "workspace:*",
    "coach_agent": "workspace:*",
    "convict": "^6.2.5",
    "deepagents": "^1.12.4",
    "hono": "^4.10.3",
    "mysql2": "^3.23.2",
    "pino": "^10.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/convict": "^6.1.6",
    "@types/node": "^26.2.0",
    "jose": "^6.1.3",
    "typescript": "^7.0.2"
  }
}