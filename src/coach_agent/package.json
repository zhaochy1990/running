{
  "name": "coach_agent",
  "version": "1.0.0",
  "description": "Database-agnostic STRIDE Coach Agent core",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "tsc": "node node_modules/typescript/lib/tsc.js",
    "clean": "node scripts/clean.mjs",
    "copy-assets": "node scripts/copy-assets.mjs",
    "build": "npm run clean && npm run tsc && npm run copy-assets",
    "generate:weekly-plan-schema": "node scripts/generate-weekly-plan-schema.mjs",
    "verify:weekly-plan-schema": "pnpm run generate:weekly-plan-schema && git diff --exit-code -- ../go/internal/api/weekly_plan_schema.json",
    "test": "npm run build && node --test dist/tools/*.test.js dist/agents/*.test.js dist/agents/master_plan/*.test.js dist/graph/master_plan/*.test.js dist/graph/weekly_plan/*.test.js dist/data/*.test.js dist/utils/*.test.js",
    "test:masterplan-kernel": "npm run build && node dist/tests/masterPlan.js",
    "format": "biome format --write src scripts",
    "lint": "biome lint src scripts",
    "check": "biome check src scripts",
    "check:fix": "biome check --write src scripts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@langchain/anthropic": "^1.5.4",
    "@langchain/core": "^1.2.5",
    "@langchain/langgraph": "^1.4.9",
    "@langchain/langgraph-checkpoint": "^1.1.3",
    "@langchain/openai": "^1.5.6",
    "@langfuse/langchain": "5.11.0",
    "@langfuse/otel": "5.11.0",
    "@langfuse/tracing": "5.11.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.221.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@stride/common": "workspace:*",
    "@stride/contract": "workspace:*",
    "deepagents": "^1.12.2",
    "langchain": "^1.5.5",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.8",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2"
  }
}
