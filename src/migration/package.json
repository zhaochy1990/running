{
  "name": "stride-watch-creds-migration",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "One-off Node.js migrations from legacy Azure/local stores into Tencent MySQL.",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "migrate-watch-creds": "src/index.js",
    "migrate-profiles": "src/migrate-profiles.js",
    "migrate-health": "src/migrate-health.js",
    "migrate-training-goals": "src/migrate-training-goals.js",
    "migrate-master-plans": "src/migrate-master-plans.js",
    "migrate-weekly-plans": "src/migrate-weekly-plans.js",
    "migrate-running-age": "src/migrate-running-age.js",
    "migrate-weekly-feedback": "src/migrate-weekly-feedback.js",
    "backfill-activity-start-gps": "src/activity-start-gps-backfill.js"
  },
  "scripts": {
    "migrate": "node src/index.js",
    "migrate:profiles": "node src/migrate-profiles.js",
    "migrate:health": "node src/migrate-health.js",
    "migrate:training-goals": "node src/migrate-training-goals.js",
    "migrate:master-plans": "node src/migrate-master-plans.js",
    "migrate:master-plans:schema": "node src/migrate-master-plans.js --commit --schema-upgrade",
    "migrate:weekly-plans": "node src/migrate-weekly-plans.js",
    "migrate:running-age": "node src/migrate-running-age.js",
    "migrate:weekly-feedback": "node src/migrate-weekly-feedback.js",
    "migrate:master-plan-phase-enum": "node src/migrate-master-plan-phase-enum.js",
    "migrate:activity-start-gps": "node src/activity-start-gps-backfill.js",
    "test": "node --test"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/identity": "^4.5.0",
    "@azure/keyvault-secrets": "^4.9.0",
    "@azure/storage-blob": "^12.33.0",
    "axios": "^1.19.0",
    "mysql2": "^3.11.4"
  }
}
