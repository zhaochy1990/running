# ─────────────────────────────────────────────────────────────────────────────
# Azure Key Vault (SOURCE)
# ─────────────────────────────────────────────────────────────────────────────
# The vault holding the per-user watch credential secrets. Prod uses the single
# shared vault below (see .github/workflows/deploy.yml). Auth is via
# DefaultAzureCredential — run `az login` first (or set AZURE_* SP env vars).
AKV_VAULT_URL=https://stride-kv-common.vault.azure.net/

# Secret name prefixes. Defaults match the Python backends
# (src/coros_sync/auth.py, src/garmin_sync/auth.py). Override only if you changed
# STRIDE_COROS_KEYVAULT_SECRET_PREFIX / STRIDE_GARMIN_KEYVAULT_SECRET_PREFIX.
COROS_SECRET_PREFIX=coros-config
GARMIN_SECRET_PREFIX=garmin-config

# ─────────────────────────────────────────────────────────────────────────────
# Tencent MySQL (TARGET)
# ─────────────────────────────────────────────────────────────────────────────
# Option A — reuse the Go worker's DSN verbatim (user:pass@tcp(host:port)/db?params):
#   STRIDE_WORKER_MYSQL_DSN=stride:CHANGEME@tcp(gz-cdb-xxxx.sql.tencentcdb.com:3306)/stride?tls=true
STRIDE_WORKER_MYSQL_DSN=

# Option B — discrete vars (used only when STRIDE_WORKER_MYSQL_DSN is empty):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stride

# TLS to the DB. Tencent public endpoints usually require it.
#   true         -> TLS, verify server cert against system CAs
#   skip-verify  -> TLS, do NOT verify (self-signed) — convenient but less secure
#   (empty)      -> no TLS
# A `tls=` param inside STRIDE_WORKER_MYSQL_DSN takes precedence over this.
MYSQL_SSL=

# ─────────────────────────────────────────────────────────────────────────────
# Profile + onboarding migration (src/migrate-profiles.js) — SOURCE
# ─────────────────────────────────────────────────────────────────────────────
# Root dir holding the on-disk <uuid>/profile.json + onboarding.json snapshot.
# Optional — defaults to the repo-root data/ dir (two levels up from this
# project). Override with --data-dir or here. This migration reads local files,
# not Azure; only the real users in src/users.js are migrated.
STRIDE_DATA_DIR=

# ─────────────────────────────────────────────────────────────────────────────
# Training-goal migration (src/migrate-training-goals.js) — master-plan rewrite
# ─────────────────────────────────────────────────────────────────────────────
# The goal itself is read from the local <uuid>/training_goal.json snapshot
# (STRIDE_DATA_DIR / --data-dir, same as above) and written to MySQL race_goal.
# When a legacy slug goal_id is re-minted to a uuid, the tool also rewrites the
# embedded .goal.goal_id inside the user's Azure master-plan snapshots. Point
# these at the SAME account the server uses (config/server.prod.toml
# [storage.master_plan]); auth is DefaultAzureCredential (run `az login`).
# Skip the rewrite entirely with --skip-master-plan.
STRIDE_MASTER_PLAN_TABLE_ACCOUNT_URL=https://authstorage2026.table.core.windows.net/
# Optional — plans table name (default stridemasterplan; versions = name+versions).
STRIDE_MASTER_PLAN_TABLE_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Master-plan migration (src/migrate-master-plans.js) — SOURCE
# ─────────────────────────────────────────────────────────────────────────────
# v2 structured plans are read from the Azure Table above
# (STRIDE_MASTER_PLAN_TABLE_ACCOUNT_URL). v1 markdown (TRAINING_PLAN.md) is read
# from the Azure Blob content-store; these default to config/server.prod.toml
# [storage.content]. Dry-run also reads MySQL and emits a redacted hash-bound
# manifest; commit requires that reviewed manifest and hash. Auth via
# DefaultAzureCredential (run `az login`).
STRIDE_CONTENT_BLOB_ACCOUNT_URL=https://authstorage2026.blob.core.windows.net/
STRIDE_CONTENT_BLOB_CONTAINER=stride-data
STRIDE_CONTENT_BLOB_PREFIX=users

# ─────────────────────────────────────────────────────────────────────────────
# Weekly-plan migration (src/migrate-weekly-plans.js) — SOURCE
# ─────────────────────────────────────────────────────────────────────────────
# Canonical structured WeeklyPlan entities. The same DefaultAzureCredential is
# used for this Table and the Blob content store above.
STRIDE_WEEKLY_PLAN_TABLE_ACCOUNT_URL=https://authstorage2026.table.core.windows.net/
# Optional; default strideweeklyplan.
STRIDE_WEEKLY_PLAN_TABLE_NAME=
