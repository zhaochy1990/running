# ─────────────────────────────────────────────────────────────────────────────
# Azure Key Vault (SOURCE)
# ─────────────────────────────────────────────────────────────────────────────
# The vault holding the per-user watch credential secrets. Prod uses the single
# shared vault below (see .github/workflows/deploy.yml). Auth is via
# DefaultAzureCredential — run `az login` first (or set AZURE_* SP env vars).
AKV_VAULT_URL=https://stride-kv-common.vault.azure.net/

# Secret name prefixes. Defaults match the Python backends
# (src/coros_sync/auth.py, src/garmin_sync/auth.py). Override only if you changed
# STRIDE_COROS_KEYVAULT_SECRET_PREFIX / STRIDE_GARMIN_KEYVAULT_SECRET_PREFIX.
COROS_SECRET_PREFIX=coros-config
GARMIN_SECRET_PREFIX=garmin-config

# ─────────────────────────────────────────────────────────────────────────────
# Tencent MySQL (TARGET)
# ─────────────────────────────────────────────────────────────────────────────
# Option A — reuse the Go worker's DSN verbatim (user:pass@tcp(host:port)/db?params):
#   STRIDE_WORKER_MYSQL_DSN=stride:CHANGEME@tcp(gz-cdb-xxxx.sql.tencentcdb.com:3306)/stride?tls=true
STRIDE_WORKER_MYSQL_DSN=

# Option B — discrete vars (used only when STRIDE_WORKER_MYSQL_DSN is empty):
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=stride

# TLS to the DB. Tencent public endpoints usually require it.
#   true         -> TLS, verify server cert against system CAs
#   skip-verify  -> TLS, do NOT verify (self-signed) — convenient but less secure
#   (empty)      -> no TLS
# A `tls=` param inside STRIDE_WORKER_MYSQL_DSN takes precedence over this.
MYSQL_SSL=
