/* ============================================================
   自定义底部导航栏 —— 对应 design/today.html 的 4 tab 设计
   （P2 浅色：白底 + 顶部弱分隔线 + 灰字 / 藕粉激活色）
   ============================================================ */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: stretch;
  height: 120rpx;
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-soft);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: opacity 0.15s ease;
}

.tab-item:active {
  opacity: 0.7;
}

.tab-item__icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-item__text {
  font-size: 19rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: var(--color-text-secondary);
}

.tab-item--active .tab-item__text {
  color: var(--color-accent);
  font-weight: 700;
}
