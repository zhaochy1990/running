/* ============================================================
   自定义底部导航栏 —— 对应 design/today.html 的 4 tab 设计
   ============================================================ */

.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: stretch;
  height: 120rpx;
  box-sizing: content-box;
  padding-bottom: env(safe-area-inset-bottom);
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  transition: opacity 0.15s ease;
}

.tab-item:active {
  opacity: 0.7;
}

.tab-item__icon {
  width: 52rpx;
  height: 52rpx;
}

.tab-item__text {
  font-size: 22rpx;
  line-height: 30rpx;
  font-weight: 500;
  color: #9a8f90;
}

.tab-item--active .tab-item__text {
  color: #ff6363;
  font-weight: 700;
}
