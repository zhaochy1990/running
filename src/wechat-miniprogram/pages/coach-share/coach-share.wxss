/* 教练聊天分享免登录只读阅读端 —— devops#718，#624 原型 D 变体（气泡对话流·浅色）
   像素级参照： prototypes/624-reader-spike.html .vd_*（px×2=rpx）。
   #816：本页是刻意浅色的分享落地页，accent 族已引全局令牌；
   devops#818 P3：页面自有浅色值已统一收敛到全局令牌（底/卡/文字/气泡/
   品牌条），实底 accent 上的白字一律 --color-on-accent；顶栏毛玻璃白
   rgba(255,255,255,0.97) 无对应令牌、保持写死；mp-html 的 tagStyle 在
   coach-share.ts（归 TS 侧票处理）。 */

page {
  background: var(--color-bg);
}

.page {
  min-height: 100vh;
  /* 给固定品牌条留出高度 */
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶栏（fixed） ---------- */

.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.97);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top__home {
  width: 44rpx;
  height: 44rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.top__titles {
  flex: 1;
  min-width: 0;
}

.top__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top__meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.top__badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: var(--color-text-secondary);
  background: var(--color-chip);
}

/* ---------- 主体 ---------- */

.body {
  padding: 28rpx 24rpx 8rpx;
}

.msg {
  display: flex;
  margin-bottom: 28rpx;
}

.msg--user {
  justify-content: flex-end;
}

/* 用户浅粉右气泡（accent-tint，右上角收角） */
.bubble-u {
  max-width: 80%;
  background: var(--color-accent-tint);
  color: var(--color-text-primary);
  border-radius: 32rpx;
  border-top-right-radius: 10rpx;
  padding: 22rpx 28rpx;
  font-size: 28rpx;
  line-height: 42rpx;
  white-space: pre-wrap;
  word-break: break-all;
}

/* 教练白底左气泡（左上角收角，轻阴影） */
.bubble-md {
  max-width: 92%;
  background: var(--color-card);
  border-radius: 32rpx;
  border-top-left-radius: 10rpx;
  padding: 24rpx 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(var(--color-overlay-rgb), 0.05);
}

/* ---------- 静态摘要卡（策略卡降级） ---------- */

.scard {
  max-width: 92%;
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.2);
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 6rpx rgba(var(--color-overlay-rgb), 0.05);
}

.scard__head {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.scard__head--inline {
  margin-bottom: 8rpx;
}

.scard__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: rgba(var(--color-accent-rgb), 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.scard__icon-img {
  width: 40rpx;
  height: 40rpx;
}

.scard__titles {
  flex: 1;
  min-width: 0;
}

.scard__title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.scard__subtitle {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.scard__note {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: var(--color-text-muted);
}

/* ---------- 状态空态（加载 / 过期 / 不存在 / 失败） ---------- */

.state {
  padding: 220rpx 60rpx 0;
  text-align: center;
}

.state__spinner {
  width: 64rpx;
  height: 64rpx;
  margin: 0 auto 24rpx;
  border: 6rpx solid rgba(var(--color-accent-rgb), 0.2);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: coach-share-spin 0.8s linear infinite;
}

@keyframes coach-share-spin {
  to {
    transform: rotate(360deg);
  }
}

.state__logo {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 28rpx;
  border-radius: 28rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 44rpx;
  font-weight: 700;
  text-align: center;
  line-height: 96rpx;
  opacity: 0.9;
}

.state__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.state__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 14rpx;
  line-height: 36rpx;
}

.state__cta {
  display: inline-block;
  margin-top: 36rpx;
  padding: 0 64rpx;
  line-height: 76rpx;
  border-radius: 38rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
}

/* ---------- 底部品牌条（fixed） ---------- */

.foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-soft);
}

.foot__qr {
  width: 128rpx;
  height: 128rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

/* wxacode 生成失败（fail-soft 为 null）回退品牌占位块 */
.foot__qr--fallback {
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  line-height: 128rpx;
}

.foot__titles {
  flex: 1;
  min-width: 0;
}

.foot__title {
  font-size: 25rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.foot__subtitle {
  font-size: 21rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.foot__share {
  margin: 0;
  padding: 0 40rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.foot__share::after {
  border: none;
}
