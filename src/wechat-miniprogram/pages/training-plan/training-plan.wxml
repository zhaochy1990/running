<view class="page">
  <!-- 自定义顶部栏（顶栏字号 34/20 全 app 统一；标题按 #1024 详情页设计稿） -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBackTap">
        <image wx:if="{{canBack}}" class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
        <image wx:else class="top-bar__icon" src="/assets/icons/home.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">{{loadState === 'ready' ? '赛季训练计划' : '我的训练计划'}}</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;">
    <!-- ============ 加载中 ============ -->
    <view wx:if="{{loadState === 'loading'}}" class="state-card">
      <view class="state-card__spinner"></view>
      <view class="state-card__text">正在加载训练计划…</view>
    </view>

    <!-- ============ 加载失败 ============ -->
    <view wx:elif="{{loadState === 'error'}}" class="state-card">
      <image class="state-card__icon" src="/assets/icons/calendar_month.svg" mode="aspectFit" />
      <view class="state-card__title">加载失败</view>
      <view class="state-card__text">{{errorText}}</view>
      <view class="state-card__cta" bindtap="onRetryTap">重试</view>
    </view>

    <!-- ============ 空态：没有启用中的计划 ============ -->
    <view wx:elif="{{loadState === 'empty'}}" class="state-card">
      <image class="state-card__icon" src="/assets/icons/calendar_month.svg" mode="aspectFit" />
      <view class="state-card__title">还没有启用中的训练计划</view>
      <view class="state-card__text">把目标比赛告诉教练，为你生成一份完整的赛季备赛计划</view>
      <view class="state-card__cta" bindtap="onCoachTap">去找教练生成</view>
    </view>

    <!-- ============ v1 旧版计划：不渲染 markdown ============ -->
    <view wx:elif="{{loadState === 'v1'}}" class="state-card">
      <image class="state-card__icon" src="/assets/icons/calendar_month.svg" mode="aspectFit" />
      <view class="state-card__title">这是旧版训练计划</view>
      <view class="state-card__text">旧版计划请前往网页查看</view>
    </view>

    <!-- ============ #1024 详情页：双视图（计划概览 / 每周安排） ============ -->
    <block wx:elif="{{loadState === 'ready'}}">
      <!-- #858 PR-E 顶部提示条：pending 调整 / 伤病激活 -->
      <view
        wx:if="{{bannerKind !== 'none'}}"
        class="status-banner status-banner--{{bannerKind}}"
        bindtap="onBannerTap"
      >
        <view class="status-banner__dot"></view>
        <view class="status-banner__text">{{bannerText}}</view>
        <view class="status-banner__arrow">›</view>
      </view>

      <!-- 视图切换（设计稿 plan-view-nav） -->
      <view class="view-nav">
        <view
          class="view-nav__item {{planView === 'overview' ? 'view-nav__item--on' : ''}}"
          data-view="overview"
          bindtap="onSwitchView"
        >计划概览</view>
        <view
          class="view-nav__item {{planView === 'calendar' ? 'view-nav__item--on' : ''}}"
          data-view="calendar"
          bindtap="onSwitchView"
        >每周安排</view>
      </view>

      <!-- ======== 视图一：计划概览 ======== -->
      <block wx:if="{{planView === 'overview'}}">
        <!-- 概览头 -->
        <view class="plan-heading">
          <view class="plan-heading__title">{{planTitle}}</view>
          <view class="plan-heading__sub">{{planSubtitle}}</view>
        </view>

        <!-- 目标评估（kernel 产物 goal_assessment；旧计划缺字段则整卡隐藏） -->
        <view wx:if="{{assessment}}" class="card assess">
          <view class="assess__title">目标评估 · {{assessment.levelLabel}}</view>
          <view class="assess__abc">
            <view wx:for="{{assessment.abcTargets}}" wx:key="key" class="assess__abc-item">
              <view class="assess__abc-label">{{item.label}}</view>
              <view class="assess__abc-time">{{item.time}}</view>
            </view>
          </view>
          <view class="assess__fold" bindtap="onToggleAssess">{{assessExpanded ? '收起评估依据 ▴' : '查看评估依据与备选目标 ▾'}}</view>
          <view wx:if="{{assessExpanded}}">
            <view wx:if="{{assessment.summary}}" class="assess__summary">{{assessment.summary}}</view>
            <view wx:for="{{assessment.abcTargets}}" wx:key="key" class="assess__gate">
              <view class="assess__gate-label">{{item.label}} · {{item.time}}</view>
              <view wx:if="{{item.conditionsText}}" class="assess__gate-text">{{item.conditionsText}}</view>
            </view>
          </view>
        </view>

        <!-- 15周训练节奏（周跑量/长距离切换；柱色=阶段色） -->
        <view class="card rhythm">
          <view class="rhythm__head">
            <view class="rhythm__title">15周训练节奏</view>
            <view class="metric-switch">
              <view
                class="metric-switch__item {{chartMetric === 'km' ? 'metric-switch__item--on' : ''}}"
                data-metric="km"
                bindtap="onMetricToggle"
              >周跑量</view>
              <view
                wx:if="{{chartHasLr}}"
                class="metric-switch__item {{chartMetric === 'lr' ? 'metric-switch__item--on' : ''}}"
                data-metric="lr"
                bindtap="onMetricToggle"
              >长距离</view>
            </view>
          </view>
          <view class="rhythm__meta">
            <view class="rhythm__unit">计划目标 · km</view>
            <view class="rhythm__peak">{{chartMetric === 'km' ? '峰值周量' : '最长距离'}} <text class="rhythm__peak-num">{{chartPeakLabel}}</text></view>
          </view>
          <view class="rhythm-plot">
            <view class="rhythm-yaxis">
              <text>{{chartAxis}}</text>
              <text>{{chartAxis / 2}}</text>
              <text>0</text>
            </view>
            <view class="rhythm-bars">
              <view
                wx:for="{{rhythmBars}}"
                wx:key="key"
                class="rhythm-bar {{item.selected ? 'rhythm-bar--sel' : ''}}"
                data-week="{{item.week}}"
                bindtap="onBarTap"
              >
                <view wx:if="{{item.selected}}" class="rhythm-bar__value">{{item.value}}</view>
                <view class="rhythm-bar__track">
                  <view class="rhythm-bar__fill" style="height: {{item.heightPct}}%; background: {{item.color}};"></view>
                </view>
                <view class="rhythm-bar__label">{{item.label}}</view>
              </view>
            </view>
          </view>
          <view class="rhythm__x-label">训练周</view>
        </view>

        <!-- 查看每周训练安排入口 -->
        <view class="weekly-discovery" data-view="calendar" bindtap="onSwitchView">
          <view class="weekly-discovery__body">
            <view class="weekly-discovery__title">查看每周训练安排</view>
            <view class="weekly-discovery__sub">逐周查看训练内容与休息安排</view>
          </view>
          <view class="weekly-discovery__arrow">→</view>
        </view>

        <!-- 阶段 tabs -->
        <view class="phase-tabs">
          <view
            wx:for="{{phaseTabs}}"
            wx:key="key"
            class="phase-tab {{chosenPhase === item.index ? 'phase-tab--on' : ''}}"
            data-index="{{item.index}}"
            bindtap="onPhaseTap"
          >
            <view class="phase-tab__dot" style="background: {{item.color}};"></view>
            <view class="phase-tab__name">{{item.label}}</view>
            <view class="phase-tab__count">{{item.weekCount}}周</view>
          </view>
        </view>

        <!-- 阶段面板 -->
        <view wx:if="{{stage}}" class="card stage">
          <view class="stage__head">
            <view class="stage__name" style="color: {{stage.color}};">{{stage.label}}</view>
            <view class="stage__range">{{stage.weekRangeLabel}} · {{stage.dateRangeLabel}}</view>
          </view>
          <view class="stage__section-title">阶段训练目标</view>
          <view class="stage__focus">{{stage.focusExpanded || !stage.hasFull ? stage.focusFull : stage.focusBrief}}</view>
          <view wx:if="{{stage.hasFull}}" class="stage__fold" bindtap="onToggleFullFocus">
            {{stage.focusExpanded ? '收起完整说明 ▴' : '查看完整阶段说明 ▾'}}
          </view>

          <view wx:if="{{stage.milestones.length}}" class="stage-ms">
            <view class="stage-ms__head">
              <view class="stage-ms__title">阶段里程碑</view>
              <view wx:if="{{stage.milestoneScope}}" class="stage-ms__scope">{{stage.milestoneScope}}</view>
            </view>
            <view wx:for="{{stage.milestones}}" wx:key="key" class="stage-ms__row">
              <view class="stage-ms__diamond" style="border-color: {{stage.color}};"></view>
              <view class="stage-ms__body">
                <view class="stage-ms__label">{{item.label}}</view>
                <view class="stage-ms__criterion">{{item.criterion}}</view>
              </view>
            </view>
          </view>

          <view wx:if="{{stage.strengthPerWeek}}" class="stage-kv">
            <view class="stage-kv__label">力量训练</view>
            <view class="stage-kv__value">{{stage.strengthPerWeek}}</view>
          </view>
          <view wx:if="{{stage.recoveryText}}" class="stage-kv">
            <view class="stage-kv__label">恢复与睡眠</view>
            <view class="stage-kv__value">{{stage.recoveryText}}</view>
          </view>
        </view>

        <!-- 总体训练原则 -->
        <view wx:if="{{principles.length}}" class="card principles">
          <view class="principles__title">总体训练原则</view>
          <view wx:for="{{principles}}" wx:key="key" class="principles__item">{{item.text}}</view>
        </view>
      </block>

      <!-- ======== 视图二：每周安排 ======== -->
      <block wx:if="{{planView === 'calendar'}}">
        <view class="review-heading">
          <view class="review-heading__title">每周训练安排</view>
          <view class="review-heading__sub">{{planSubtitle}}</view>
        </view>
        <view wx:for="{{calendarGroups}}" wx:key="key" class="review-group">
          <view class="review-group__head">
            <view class="review-group__dot" style="background: {{item.color}};"></view>
            <view class="review-group__name">{{item.label}}</view>
            <view class="review-group__count">{{item.weekCount}}周</view>
          </view>
          <view wx:for="{{item.weeks}}" wx:for-item="week" wx:key="key" class="card review-week {{week.expanded ? 'review-week--open' : ''}}">
            <view class="review-week__head" data-key="{{week.key}}" data-week="{{week.weekIndex}}" bindtap="onWeekExpand">
              <view class="review-week__title">
                <text class="review-week__no">第{{week.weekIndex}}周</text>
                <text wx:if="{{week.roleLabel}}" class="review-week__role">{{week.roleLabel}}</text>
                <text wx:if="{{week.strengthLabel}}" class="review-week__role review-week__role--strength">{{week.strengthLabel}}</text>
              </view>
              <view class="review-week__km">{{week.kmLabel}}<text class="review-week__km-sub">周目标</text></view>
              <view class="review-week__date">{{week.dateRange}}</view>
              <view class="review-week__chev">{{week.expanded ? '▴' : '▾'}}</view>
            </view>
            <view wx:if="{{week.expanded}}" class="review-week__body">
              <view wx:if="{{week.loadingDoc}}" class="review-week__hint">加载中…</view>
              <block wx:elif="{{week.hasDoc}}">
                <view
                  wx:for="{{week.days}}"
                  wx:for-item="day"
                  wx:key="key"
                  class="review-day {{day.isRest ? 'review-day--rest' : ''}}"
                  data-week-key="{{week.key}}"
                  data-key="{{day.key}}"
                  bindtap="onDayExpand"
                >
                  <view class="review-day__main">
                    <view class="review-day__date">
                      <text class="review-day__weekday">{{day.weekday}}</text>
                      <text class="review-day__num">{{day.dateNum}}</text>
                    </view>
                    <view class="review-day__dot {{day.isQuality ? 'review-day__dot--t' : (day.isRest ? 'review-day__dot--rest' : '')}}"></view>
                    <view class="review-day__summary">{{day.summary}}</view>
                    <view class="review-day__dist">{{day.distLabel}}</view>
                    <view wx:if="{{!day.isRest}}" class="review-day__chev">{{day.expanded ? '▴' : '›'}}</view>
                  </view>
                  <view wx:if="{{!day.isRest && day.expanded}}" class="review-day__body">
                    <view wx:if="{{day.purpose}}" class="review-day__sec">
                      <view class="review-day__sec-title">这节课练什么</view>
                      <view class="review-day__sec-text">{{day.purpose}}</view>
                    </view>
                    <view wx:if="{{day.structureLines.length}}" class="review-day__sec">
                      <view class="review-day__sec-title">训练结构</view>
                      <view wx:for="{{day.structureLines}}" wx:for-item="line" wx:key="*this" class="review-day__line">{{line}}</view>
                    </view>
                    <view wx:if="{{day.note}}" class="review-day__sec">
                      <view class="review-day__sec-title">Coach 提醒</view>
                      <view class="review-day__sec-text">{{day.note}}</view>
                    </view>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="review-future">
                  <view class="review-future__row">
                    <text class="review-future__label">长距离</text>
                    <text class="review-future__value">{{week.futureLr}}</text>
                  </view>
                  <view class="review-future__row">
                    <text class="review-future__label">质量课配额</text>
                    <text class="review-future__value">{{week.futureQ}}</text>
                  </view>
                  <view class="review-future__note">每日课表尚未生成 · 随训练推进自动生成下一块</view>
                </view>
              </block>
            </view>
          </view>
        </view>
      </block>

      <!-- 预览 footer（聊天结果卡带入；正式视图不渲染，启用语义见 #585/#1024 R4） -->
      <view wx:if="{{isPreview && loadState === 'ready'}}" class="footer">
        <view class="footer__btn footer__btn--secondary" bindtap="onAdjustTap">调整计划</view>
        <view class="footer__btn footer__btn--primary {{previewApplied ? 'footer__btn--disabled' : ''}}" bindtap="onApplyTap">
          {{previewApplied ? '已启用' : '启用计划'}}
        </view>
      </view>
    </block>
  </view>

  <!-- #858 PR-E：调整追问弹窗（提示条入口，同组件复用，不受每天一次限制） -->
  <adjust-dialog
    wx:if="{{adjustDialogVisible}}"
    show="{{adjustDialogVisible}}"
    userId="{{uid}}"
    adjustment="{{pendingAdjustment}}"
    bindaccepted="onAdjustAccepted"
    binddismissed="onAdjustDismissed"
    bindclosed="onAdjustClosed"
    bindinjury="onAdjustInjury"
  />

  <!-- #858 PR-E：伤病弹层（提示条入口的当日轻问 / 受伤路径登记） -->
  <injury-dialog
    wx:if="{{injuryDialogVisible}}"
    show="{{injuryDialogVisible}}"
    mode="{{injuryDialogMode}}"
    injury="{{injuryState}}"
    race-closing-soon="{{raceClosingSoon}}"
    result-text="{{injuryResultText}}"
    bindentered="onInjuryEntered"
    bindchecked="onInjuryChecked"
    binddoctored="onInjuryDoctored"
    bindcoach="onInjuryCoach"
    bindclosed="onInjuryClosed"
  />
</view>
