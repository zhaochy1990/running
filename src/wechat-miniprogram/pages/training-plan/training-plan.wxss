/* 「赛季训练计划」页 —— #1024 详情页设计稿（training-plan-prototype）。
 * 硬口径（用户拍板，沿用本页 #436 规则）：
 *   1. 卡片一律无边框——层次只靠白卡 vs 页底色差（#539 全页规则）；
 *   2. 吃满屏宽：页面左右 padding 24rpx；
 *   3. BEM、rpx。
 * 设计 token（training-plan-prototype）：bg #f5f6f4 / ink #202b29 /
 * muted #65716c / line #dfe5df(仅分隔线) / green #215d46 / soft #eaf2eb；
 * 阶段五色见 ts PHASE_COLORS。 */

page {
  background: #f5f6f4;
}

.page {
  min-height: 100vh;
  background: #f5f6f4;
  color: #202b29;
}

/* ---------- 顶栏（全 app 统一口径：34/20、返回/小房子） ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: #f5f6f4;
}

.top-bar__inner {
  position: relative;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__btn {
  position: absolute;
  left: 24rpx;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__btn--spacer {
  left: auto;
  right: 24rpx;
}

.top-bar__icon {
  width: 40rpx;
  height: 40rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 650;
}

.content {
  padding-left: 24rpx;
  padding-right: 24rpx;
  padding-bottom: 60rpx;
}

/* ---------- 视图切换（设计稿 plan-view-nav：胶囊双 tab） ---------- */

.view-nav {
  display: flex;
  background: #e9eee8;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.view-nav__item {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  color: #65716c;
  padding: 14rpx 0;
  border-radius: 9rpx;
}

.view-nav__item--on {
  background: #ffffff;
  color: #215d46;
  font-weight: 650;
  box-shadow: 0 2rpx 6rpx rgba(38, 58, 41, 0.08);
}

/* ---------- 通用卡片（无边框：层次=白卡 vs 页底色差） ---------- */

.card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

/* ---------- 概览头 ---------- */

.plan-heading {
  padding: 8rpx 4rpx 28rpx;
}

.plan-heading__title {
  font-size: 50rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
  line-height: 1.35;
}

.plan-heading__sub {
  margin-top: 12rpx;
  font-size: 25rpx;
  color: #65716c;
}

/* ---------- 目标评估 ---------- */

.assess {
  background: #eaf2eb;
}

.assess__title {
  font-size: 31rpx;
  font-weight: 650;
  color: #215d46;
}

.assess__abc {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.assess__abc-item {
  flex: 1;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 12rpx;
  padding: 18rpx 0;
  text-align: center;
}

.assess__abc-label {
  font-size: 21rpx;
  color: #65716c;
}

.assess__abc-time {
  margin-top: 6rpx;
  font-size: 31rpx;
  font-weight: 650;
  color: #215d46;
  font-variant-numeric: tabular-nums;
}

.assess__fold {
  margin-top: 20rpx;
  font-size: 23rpx;
  color: #215d46;
}

.assess__summary {
  margin-top: 22rpx;
  font-size: 25rpx;
  line-height: 1.7;
  color: #42514a;
}

.assess__gate {
  margin-top: 20rpx;
}

.assess__gate-label {
  font-size: 25rpx;
  font-weight: 650;
  color: #215d46;
}

.assess__gate-text {
  margin-top: 6rpx;
  font-size: 23rpx;
  line-height: 1.7;
  color: #42514a;
}

/* ---------- 15周训练节奏 ---------- */

.rhythm__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rhythm__title {
  font-size: 33rpx;
  font-weight: 650;
}

.metric-switch {
  display: flex;
  background: #e9eee8;
  border-radius: 12rpx;
  padding: 5rpx;
}

.metric-switch__item {
  font-size: 23rpx;
  color: #65716c;
  padding: 10rpx 22rpx;
  border-radius: 9rpx;
}

.metric-switch__item--on {
  background: #ffffff;
  color: #215d46;
  font-weight: 650;
  box-shadow: 0 2rpx 6rpx rgba(38, 58, 41, 0.08);
}

.rhythm__meta {
  display: flex;
  justify-content: space-between;
  margin-top: 26rpx;
  font-size: 21rpx;
  color: #65716c;
}

.rhythm__peak-num {
  color: #202b29;
  font-weight: 650;
  margin-left: 6rpx;
  font-variant-numeric: tabular-nums;
}

.rhythm-plot {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

.rhythm-yaxis {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 300rpx;
  font-size: 19rpx;
  color: #65716c;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

.rhythm-bars {
  flex: 1;
  display: flex;
  align-items: flex-end;
  gap: 6rpx;
  height: 300rpx;
}

.rhythm-bar {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  align-items: center;
}

.rhythm-bar__value {
  height: 34rpx;
  font-size: 19rpx;
  color: #202b29;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.rhythm-bar__track {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: flex-end;
  border-radius: 8rpx;
}

.rhythm-bar__fill {
  width: 100%;
  border-radius: 8rpx 8rpx 3rpx 3rpx;
}

.rhythm-bar--sel .rhythm-bar__track {
  background: rgba(33, 93, 70, 0.08);
}

.rhythm-bar__label {
  height: 30rpx;
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #65716c;
  font-variant-numeric: tabular-nums;
}

.rhythm__x-label {
  margin-top: 6rpx;
  text-align: right;
  font-size: 19rpx;
  color: #65716c;
}

/* ---------- 查看每周训练安排入口 ---------- */

.weekly-discovery {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #edf4ed;
  border-radius: 20rpx;
  padding: 26rpx 30rpx;
  margin-bottom: 28rpx;
}

.weekly-discovery__title {
  font-size: 29rpx;
  font-weight: 650;
  color: #215d46;
}

.weekly-discovery__sub {
  margin-top: 6rpx;
  font-size: 23rpx;
  color: #65716c;
}

.weekly-discovery__arrow {
  font-size: 34rpx;
  color: #215d46;
}

/* ---------- 阶段 tabs ---------- */

.phase-tabs {
  display: flex;
  gap: 10rpx;
  margin-bottom: 24rpx;
}

.phase-tab {
  flex: 1;
  background: #ffffff;
  border-radius: 14rpx;
  padding: 18rpx 0 16rpx;
  text-align: center;
}

.phase-tab--on {
  background: #eaf2eb;
}

.phase-tab__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin: 0 auto 8rpx;
}

.phase-tab__name {
  font-size: 23rpx;
  font-weight: 600;
  color: #202b29;
}

.phase-tab--on .phase-tab__name {
  color: #215d46;
}

.phase-tab__count {
  margin-top: 4rpx;
  font-size: 19rpx;
  color: #65716c;
}

/* ---------- 阶段面板 ---------- */

.stage__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.stage__name {
  font-size: 38rpx;
  font-weight: 700;
}

.stage__range {
  font-size: 23rpx;
  color: #65716c;
}

.stage__section-title {
  margin-top: 30rpx;
  font-size: 27rpx;
  font-weight: 650;
}

.stage__focus {
  margin-top: 14rpx;
  font-size: 26rpx;
  line-height: 1.75;
  color: #42514a;
}

.stage__fold {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #215d46;
}

.stage-ms {
  margin-top: 28rpx;
  background: #eaf2eb;
  border-radius: 14rpx;
  padding: 24rpx;
}

.stage-ms__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.stage-ms__title {
  font-size: 27rpx;
  font-weight: 650;
  color: #215d46;
}

.stage-ms__scope {
  font-size: 21rpx;
  color: #65716c;
}

.stage-ms__row {
  display: flex;
  gap: 14rpx;
  margin-top: 20rpx;
}

.stage-ms__diamond {
  width: 16rpx;
  height: 16rpx;
  margin-top: 8rpx;
  transform: rotate(45deg);
  border: 2rpx solid #62876a;
  flex-shrink: 0;
}

.stage-ms__label {
  font-size: 26rpx;
  font-weight: 650;
}

.stage-ms__criterion {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #42514a;
}

.stage-kv {
  display: flex;
  justify-content: space-between;
  padding: 22rpx 4rpx 0;
  margin-top: 22rpx;
  border-top: 1rpx solid #edf0eb;
  font-size: 26rpx;
}

.stage-kv__label {
  color: #65716c;
}

.stage-kv__value {
  font-weight: 600;
}

/* ---------- 总体训练原则 ---------- */

.principles__title {
  font-size: 29rpx;
  font-weight: 650;
  margin-bottom: 18rpx;
}

.principles__item {
  padding: 14rpx 0;
  font-size: 25rpx;
  line-height: 1.75;
  color: #42514a;
  border-bottom: 1rpx solid #edf0eb;
}

.principles__item:last-child {
  border-bottom: none;
}

/* ---------- 每周安排 ---------- */

.review-heading {
  padding: 8rpx 4rpx 24rpx;
}

.review-heading__title {
  font-size: 42rpx;
  font-weight: 700;
}

.review-heading__sub {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #65716c;
}

.review-group {
  margin-bottom: 30rpx;
}

.review-group__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 4rpx 16rpx;
}

.review-group__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
}

.review-group__name {
  font-size: 29rpx;
  font-weight: 650;
}

.review-group__count {
  font-size: 23rpx;
  color: #65716c;
}

.review-week {
  padding: 0;
  overflow: hidden;
}

.review-week__head {
  position: relative;
  padding: 26rpx 28rpx 22rpx;
}

.review-week__title {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.review-week__no {
  font-size: 31rpx;
  font-weight: 700;
}

.review-week__role {
  font-size: 21rpx;
  color: #65716c;
  background: #f2f4f6;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}

.review-week__km {
  margin-top: 10rpx;
  font-size: 42rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.review-week__km-sub {
  margin-left: 8rpx;
  font-size: 21rpx;
  font-weight: 400;
  color: #65716c;
}

.review-week__date {
  margin-top: 8rpx;
  font-size: 23rpx;
  color: #65716c;
}

.review-week__chev {
  position: absolute;
  right: 28rpx;
  top: 30rpx;
  font-size: 24rpx;
  color: #65716c;
}

.review-week__body {
  border-top: 1rpx solid #edf0eb;
  padding: 8rpx 28rpx 16rpx;
}

.review-week__hint {
  padding: 20rpx 0;
  font-size: 25rpx;
  color: #65716c;
  text-align: center;
}

.review-day__main {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #edf0eb;
}

.review-day:last-child .review-day__main {
  border-bottom: none;
}

.review-day__date {
  width: 84rpx;
  flex-shrink: 0;
}

.review-day__weekday {
  display: block;
  font-size: 23rpx;
  color: #65716c;
}

.review-day__num {
  display: block;
  font-size: 27rpx;
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.review-day__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #62876a;
  flex-shrink: 0;
}

.review-day__dot--t {
  background: #c16b3c;
}

.review-day__dot--rest {
  background: #dfe5df;
}

.review-day__summary {
  flex: 1;
  font-size: 26rpx;
  font-weight: 600;
}

.review-day--rest .review-day__summary {
  font-weight: 400;
  color: #65716c;
}

.review-day__dist {
  font-size: 23rpx;
  color: #65716c;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

.review-day__chev {
  font-size: 23rpx;
  color: #65716c;
  flex-shrink: 0;
}

.review-day__body {
  padding: 4rpx 0 24rpx 100rpx;
}

.review-day__sec {
  margin-top: 18rpx;
}

.review-day__sec-title {
  font-size: 23rpx;
  font-weight: 650;
  color: #215d46;
  margin-bottom: 8rpx;
}

.review-day__sec-text {
  font-size: 24rpx;
  line-height: 1.7;
  color: #42514a;
}

.review-day__line {
  font-size: 24rpx;
  line-height: 1.8;
  color: #42514a;
  font-variant-numeric: tabular-nums;
}

.review-future {
  padding: 20rpx 0 12rpx;
}

.review-future__row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  font-size: 26rpx;
}

.review-future__label {
  color: #65716c;
}

.review-future__value {
  font-weight: 650;
  font-variant-numeric: tabular-nums;
}

.review-future__note {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: #65716c;
}

/* ---------- 预览 footer（设计稿 footer 双按钮） ---------- */

.footer {
  position: sticky;
  bottom: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 0 calc(30rpx + env(safe-area-inset-bottom));
  background: #f5f6f4;
}

.footer__btn {
  text-align: center;
  padding: 24rpx 0;
  border-radius: 14rpx;
  font-size: 29rpx;
  font-weight: 650;
}

.footer__btn--secondary {
  border: 1rpx solid #b9cabc;
  color: #215d46;
  background: #ffffff;
  flex: 1;
}

.footer__btn--primary {
  background: #215d46;
  color: #ffffff;
  flex: 1.4;
}

.footer__btn--disabled {
  opacity: 0.5;
}

/* ============================================================
 * 保留段：状态卡 / #858 提示条（沿用本页原有样式口径）
 * ============================================================ */

/* 状态卡（loading/error/empty/v1） */

.state-card {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 70rpx 40rpx;
  text-align: center;
}

.state-card__spinner {
  width: 56rpx;
  height: 56rpx;
  margin: 0 auto 24rpx;
  border: 5rpx solid #dfe5df;
  border-top-color: #215d46;
  border-radius: 50%;
  animation: tp-spin 0.9s linear infinite;
}

@keyframes tp-spin {
  to {
    transform: rotate(360deg);
  }
}

.state-card__icon {
  width: 96rpx;
  height: 96rpx;
  margin: 0 auto 20rpx;
  display: block;
  opacity: 0.5;
}

.state-card__title {
  font-size: 33rpx;
  font-weight: 650;
}

.state-card__text {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #65716c;
  line-height: 1.7;
}

.state-card__cta {
  margin: 36rpx auto 0;
  width: 60%;
  background: #215d46;
  color: #ffffff;
  border-radius: 12rpx;
  padding: 20rpx 0;
  font-size: 28rpx;
  font-weight: 650;
}

/* #858 PR-E 提示条 */

.status-banner {
  display: flex;
  align-items: center;
  gap: 14rpx;
  border-radius: 14rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 24rpx;
}

.status-banner--adjust {
  background: #eaf2eb;
}

.status-banner--injury {
  background: #fdf3e7;
}

.status-banner__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #215d46;
  flex-shrink: 0;
}

.status-banner--injury .status-banner__dot {
  background: #a45a2a;
}

.status-banner__text {
  flex: 1;
  font-size: 25rpx;
  color: #42514a;
}

.status-banner__arrow {
  color: #65716c;
}
