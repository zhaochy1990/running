/* ============================================================
   训练状态页 —— 深色 STRIDE 主题（与 health / profile 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
  opacity: 0.7;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

.content {
  padding: 0 40rpx 48rpx;
}

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 27rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: #e3e2e5;
  margin-bottom: 24rpx;
}

.section-title--row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 加载 / 失败 ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 179, 175, 0.3);
  border-top-color: #ffb3af;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-card__text {
  margin-top: 24rpx;
  font-size: 22rpx;
  color: #9c9c9d;
}

/* ---------- 核心指标（2×2） ---------- */

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.metric-card {
  width: calc((100% - 24rpx) / 2);
  box-sizing: border-box;
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 24rpx;
  display: flex;
  flex-direction: column;
}

.metric-card__label {
  font-size: 20rpx;
  color: #9c9c9d;
}

.metric-card__sub {
  font-size: 17rpx;
  color: #6a6b6c;
  margin-top: 2rpx;
}

.metric-card__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #e3e2e5;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

.metric-card__unit {
  font-size: 20rpx;
  font-weight: 400;
  color: #9c9c9d;
  margin-left: 6rpx;
}

.metric-card__baseline {
  font-size: 17rpx;
  color: #9c9c9d;
  margin-top: 6rpx;
}

/* ---------- 时间窗口切换 ---------- */

.window-toggle {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 12rpx;
  padding: 4rpx;
}

.window-toggle__item {
  font-size: 19rpx;
  color: #9c9c9d;
  padding: 6rpx 14rpx;
  border-radius: 8rpx;
}

.window-toggle__item--active {
  color: #e3e2e5;
  background: rgba(255, 255, 255, 0.08);
}

/* ---------- 图表卡片 ---------- */

.chart-card {
  display: flex;
  flex-direction: column;
}

.chart-card__label {
  font-size: 20rpx;
  color: #9c9c9d;
  margin-bottom: 16rpx;
}

.chart {
  width: 100%;
  height: 280rpx;
}

.chart--sm {
  height: 240rpx;
}

.chart-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 160rpx;
  font-size: 20rpx;
  color: #6a6b6c;
}

/* ---------- 训练负荷 ---------- */

.load-grid {
  display: flex;
  flex-wrap: wrap;
}

.load-stat {
  width: 33.33%;
  box-sizing: border-box;
  padding: 12rpx 0;
}

.load-stat__label {
  font-size: 17rpx;
  color: #6a6b6c;
}

.load-stat__value {
  font-size: 32rpx;
  font-weight: 700;
  color: #e3e2e5;
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.readiness {
  margin-top: 16rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx 12rpx;
}

.readiness__badge {
  font-size: 20rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
}

.readiness__reasons {
  font-size: 17rpx;
  color: #6a6b6c;
}

/* ---------- Form 图例 / 注释 ---------- */

.legend {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  margin-top: 20rpx;
}

.legend__item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.legend__dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 4rpx;
}

.legend__text {
  font-size: 17rpx;
  color: #9c9c9d;
}

.chart-note {
  font-size: 17rpx;
  color: #6a6b6c;
  margin-top: 16rpx;
}

/* ---------- 16 周热力图 ---------- */

.heatmap {
  display: flex;
  gap: 4rpx;
}

.heatmap__gutter {
  width: 34rpx;
  display: flex;
  flex-direction: column;
}

.heatmap__gutter-month {
  height: 24rpx;
}

.heatmap__gutter-label {
  height: 32rpx;
  line-height: 32rpx;
  font-size: 17rpx;
  color: #9c9c9d;
  text-align: center;
}

.heatmap__col {
  width: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.heatmap__month {
  height: 24rpx;
  font-size: 17rpx;
  color: #9c9c9d;
  line-height: 24rpx;
  white-space: nowrap;
}

.heatmap__cell {
  width: 32rpx;
  height: 32rpx;
  border-radius: 4rpx;
  box-sizing: border-box;
}

.heatmap__cell--rest {
  background: rgba(255, 255, 255, 0.07);
}

.heatmap__cell--b1 {
  background: rgba(255, 143, 60, 0.25);
}

.heatmap__cell--b2 {
  background: rgba(255, 143, 60, 0.5);
}

.heatmap__cell--b3 {
  background: rgba(255, 143, 60, 0.75);
}

.heatmap__cell--b4 {
  background: #ff8f3c;
}

.heatmap__cell--absent {
  background: transparent;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
}

.heatmap__cell--unknown {
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx dashed rgba(255, 255, 255, 0.2);
}

.heatmap__cell--future {
  background: transparent;
  border: 1rpx dashed rgba(255, 255, 255, 0.08);
}

.heatmap__cell--today {
  border: 2rpx solid #ff6363;
}

.heatmap-legend {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
}

.heatmap-legend__text {
  font-size: 17rpx;
  color: #9c9c9d;
}

.heatmap-legend__swatch {
  width: 22rpx;
  height: 22rpx;
  border-radius: 4rpx;
}

.heat-detail {
  margin-top: 20rpx;
  padding: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.03);
}

.heat-detail__title {
  font-size: 20rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.heat-detail__dose {
  font-size: 20rpx;
  font-weight: 600;
  color: #e68a00;
  margin-top: 8rpx;
}

.heat-detail__line {
  font-size: 18rpx;
  color: #9c9c9d;
  margin-top: 6rpx;
  line-height: 1.5;
}

/* ---------- 配速 / 心率区间 ---------- */

.zone-card {
  padding-top: 20rpx;
}

.zone-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.zone-row:last-child {
  border-bottom: none;
}

.zone-row--head {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.zone-row__name {
  width: 150rpx;
  font-size: 19rpx;
  font-weight: 600;
}

.zone-row__name--pace {
  color: #ff8f3c;
}

.zone-row__name--hr {
  color: #ffb3af;
}

.zone-row__label {
  flex: 1;
  font-size: 20rpx;
  color: #e3e2e5;
}

.zone-row__range {
  font-size: 19rpx;
  color: #9c9c9d;
  font-variant-numeric: tabular-nums;
}

.zone-row--head .zone-row__label,
.zone-row--head .zone-row__range,
.zone-row--head .zone-row__name {
  color: #6a6b6c;
}

/* ---------- 数据状态 ---------- */

.footer {
  padding: 24rpx 8rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-top: 8rpx;
  font-size: 17rpx;
  color: #6a6b6c;
  line-height: 1.8;
}
