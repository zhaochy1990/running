<view class="page">
  <!-- 粉渐变头：顶栏与 hero 同一渐变（原型 navbar 粉底白字），右上常驻「兑换记录」 -->
  <view class="hero-wrap">
    <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
      <view class="top-bar__inner">
        <view class="top-bar__btn" bindtap="onBack">
          <image wx:if="{{canBack}}" class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right_white.svg" mode="aspectFit" />
          <image wx:else class="top-bar__icon" src="/assets/icons/home_white.svg" mode="aspectFit" />
        </view>
        <view class="top-bar__title-wrap">
          <view class="top-bar__title">积分商城</view>
        </view>
        <view class="top-bar__btn top-bar__btn--spacer"></view>
      </view>
    </view>

    <!-- hero：积分余额大数字 + 三链接（明细/兑换记录/签到赚分） -->
    <view class="hero">
      <view class="hero__left">
        <view class="hero__lab">我的积分</view>
        <view class="hero__num">{{balance}}<text class="hero__unit">分</text></view>
      </view>
      <view class="hero__links">
        <view class="hero__link" bindtap="onHeroDetail">明细 ›</view>
        <view class="hero__link" bindtap="onNavOrders">兑换记录 ›</view>
        <view class="hero__link" bindtap="onHeroCheckin">签到赚分 ›</view>
        <view class="hero__link" catchtap="onRulesTap">兑换规则 ›</view>
      </view>
    </view>
  </view>

  <view class="content">
    <!-- 首屏加载 -->
    <view wx:if="{{loading}}" class="page-loading">加载中…</view>

    <!-- 加载失败（首次进入）：hero 保留，卡片区给重试 -->
    <view wx:elif="{{loadFailed}}" class="card load-failed">
      <view class="load-failed__txt">商城加载失败，请检查网络后重试</view>
      <button class="load-failed__btn" hover-class="none" bindtap="onRetry">重新加载</button>
    </view>

    <block wx:else>
      <!-- 商品列表（变体 A 横排大卡：图左 192rpx 文右），白卡压 hero 边 -->
      <view wx:if="{{products.length === 0}}" class="empty">商城筹备中，敬请期待</view>
      <view
        wx:for="{{products}}"
        wx:key="id"
        class="pcard"
        data-pid="{{item.id}}"
      >
        <view class="prow">
          <!-- 商品图：COS 直链；V1 无图先占位色块 -->
          <image wx:if="{{item.imageUrl}}" class="pimg" src="{{item.imageUrl}}" mode="aspectFill" />
          <view wx:else class="pimg pimg--ph"></view>
          <view class="pinfo">
            <view class="pname">{{item.name}}</view>
            <view class="pdesc">{{item.description}}</view>
            <view class="ptags">
              <view wx:if="{{item.limit > 0}}" class="ptag">每人限{{item.limit}}件</view>
              <view wx:if="{{item.limitHit}}" class="ptag ptag--gray">已兑 {{item.redeemed}}/{{item.limit}}</view>
              <view wx:if="{{item.soldOut}}" class="ptag ptag--gray">售罄</view>
            </view>
            <view class="pbottom">
              <view class="price"><text class="price__n">{{item.price}}</text><text class="price__u">积分</text></view>
              <!-- view 自绘：原生 button 内置固定宽，类样式压不过（同下方 sbtn/地址页坑）；置灰态由 onRedeemTap 拦截 -->
              <view
                class="buy {{item.soldOut || item.limitHit ? 'buy--disabled' : ''}}"
                aria-role="button"
                hover-class="none"
                data-pid="{{item.id}}"
                bindtap="onRedeemTap"
              >{{item.soldOut ? '已售罄' : item.limitHit ? '已达限购' : '兑换'}}</view>
            </view>
          </view>
        </view>
        <!-- 售罄蒙层 -->
        <view wx:if="{{item.soldOut}}" class="soldout-mask"><view class="soldout-mask__stamp">已售罄</view></view>
      </view>
    </block>
  </view>

  <!-- 兑换确认抽屉（底部 sheet）：商品行/地址单选/余额预览/确认 -->
  <view wx:if="{{sheetVisible}}" class="mask" bindtap="onSheetClose">
    <view class="sheet" catchtap="noop">
      <view class="sheet__title">确认兑换</view>
      <view class="sprod">
        <image wx:if="{{sheetImageUrl}}" class="sprod__img" src="{{sheetImageUrl}}" mode="aspectFill" />
        <view wx:else class="sprod__img"></view>
        <view class="sprod__name">{{sheetName}}</view>
        <view class="sprod__price">{{sheetPrice}} 分</view>
      </view>
      <!-- 尺码区（devops#910）：仅 by_sku 商品渲染（sheetSkus 非空）；售罄码置灰不可点，
           未选码在标题行提示，提交钮同步置灰（single 商品整块不出现，现网行为） -->
      <block wx:if="{{sheetSkus.length}}">
        <view class="sec">
          <text>尺码</text>
          <text wx:if="{{!sheetSkuId}}" class="sec__hint">请选择尺码</text>
        </view>
        <view class="skus">
          <view
            wx:for="{{sheetSkus}}"
            wx:key="id"
            class="sku {{sheetSkuId === item.id ? 'sku--sel' : ''}} {{item.stock <= 0 ? 'sku--off' : ''}}"
            data-sid="{{item.id}}"
            aria-role="button"
            hover-class="none"
            catchtap="onSkuTap"
          >{{item.spec_value}}</view>
        </view>
      </block>
      <!-- 数量步进：右列合计 = 单价 × 数量（运费只在运费行体现，步进样式沿用抖音口径：−/数字/+） -->
      <view class="qtyrow">
        <text class="qtyrow__label">数量</text>
        <view class="qtyrow__ctrl">
          <view
            class="stepper {{sheetQty <= 1 ? 'stepper--off' : ''}}"
            aria-role="button"
            hover-class="none"
            catchtap="onQtyMinus"
          >−</view>
          <text class="stepper__n">{{sheetQty}}</text>
          <view
            class="stepper {{sheetQty >= sheetMaxQty ? 'stepper--off' : ''}}"
            aria-role="button"
            hover-class="none"
            catchtap="onQtyPlus"
          >＋</view>
        </view>
        <text class="qtyrow__total">合计 <text class="qtyrow__sum">{{sheetTotal}} 积分</text></text>
      </view>
      <view class="sec">
        <text>寄到哪</text>
        <text wx:if="{{!sheetNoAddress}}" class="sec__mg" catchtap="onSheetManageAddr">管理地址 ›</text>
      </view>
      <block wx:if="{{!sheetNoAddress}}">
        <view
          wx:for="{{sheetAddresses}}"
          wx:key="id"
          class="aradio {{sheetSelectedId === item.id ? 'aradio--sel' : ''}}"
          data-aid="{{item.id}}"
          bindtap="onSheetSelectAddr"
        >
          <view class="aradio__dot"></view>
          <view class="aradio__body">
            <view class="aradio__who">{{item.name}}　{{item.phone}}</view>
            <view class="aradio__addr">{{item.addr}}</view>
          </view>
        </view>
      </block>
      <view wx:else class="noaddr">
        <text>还没有收货地址　</text><text class="noaddr__add" catchtap="onSheetAddAddr">去添加 ›</text>
      </view>
      <!-- 运费行（devops#905）：紧贴地址单选，切地址运费即时刷新；免运绿「包邮」/ 应收「¥N」 -->
      <view wx:if="{{!sheetNoAddress}}" class="feeline">
        <text>运费</text>
        <text class="feeline__v {{sheetFeeFree ? 'feeline__v--free' : ''}}">{{sheetFeeText}}</text>
      </view>
      <view class="bal-line">
        <text>当前 {{balance}} 分</text>
        <text wx:if="{{!sheetInsufficient}}" class="bal-line__after">兑换后剩余 <text class="bal-line__b">{{sheetAfter}}</text> 分</text>
        <text wx:else class="bal-line__lack">积分不足，还差 <text class="bal-line__b">{{sheetLack}}</text> 分</text>
      </view>
      <!-- 确认兑换：无地址/积分不足/by_sku 未选尺码/提交中一律置灰（文案不变，不换去签到分支）
           view 自绘：原生 button 内置固定宽反压类样式（同地址页坑） -->
      <view
        class="sbtn {{sheetNoAddress || sheetSubmitting || sheetInsufficient || (sheetSkus.length && !sheetSkuId) ? 'sbtn--disabled' : ''}}"
        aria-role="button"
        hover-class="none"
        catchtap="onSheetConfirm"
      >{{sheetSubmitting ? '兑换中…' : '确认兑换'}}</view>
    </view>
  </view>

  <!-- 兑换规则弹窗（hero「兑换规则」唤起，同 checkin 规则弹窗范式）：内容区可滚动，遮罩点按或「知道了」关闭 -->
  <view wx:if="{{rulesVisible}}" class="rules-mask" bindtap="onRulesClose">
    <view class="rules-card" catchtap="noop">
      <view class="rules-card__t">砺跑马拉松助手积分商城兑换规则</view>
      <view class="rules-card__body">
        <view class="rules-card__p">参与 砺跑马拉松助手积分商城兑换的用户，可使用账户内积分兑换商城内指定礼品。</view>
        <view class="rules-card__tip">重要声明：本平台积分仅为本小程序自营福利积分，无现金价值、不可折现、不可转让、不可交易，仅可用于本积分商城兑换指定礼品；积分永久有效，不会到期清零。</view>

        <view class="rules-card__h2">一、积分来源</view>
        <view class="rules-card__p">商城内用于兑换的积分，来自小程序内签到、任务、活动等官方发放渠道，不支持充值购买积分。</view>

        <view class="rules-card__h2">二、兑换说明</view>
        <view class="rules-card__p">1. 兑换商品所需积分以商品详情页展示数值为准，兑换时系统自动扣减对应积分；</view>
        <view class="rules-card__p">2. 商品库存实时更新，先兑先得，库存不足时无法兑换；</view>
        <view class="rules-card__p">3. 兑换订单提交成功后，积分即时扣除，积分一经扣除不予退回（商品缺货下架、主办方主动取消订单除外）；</view>
        <view class="rules-card__p">4. 兑换礼品仅限本人使用，禁止倒卖、转售兑换所得礼品。</view>

        <view class="rules-card__h2">三、发货与售后</view>
        <view class="rules-card__p">1. 实物礼品：兑换成功后，将在公示周期内安排发货，收货信息以用户提交地址为准；地址填写错误造成无法收货，由用户自行承担；</view>
        <view class="rules-card__p">2. 虚拟礼品（跑步课程、训练计划等）：兑换成功后自动发放至账户；</view>
        <view class="rules-card__p">3. 福利兑换商品不支持 7 天无理由退换；如存在质量破损，请在签收后指定时限内联系小程序客服核验。</view>

        <view class="rules-card__h2">四、其他说明</view>
        <view class="rules-card__p">1. 本商城福利仅限 砺跑马拉松助手小程序注册用户参与，同一账号仅限本人使用；</view>
        <view class="rules-card__p">2. 如对兑换活动有疑问，可通过小程序内客服渠道咨询；</view>
        <view class="rules-card__p">3. 若用户通过脚本、刷号、系统漏洞、虚假操作等非正常方式获取积分、兑换商品，砺跑马拉松助手有权撤销兑换、收回礼品、扣除违规积分、取消活动参与资格；</view>
        <view class="rules-card__p">4. 商城商品、库存、兑换规则，主办方可以提前在小程序公告公示后进行调整、下架；</view>
        <view class="rules-card__p">5. 本积分商城活动由 砺跑马拉松助手独立提供，与微信平台无关；活动最终解释权归 砺跑马拉松助手所有。</view>
      </view>
      <button class="rules-card__btn" hover-class="none" catchtap="onRulesClose">知道了</button>
    </view>
  </view>

  <!-- 兑换成功居中弹卡 -->
  <view wx:if="{{okVisible}}" class="okmask">
    <view class="okcard">
      <view class="okcard__ic">✓</view>
      <view class="okcard__h">兑换成功</view>
      <view class="okcard__p">{{okName}}　<text class="okcard__b">-{{okCost}} 分</text></view>
      <!-- 尺码快照（devops#910）：by_sku 订单展示，single/旧单空 = 不渲染 -->
      <view wx:if="{{okSku}}" class="okcard__p">尺码 {{okSku}}</view>
      <view class="okcard__p">剩余 {{okBalance}} 分，可在「兑换记录」查看进度</view>
      <button class="sbtn" hover-class="none" catchtap="onOkOrders">查看订单</button>
      <button class="sbtn sbtn--ghost" hover-class="none" catchtap="onOkContinue">继续逛逛</button>
    </view>
  </view>

  <!-- 游客态：登录引导弹层（沿用 checkin/profile 游客范式） -->
  <view wx:if="{{guest}}" class="guest-mask">
    <view class="guest-card">
      <view class="guest-card__ic">🛍️</view>
      <view class="guest-card__h">积分商城</view>
      <view class="guest-card__p">签到攒积分，兑换周边好礼</view>
      <button class="guest-card__btn" hover-class="none" bindtap="onGuestLogin">微信一键登录</button>
    </view>
  </view>
</view>
