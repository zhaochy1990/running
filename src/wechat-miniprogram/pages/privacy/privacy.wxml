<view class="page">
  <!-- 自定义顶部栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">隐私与权限</view>
        <view class="top-bar__subtitle">协议声明与数据说明</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <!-- 内容 -->
  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;">
    <view class="card menu-card">
      <view
        wx:for="{{rows}}"
        wx:key="key"
        class="menu-row"
        data-key="{{item.key}}"
        bindtap="onRowTap"
      >
        <image class="menu-row__icon" src="{{item.iconPath}}" mode="aspectFit" />
        <view class="menu-row__body">
          <view class="menu-row__title">{{item.title}}</view>
          <view class="menu-row__subtitle">{{item.subtitle}}</view>
        </view>
        <image class="menu-row__chevron" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>
