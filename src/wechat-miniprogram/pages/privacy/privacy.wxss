/* ============================================================
   隐私与权限页 —— 深色 STRIDE 主题（与 profile / watch 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

.content {
  padding: 0 40rpx 48rpx;
}

/* ---------- 声明菜单（与 profile 页 menu-row 同构） ---------- */

.menu-card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 8rpx 28rpx 8rpx 28rpx;
  margin-bottom: 48rpx;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.menu-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-row__title {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.menu-row__subtitle {
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-row__chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.6;
}
