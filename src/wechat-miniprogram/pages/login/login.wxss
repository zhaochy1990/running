/* ============================================================
   登录页 —— 依据 design/login_1.html（邮箱登录）+ login_2.html（手机号登录）
   深色 STRIDE 主题：背景 #07080A、卡片 #141517、主色 #FF6363
   ============================================================ */

.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 64rpx 32rpx calc(64rpx + env(safe-area-inset-bottom));
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- Header ---------- */

.login-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 80rpx;
}

.login-brand {
  width: 160rpx;
  height: 160rpx;
  border-radius: 48rpx;
  background: #1f2022;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.2);
}

.login-brand-icon {
  width: 80rpx;
  height: 80rpx;
}

.login-title {
  font-size: 48rpx;
  line-height: 64rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 6rpx;
  margin-bottom: 8rpx;
}

.login-subtitle {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 500;
  color: #a0a0a0;
  letter-spacing: 1rpx;
  text-align: center;
}

/* ---------- 表单卡片 ---------- */

.login-card {
  background: #141517;
  border-radius: 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  padding: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
}

/* ---------- 分段切换 ---------- */

.login-tabs {
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
  margin-bottom: 48rpx;
}

.login-tab {
  flex: 1;
  position: relative;
  padding: 32rpx 0;
  text-align: center;
  font-size: 30rpx;
  font-weight: 500;
  color: #8a8b8c;
}

.login-tab-active {
  color: #ffffff;
  font-weight: 700;
}

.login-tab-active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 96rpx;
  height: 8rpx;
  border-radius: 8rpx;
  background: #ff6363;
}

/* ---------- 表单字段 ---------- */

.login-form {
  display: flex;
  flex-direction: column;
}

.login-field {
  margin-bottom: 48rpx;
}

.login-field-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.login-label {
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #d1d1d1;
  letter-spacing: 1rpx;
  margin: 0 4rpx 16rpx;
}

.login-field-head .login-label {
  margin-bottom: 0;
}

.login-forgot {
  font-size: 26rpx;
  line-height: 32rpx;
  font-weight: 500;
  color: #55b3ff;
  padding: 12rpx 16rpx;
}

/* ---------- 输入框 ---------- */

.login-input-wrap {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  background: #1d1e20;
  border: 2rpx solid transparent;
  border-radius: 32rpx;
  transition: box-shadow 0.2s ease-out;
}

.login-input-focused {
  box-shadow: 0 0 0 4rpx #ff6363;
}

.login-input-icon {
  position: absolute;
  left: 32rpx;
  width: 40rpx;
  height: 40rpx;
}

.login-input {
  flex: 1;
  height: 96rpx;
  padding: 0 32rpx 0 96rpx;
  font-size: 32rpx;
  color: #f9f9f9;
  background: transparent;
  border: none;
}

.login-input-with-action {
  padding-right: 96rpx;
}

.login-input-with-code {
  padding-right: 240rpx;
}

.login-input-phone {
  padding-left: 32rpx;
}

.login-placeholder {
  color: #7a7a7b;
}

.login-input-action {
  position: absolute;
  right: 16rpx;
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-input-action-icon {
  width: 40rpx;
  height: 40rpx;
}

.login-country-code {
  align-self: stretch;
  display: flex;
  align-items: center;
  padding: 0 24rpx 0 32rpx;
  font-size: 30rpx;
  font-weight: 500;
  color: #a0a0a0;
  border-right: 1rpx solid rgba(255, 255, 255, 0.1);
}

/* 验证码按钮（含倒计时态） */
.login-code-btn {
  position: absolute;
  right: 16rpx;
  top: 50%;
  transform: translateY(-50%);
  padding: 20rpx 32rpx;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 40rpx;
  color: #ff6363;
  background: rgba(255, 99, 99, 0.1);
  border-radius: 24rpx;
}

.login-code-btn-disabled {
  opacity: 0.5;
}

/* ---------- 错误提示 ---------- */

.login-error {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #ff6363;
  margin: -16rpx 0 32rpx;
}

/* ---------- 主按钮 ---------- */

.login-actions {
  padding-top: 32rpx;
}

.login-cta {
  height: 112rpx;
  line-height: 112rpx;
  margin: 0;
  padding: 0;
  border-radius: 32rpx;
  background: #ff6363;
  color: #ffffff;
  font-size: 34rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 12rpx 32rpx rgba(255, 99, 99, 0.2);
}

.login-cta::after {
  border: none;
}

.login-cta-disabled {
  opacity: 0.6;
}

/* ---------- 法务条款 ---------- */

.login-terms {
  margin-top: 80rpx;
  text-align: center;
}

.login-terms-text {
  font-size: 26rpx;
  line-height: 36rpx;
  color: #6a6b6c;
  letter-spacing: 1rpx;
}

.login-terms-links {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #6a6b6c;
}

.login-terms-link {
  display: inline-block;
  color: #e3e2e5;
  text-decoration: underline;
  text-decoration-color: rgba(255, 255, 255, 0.2);
  padding: 8rpx 4rpx;
}

.login-terms-sep {
  margin: 0 8rpx;
}
