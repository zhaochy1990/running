/* ============================================================
   Onboarding 三步页 —— 深色 STRIDE 主题（与登录页同一套配色）
   背景 #07080A、卡片 #141517、主色 #FF6363
   ============================================================ */

.ob-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 步骤指示 ---------- */

.ob-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.ob-steps__item {
  font-size: 26rpx;
  color: #6a6b6c;
}

.ob-steps__item--on {
  color: #ff6363;
  font-weight: 600;
}

.ob-steps__sep {
  width: 32rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ---------- Hero ---------- */

.ob-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 56rpx;
}

.ob-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.ob-subtitle {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a8b8c;
  max-width: 560rpx;
}

.ob-spinner {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 99, 99, 0.2);
  border-top-color: #ff6363;
  animation: ob-spin 0.9s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes ob-spin {
  to {
    transform: rotate(360deg);
  }
}

.ob-success-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 99, 99, 0.12);
  color: #ff6363;
  font-size: 64rpx;
  line-height: 120rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

/* ---------- 卡片 ---------- */

.ob-card {
  background: #141517;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.ob-card--pad {
  padding: 32rpx 32rpx 40rpx;
}

.ob-card--gap {
  margin-top: 28rpx;
}

/* ---------- 头像 ---------- */

.ob-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

.ob-avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: transparent;
  line-height: normal;
}

.ob-avatar-btn::after {
  border: none;
}

.ob-avatar {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
}

.ob-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed rgba(255, 255, 255, 0.18);
  box-sizing: border-box;
}

.ob-avatar__hint {
  font-size: 24rpx;
  color: #8a8b8c;
}

.ob-avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6a6b6c;
}

/* ---------- 表单 ---------- */

.ob-field {
  margin-bottom: 28rpx;
}

.ob-field-row {
  display: flex;
  gap: 24rpx;
}

.ob-field--half {
  flex: 1;
}

.ob-field__label {
  font-size: 26rpx;
  color: #8a8b8c;
  margin-bottom: 14rpx;
}

.ob-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #ffffff;
  font-size: 30rpx;
  box-sizing: border-box;
}

.ob-input--picker {
  display: flex;
  align-items: center;
}

.ob-placeholder {
  color: #5c5d5f;
}

.ob-error {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #ff6363;
  line-height: 1.5;
}

.ob-error--loose {
  margin: 24rpx 8rpx 0;
}

/* ---------- 品牌入口 ---------- */

.ob-provider {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ob-provider-last {
  border-bottom: none;
}

.ob-provider--on {
  background: rgba(255, 99, 99, 0.08);
}

.ob-provider-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.ob-provider-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a0a0;
}

.ob-provider-check {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  color: #ff6363;
}

/* ---------- 进度 ---------- */

.ob-progress {
  padding: 40rpx 36rpx;
}

.ob-progress__text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.ob-progress__bar {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.ob-progress__fill {
  height: 100%;
  border-radius: 6rpx;
  background: #ff6363;
  transition: width 0.4s ease;
}

.ob-progress__hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a8b8c;
}

/* ---------- 跳过 / 主按钮 ---------- */

.ob-skip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8b8c;
  padding: 16rpx;
}

.ob-skip:active {
  opacity: 0.7;
}

.ob-cta {
  margin-top: 40rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  background: #ff6363;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 99, 99, 0.18);
}

.ob-cta::after {
  border: none;
}

.ob-cta--disabled {
  opacity: 0.6;
}
