/* ============================================================
   Onboarding 三步页 —— 深色 STRIDE 主题（与登录页同一套配色）
   背景 #07080A、卡片 #141517、主色 #FF6363
   ============================================================ */

.ob-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 48rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 步骤指示 ---------- */

.ob-steps {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 48rpx;
}

.ob-steps__item {
  font-size: 26rpx;
  color: #6a6b6c;
}

.ob-steps__item--on {
  color: #ff6363;
  font-weight: 600;
}

.ob-steps__sep {
  width: 32rpx;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.12);
}

/* ---------- Hero ---------- */

.ob-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 56rpx;
}

.ob-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.ob-subtitle {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a8b8c;
  max-width: 560rpx;
}

.ob-spinner {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 6rpx solid rgba(255, 99, 99, 0.2);
  border-top-color: #ff6363;
  animation: ob-spin 0.9s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes ob-spin {
  to {
    transform: rotate(360deg);
  }
}

.ob-success-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 99, 99, 0.12);
  color: #ff6363;
  font-size: 64rpx;
  line-height: 120rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

/* ---------- 卡片 ---------- */

.ob-card {
  background: #141517;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.ob-card--pad {
  padding: 32rpx 32rpx 40rpx;
}

.ob-card--gap {
  margin-top: 28rpx;
}

/* ---------- 头像 ---------- */

.ob-avatar-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
}

/* 头像必须是 <button open-type="chooseAvatar">。WeChat 的 button 自带
   min-width / min-height / padding / line-height，实测它的盒子会被撑成
   约 320rpx 宽 × 160rpx 高 —— 不是正方形。所以：① 把 button 的默认约束压掉；
   ② 内层头像用**固定正方形**并自居中，不写 100%（写 100% 就会跟着宽盒子拉成椭圆）。 */
.ob-avatar-btn {
  /* !important：WeChat 基座给 button 的 width 约束优先级高于普通类选择器，
     实测 width/min-width 一起写都压不住（高度能生效、宽度不生效）。 */
  width: 160rpx !important;
  max-width: 160rpx !important;
  min-width: 0 !important;
  height: 160rpx;
  min-height: 0;
  padding: 0;
  margin: 0;
  line-height: 1;
  border-radius: 50%;
  overflow: hidden;
  background: transparent;
  box-sizing: border-box;
}

.ob-avatar-btn::after {
  border: none;
}

.ob-avatar {
  display: block;
  margin: 0 auto;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
}

/* 占位不用虚线框：大圆角下的虚线边框会被渲染成凹凸不平的椭圆。
   改成实底圆 + 图标（与「我的」页的头像占位一致）。 */
.ob-avatar--empty {
  display: flex;
  align-items: center;
  justify-content: center;
}

.ob-avatar__icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.35;
}

.ob-avatar-tip {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #6a6b6c;
}

/* ---------- 表单 ---------- */

.ob-field {
  margin-bottom: 28rpx;
}

.ob-field-row {
  display: flex;
  gap: 24rpx;
}

.ob-field--half {
  flex: 1;
}

.ob-field__label {
  font-size: 26rpx;
  color: #8a8b8c;
  margin-bottom: 14rpx;
}

.ob-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.07);
  color: #ffffff;
  font-size: 30rpx;
  box-sizing: border-box;
}

.ob-input--picker {
  display: flex;
  align-items: center;
}

.ob-placeholder {
  color: #5c5d5f;
}

.ob-error {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #ff6363;
  line-height: 1.5;
}

.ob-error--loose {
  margin: 24rpx 8rpx 0;
}

/* ---------- 品牌入口 ---------- */

.ob-provider {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ob-provider-last {
  border-bottom: none;
}

.ob-provider--on {
  background: rgba(255, 99, 99, 0.08);
}

.ob-provider-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.ob-provider-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a0a0;
}

.ob-provider-check {
  width: 40rpx;
  text-align: right;
  font-size: 34rpx;
  color: #ff6363;
}

/* ---------- 进度 ---------- */

.ob-progress {
  padding: 40rpx 36rpx;
}

.ob-progress__text {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}

.ob-progress__bar {
  margin-top: 24rpx;
  height: 12rpx;
  border-radius: 6rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.ob-progress__fill {
  height: 100%;
  border-radius: 6rpx;
  background: #ff6363;
  transition: width 0.4s ease;
}

.ob-progress__hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #8a8b8c;
}

/* ---------- 跳过 / 主按钮 ---------- */

.ob-skip {
  margin-top: 48rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8b8c;
  padding: 16rpx;
}

.ob-skip:active {
  opacity: 0.7;
}

/* 通栏：与上方输入框对齐。WeChat 的 button 默认 width:auto（收缩到内容宽），
   登录页是靠外层 flex 撑满的，这里直接放在卡片里就必须显式写 100%。 */
.ob-cta {
  width: 100% !important;
  box-sizing: border-box;
  margin: 40rpx 0 0;
  padding: 0;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  background: #ff6363;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 99, 99, 0.18);
}

.ob-cta::after {
  border: none;
}

.ob-cta--disabled {
  opacity: 0.6;
}
