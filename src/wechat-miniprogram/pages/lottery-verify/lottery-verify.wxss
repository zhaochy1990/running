/* 工作人员核销页 —— devops#869（Epic #862 P6）。
   工作页样式（#678 落地页同骨架）：底 / 卡 / 文字全引全局令牌，accent 族用
   --color-accent / --color-accent-tint，成功态用 --color-success。 */

page {
  background: var(--color-bg);
}

.page {
  min-height: 100vh;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* ---------- 顶栏（fixed） ---------- */

.top {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 32rpx;
  background: rgba(255, 255, 255, 0.97);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top__home {
  width: 44rpx;
  height: 44rpx;
  padding: 12rpx;
  flex-shrink: 0;
}

.top__title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* ---------- 空态 / 加载（#678 同款骨架） ---------- */

.state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 64rpx 0;
}

.state__spinner {
  width: 56rpx;
  height: 56rpx;
  border: 5rpx solid var(--color-bg-sunken);
  border-top-color: var(--color-accent);
  border-radius: 50%;
  animation: spin 0.9s linear infinite;
}

.state__logo {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 48rpx;
  font-weight: 700;
  text-align: center;
  line-height: 128rpx;
  margin-bottom: 32rpx;
}

.state__title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-bright);
}

.state__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  text-align: center;
}

.state__cta {
  margin-top: 40rpx;
  padding: 0 64rpx;
  line-height: 80rpx;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ---------- 卡片通用 ---------- */

.card {
  margin: 24rpx 32rpx 0;
  border-radius: 24rpx;
  background: var(--color-card);
  border: 1rpx solid var(--color-border-soft);
  padding: 32rpx;
}

.card__title {
  font-size: 26rpx;
  font-weight: 700;
  color: var(--color-text-bright);
  margin-bottom: 24rpx;
}

/* ---------- 编号输入 ---------- */

.lookup {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.lookup__input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 16rpx;
  background: var(--color-bg-sunken);
  font-size: 40rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: var(--color-text-bright);
}

.lookup__btn {
  flex-shrink: 0;
  padding: 0 40rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
}

.lookup__btn--disabled {
  opacity: 0.45;
}

.lookup__error {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: var(--color-accent-light);
}

/* ---------- 白名单未命中引导 ---------- */

.blocked__title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-bright);
}

.blocked__text {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.blocked__openid {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  background: var(--color-bg-sunken);
  font-size: 24rpx;
  color: var(--color-text-primary);
  word-break: break-all;
  user-select: text;
  -webkit-user-select: text;
}

.blocked__copy {
  margin-top: 24rpx;
  padding: 0 40rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
  font-size: 24rpx;
  font-weight: 600;
}

/* ---------- 中奖详情卡 ---------- */

.entry__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.entry__code {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 12rpx;
  color: var(--color-text-bright);
}

.entry__badge {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
  font-size: 24rpx;
  font-weight: 600;
}

.entry__badge--verified {
  background: rgba(var(--color-success-rgb), 0.12);
  color: var(--color-success);
}

.entry__prize {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.entry__img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
}

.entry__img--fallback {
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  line-height: 128rpx;
}

.entry__titles {
  flex: 1;
  min-width: 0;
}

.entry__name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-bright);
}

.entry__meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.entry__verified {
  color: var(--color-success);
}

.entry__cta {
  margin-top: 32rpx;
  text-align: center;
  line-height: 92rpx;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 30rpx;
  font-weight: 700;
}

.entry__cta--disabled {
  opacity: 0.45;
}
