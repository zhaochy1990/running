/* ============================================================
   赛事详情页 —— 深色 STRIDE 主题（与赛事中心列表页 #392 一致）。
   版式按 #385 定稿：头区（名称+星标+双徽章 → 三宫格 → 报名时间轴 →
   报名按钮）+ 概要/项目/出行 tab；#546 有赛道内容时增设赛道 tab。
   app.wxss 全局令牌是浅色，深色类在本页重定义。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部栏（同列表页） ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.content {
  padding: 0 24rpx 48rpx;
}

/* ---------- 加载 / 错误（同列表页） ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: #9c9c9d;
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.banner--error {
  background: rgba(255, 99, 99, 0.1);
  border: 1rpx solid rgba(255, 99, 99, 0.2);
  color: #ff6363;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: #5fc992;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* ---------- 卡片与标题 ---------- */

.card {
  background: #101111;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card__title {
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  color: #9c9c9d;
  margin-bottom: 16rpx;
}

.card__empty {
  padding: 24rpx 0 8rpx;
  font-size: 24rpx;
  color: #6a6a6c;
}

/* ---------- 头区 ---------- */

.head__r1 {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
}

.head__name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  color: #e3e2e5;
}

.head__star {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  line-height: 64rpx;
  color: #6a6a6c;
}

.head__star--on {
  color: #ffb3af;
}

/* 标签全称双徽章（同列表行：田协暖色 / 世界田联冷色） */

.head__badges {
  display: flex;
  gap: 12rpx;
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 28rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
}

.badge--cn {
  color: #e8c07d;
  background: rgba(232, 192, 125, 0.12);
}

.badge--wa {
  color: #8fb8e8;
  background: rgba(143, 184, 232, 0.12);
}

/* 三宫格：天后开赛 / 比赛日 / 报名制式 */

.grid {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.grid__cell {
  flex: 1;
  min-width: 0;
  background: #17181a;
  border-radius: 12rpx;
  padding: 16rpx 8rpx;
  text-align: center;
}

.grid__value {
  font-size: 30rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
}

.grid__value--lead {
  color: #ffb3af;
}

.grid__label {
  margin-top: 4rpx;
  font-size: 18rpx;
  line-height: 26rpx;
  color: #8a8a8c;
  white-space: nowrap;
  overflow: hidden;
}

/* 报名时间轴：报名开始 → 截止 → 出签·缴费 → 开赛，已完成绿色 */

.tl {
  display: flex;
  align-items: flex-start;
  margin-top: 24rpx;
  padding: 20rpx 8rpx 12rpx;
  background: #17181a;
  border-radius: 12rpx;
}

.tl__step {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.tl__date {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #8a8a8c;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
}

.tl__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #3a3b3d;
}

.tl__label {
  font-size: 18rpx;
  line-height: 26rpx;
  color: #6a6a6c;
  white-space: nowrap;
}

.tl__bar {
  flex: 0 0 32rpx;
  height: 2rpx;
  margin-top: 37rpx; /* 对齐日期行(30)+gap(8)下沿的圆点中心 */
  background: #3a3b3d;
}

.tl__step--on .tl__date {
  color: #5fc992;
  font-weight: 600;
}

.tl__step--on .tl__dot {
  background: #5fc992;
  box-shadow: 0 0 0 6rpx rgba(95, 201, 146, 0.15);
}

.tl__step--on .tl__label {
  color: #5fc992;
}

.tl__bar--on {
  background: rgba(95, 201, 146, 0.55);
}

/* 报名按钮：唯一的计划创建入口 */

.signup-btn {
  margin-top: 24rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 40rpx;
  background: rgba(255, 99, 99, 0.14);
  border: 1rpx solid rgba(255, 99, 99, 0.38);
  color: #ff6363;
  font-size: 26rpx;
  font-weight: 600;
}

.signup-btn:active {
  background: rgba(255, 99, 99, 0.24);
}

/* ---------- 三 tab ---------- */

.tabs {
  position: sticky;
  z-index: 10;
  display: flex;
  margin-bottom: 24rpx;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.tabs__item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #8a8a8c;
}

.tabs__item--on {
  color: #ff6363;
  font-weight: 700;
  border-bottom: 4rpx solid #ff6363;
}

/* ---------- 键值行 ---------- */

.kv {
  display: flex;
  gap: 16rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.kv--last {
  border-bottom: none;
}

.kv__k {
  flex: 0 0 128rpx;
  font-size: 24rpx;
  line-height: 36rpx;
  color: #8a8a8c;
}

.kv__v {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 36rpx;
  color: #e3e2e5;
  word-break: break-all;
}

.kv__v--dim {
  color: #6a6a6c;
}

.kv__line {
  font-size: 26rpx;
  line-height: 40rpx;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
}

/* 领物时间是自由文本（如 10/30 09:00-20:00），窄列换行展示 */
.pickup__time {
  line-height: 36rpx;
  white-space: normal;
}

/* ---------- 报名渠道行 ---------- */

.ch {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ch:last-child {
  border-bottom: none;
}

.ch__name {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #e3e2e5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.ch__type {
  margin-left: 10rpx;
  font-size: 18rpx;
  color: #6a6a6c;
}

.ch__copy {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #ff6363;
  padding: 4rpx 12rpx;
  border: 1rpx solid rgba(95, 201, 146, 0.35);
  border-radius: 20rpx;
}

.ch__inline {
  flex-shrink: 0;
  font-size: 22rpx;
  color: #6a6a6c;
}

/* ---------- 城市景点 ---------- */

.attr {
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.attr:last-child {
  border-bottom: none;
}

.attr__name {
  font-size: 26rpx;
  line-height: 38rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.attr__desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #8a8a8c;
}

/* ---------- 空态 ---------- */

.empty-card__title {
  white-space: normal;
  line-height: 40rpx;
}

/* ---------- 赛道 tab（#546）：路线文字 + 赛道全景站点线 ---------- */

/* 路线文字串：整宽段落（项目 tab 里的赛道行是 kv 窄列，此处为赛道主场） */
.course__route {
  font-size: 26rpx;
  line-height: 42rpx;
  color: #c9c9cb;
}

.course__sep {
  margin: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.05);
}

.course__head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.course__head .card__title {
  margin-bottom: 0;
}

.course__meta {
  font-size: 22rpx;
  color: #8a8a8c;
  font-variant-numeric: tabular-nums;
}

/* 纵向站点线：线在左，站点卡绝对定位（top 由 utils/raceCourse 按紧凑间距算出） */
.course__plot {
  position: relative;
  margin-top: 24rpx;
  margin-left: 8rpx;
}

.course__vline {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
  border-radius: 3rpx;
  background: #17181a;
}

.course__station {
  position: absolute;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-start;
}

/* 展开的站点卡提到最上层：紧凑间距下允许盖过相邻卡 */
.course__station--open {
  z-index: 10;
}

.course__dot {
  flex-shrink: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  /* 对齐卡片首行文字的视觉中心：卡 padding 16rpx + 标题行高一半，
     圆点含边框总高 26rpx；实机量偏差校准为 22rpx */
  margin-top: 22rpx;
  margin-left: -7rpx;
  border: 3rpx solid #101111;
}

.course__card {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  background: #17181a;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.course__card--open {
  background: #1d1e21;
}

.course__row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.course__cat {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 28rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
}

.course__title {
  flex: 1;
  min-width: 0;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 36rpx;
  color: #e3e2e5;
}

.course__km {
  flex-shrink: 0;
  font-size: 20rpx;
  font-variant-numeric: tabular-nums;
}

.course__more {
  margin-top: 6rpx;
  font-size: 20rpx;
  color: #6a6a6c;
}

.course__body {
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: #c9c9cb;
}

.course__finish {
  margin-top: 16rpx;
  margin-left: 8rpx;
  font-size: 20rpx;
  color: #6a6a6c;
}

/* ---------- 报名选择器 action sheet ---------- */

.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 90;
  background: rgba(0, 0, 0, 0.6);
}

.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  background: #141517;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 40rpx calc(32rpx + env(safe-area-inset-bottom));
}

.sheet__hint {
  font-size: 22rpx;
  line-height: 34rpx;
  color: #8a8a8c;
  padding-bottom: 20rpx;
}

.sheet__chips {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 16rpx;
  padding-bottom: 24rpx;
}

.sheet__chips-label {
  font-size: 24rpx;
  color: #9c9c9d;
}

.chip {
  padding: 10rpx 30rpx;
  border-radius: 28rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  font-size: 26rpx;
  color: #b9b8bc;
}

.chip--on {
  border-color: rgba(255, 99, 99, 0.6);
  background: rgba(255, 99, 99, 0.14);
  color: #ff6363;
  font-weight: 600;
}

.sheet__opt {
  padding: 26rpx 8rpx;
  font-size: 28rpx;
  color: #d5d4d7;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.sheet__opt--on {
  color: #ff6363;
  font-weight: 600;
}

.sheet__check {
  font-weight: 400;
}

.sheet__cancel {
  margin-top: 20rpx;
  padding: 20rpx 0 8rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8c;
}

/* ── 比赛策略卡（#396：未生成=CTA / 已生成=摘要 → 报告页） ── */
.strategy {
  border: 1rpx solid rgba(216, 255, 62, 0.25);
}
.strategy__state {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8a8c;
  margin-left: 12rpx;
}
.strategy__state--on {
  color: #d8ff3e;
}
.strategy__desc {
  font-size: 26rpx;
  color: #b9b9bc;
  line-height: 1.6;
}
.strategy__cta {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #d8ff3e;
}
.strategy__row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}
.strategy__target {
  font-size: 26rpx;
  color: #b9b9bc;
}
.strategy__time {
  font-size: 40rpx;
  font-weight: 700;
  color: #d8ff3e;
  margin-left: 8rpx;
}
.strategy__count {
  font-size: 22rpx;
  color: #b9b9bc;
  margin-left: 16rpx;
}
.strategy__updated {
  font-size: 22rpx;
  color: #8a8a8c;
}
.strategy__go {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #d8ff3e;
}
