/* ============================================================
   「我的赛事」页 —— 深色 STRIDE 主题（与 race-center 列表页一致，
   #385 定稿 C 紧凑风原型按 #392 落地的深色语言转译）。
   结构：计划卡（名+项目徽章+状态徽章 / 日期·城市 / 状态条 chips /
   未中签引导行 / 行程勾选）+ 已下架灰卡 + 空态 + 页脚说明。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部栏（同 race-center / my-races） ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

.content {
  padding: 0 24rpx 48rpx;
}

/* ---------- 提示条 / 加载（同 race-center） ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: #9c9c9d;
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 24rpx;
}

.banner--error {
  background: rgba(255, 99, 99, 0.1);
  border: 1rpx solid rgba(255, 99, 99, 0.2);
  color: #ff6363;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: #5fc992;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* ---------- 计划卡 ---------- */

.card {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 26rpx;
}

/* 已下架占位：灰卡、记录保留、不可交互 */
.card--off {
  background: #0d0e10;
  border-color: rgba(255, 255, 255, 0.03);
}

.card__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.card__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #e3e2e5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.card__name--dim {
  color: #8a8a8c;
}

.card__meta {
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #9c9c9d;
}

.card__meta--dim {
  color: #6a6a6c;
  white-space: normal;
}

/* 徽章：项目=中性；状态=四态配色（与列表页双徽章同族暖/冷/绿） */

.badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 30rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.badge--item {
  color: #b9b8bc;
  background: rgba(255, 255, 255, 0.08);
}

.badge--state--registered {
  color: #8fb8e8;
  background: rgba(143, 184, 232, 0.12);
}

.badge--state--won {
  color: #e8c07d;
  background: rgba(232, 192, 125, 0.12);
}

.badge--state--lost {
  color: #9c9c9d;
  background: rgba(156, 156, 157, 0.14);
}

.badge--state--confirmed {
  color: #5fc992;
  background: rgba(95, 201, 146, 0.12);
}

.badge--offboarded {
  color: #8a8a8c;
  background: rgba(255, 255, 255, 0.06);
}

/* ---------- 状态条：已报名→已中签→确认参赛 chips ---------- */

.steps {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #0a0b0d;
  border-radius: 18rpx;
}

.steps__chip {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  background: #17181a;
  border-radius: 24rpx;
}

.steps__chip--on {
  background: #5fc992;
  color: #07130b;
  font-weight: 600;
}

.steps__arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6a6a6c;
}

.steps__hint {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6a6a6c;
}

/* ---------- 未中签旁路：转化引导 ---------- */

.lost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #0a0b0d;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #9c9c9d;
}

.lost-row__link {
  flex-shrink: 0;
  color: #5fc992;
}

/* ---------- 行程布尔勾选 ---------- */

.trip {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trip__chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: #9c9c9d;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
}

.trip__chip--on {
  color: #5fc992;
  border-color: rgba(95, 201, 146, 0.6);
  background: rgba(95, 201, 146, 0.08);
  font-weight: 600;
}

/* ---------- 页脚说明 / 空态 ---------- */

.note {
  margin: 28rpx 8rpx 8rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  color: #6a6a6c;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty__icon {
  font-size: 88rpx;
  line-height: 120rpx;
}

.empty__title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #b9b8bc;
}

.empty__hint {
  margin: 12rpx 0 36rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #8a8a8c;
  text-align: center;
}

.empty__btn {
  padding: 18rpx 52rpx;
  font-size: 26rpx;
  color: #07130b;
  background: #5fc992;
  border-radius: 36rpx;
  font-weight: 600;
}
