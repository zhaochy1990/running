<view class="page">
  <!-- 自定义顶部栏（同 race-center 深色语言） -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">我的赛事</view>
        <view class="top-bar__subtitle">参赛计划</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;">
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <block wx:else>
      <view wx:if="{{error}}" class="banner banner--error">{{error}}</view>

      <!-- 计划卡（#385 定稿：名 + 项目徽章 + 状态徽章 + 日期·城市 + 状态条 + 行程勾选） -->
      <block wx:if="{{cards.length}}">
        <block wx:for="{{cards}}" wx:key="raceId">
          <!-- 已下架占位卡：灰卡、记录保留、不可交互 -->
          <view wx:if="{{item.offboarded}}" class="card card--off">
            <view class="card__head">
              <view class="card__name card__name--dim">{{item.name}}</view>
              <text class="badge badge--offboarded">已下架</text>
            </view>
            <view class="card__meta card__meta--dim">
              {{item.dateLabel ? item.dateLabel + ' · ' : ''}}{{item.city ? item.city + ' · ' : ''}}该赛事已被管理员下架，你的参赛记录保留
            </view>
          </view>

          <!-- 常规卡 -->
          <view wx:else class="card">
            <view class="card__head">
              <view class="card__name" data-race-id="{{item.raceId}}" bindtap="onRaceNameTap">{{item.name}}</view>
              <text class="badge badge--item">{{item.itemLabel}}</text>
              <text class="badge badge--state badge--state--{{item.stateClass}}">{{item.stateLabel}}</text>
            </view>
            <view class="card__meta">{{item.dateLabel}}{{item.city ? ' · ' + item.city : ''}}</view>

            <!-- 状态条：已报名→已中签→确认参赛 chips 点击流转 -->
            <view class="steps">
              <block wx:for="{{item.steps}}" wx:for-item="s" wx:key="state">
                <view
                  class="steps__chip {{s.on ? 'steps__chip--on' : ''}}"
                  data-race-id="{{item.raceId}}"
                  data-state="{{s.state}}"
                  bindtap="onStateTap"
                >{{s.label}}</view>
                <text wx:if="{{index < item.steps.length - 1}}" class="steps__arrow">›</text>
              </block>
              <text class="steps__hint">点状态切换</text>
            </view>

            <!-- 未中签旁路：转化引导 -->
            <view wx:if="{{item.lost}}" class="lost-row">
              <text>可惜没中签——看看同期还有哪些赛事</text>
              <text class="lost-row__link" bindtap="onGoListTap">去找替代 ›</text>
            </view>

            <!-- 行程布尔勾选 -->
            <view class="trip">
              <view
                class="trip__chip {{item.hotel ? 'trip__chip--on' : ''}}"
                data-race-id="{{item.raceId}}"
                data-field="hotel"
                bindtap="onTripTap"
              >🏨 酒店 · {{item.hotel ? '已订' : '未订'}}</view>
              <view
                class="trip__chip {{item.transit ? 'trip__chip--on' : ''}}"
                data-race-id="{{item.raceId}}"
                data-field="transit"
                bindtap="onTripTap"
              >🚄 火车票·机票 · {{item.transit ? '已订' : '未订'}}</view>
            </view>
          </view>
        </block>

        <!-- 页脚说明：收藏 ≠ 参赛计划 -->
        <view class="note">收藏 ≠ 参赛计划：收藏但未报名的赛事不会出现在本页，可在赛事中心列表的「收藏」视图查看。</view>
      </block>

      <!-- 空态 -->
      <view wx:elif="{{!error}}" class="empty">
        <view class="empty__icon">🗓</view>
        <view class="empty__title">还没有参赛计划</view>
        <view class="empty__hint">去赛事中心收藏心仪赛事，报名后在这里追踪进度</view>
        <view class="empty__btn" bindtap="onGoListTap">去赛事中心逛逛</view>
      </view>
    </block>
  </view>
</view>
