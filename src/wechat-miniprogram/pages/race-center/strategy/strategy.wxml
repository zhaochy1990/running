<view class="page">
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">比赛策略</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content" style="padding-top: calc({{statusBarHeight}}px + 128rpx);">
    <view wx:if="{{loading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <block wx:elif="{{error}}">
      <view class="banner banner--error">{{error}}</view>
      <view class="card" bindtap="onBack">
        <view class="card__empty">回到赛事详情</view>
      </view>
    </block>

    <block wx:elif="{{view}}">
      <!-- hero：赛事名 + 目标成绩 + 主按钮（教练再聊）+ 次要（分享/配速卡） -->
      <view class="card hero">
        <view class="hero__sub">
          <text wx:if="{{draft}}" class="hero__draft-badge">初稿</text>
          <text>{{raceDayText}} · {{view.itemTypeLabel}}</text>
        </view>
        <view class="hero__name">{{view.raceName}}</view>
        <view class="hero__target">
          <view class="hero__stat">
            <text class="hero__stat-label">目标成绩</text>
            <text class="hero__time">{{view.targetTime}}</text>
          </view>
          <view wx:if="{{view.targetPace}}" class="hero__stat">
            <text class="hero__stat-label">目标配速</text>
            <text class="hero__time hero__time--pace">{{view.targetPace}}</text>
          </view>
        </view>
        <view class="hero__summary">{{view.summary}}</view>
        <view class="hero__actions">
          <button class="hero__btn hero__btn--lead" bindtap="onCoachTap">和教练聊一聊比赛策略</button>
          <button class="hero__btn hero__btn--minor" open-type="share">分享</button>
          <button class="hero__btn hero__btn--minor" bindtap="onPosterTap">配速卡</button>
        </view>
      </view>

      <!-- 版本切换：同一场比赛按目标多版本（2:50 / 2:55…），点击切换；草稿态不显示 -->
      <view wx:if="{{!draft && versions.length > 0}}" class="versions">
        <view
          class="versions__pill {{item.active ? 'versions__pill--on' : ''}}"
          wx:for="{{versions}}"
          wx:for-item="item"
          wx:key="target"
          data-target="{{item.target}}"
          bindtap="onVersionTap"
        >{{item.target || '—'}}</view>
      </view>

      <!-- 分段配速：五列表格，pace/说明可编辑；用时=距离×配速自动算 -->
      <view class="card">
        <view class="card__title">分段配速<text class="card__hint">配速/说明可编辑，用时自动换算</text></view>
        <view class="pace pace--head">
          <view class="pace__seg">分段</view>
          <view class="pace__pace">配速</view>
          <view class="pace__time">本段</view>
          <view class="pace__time">累计</view>
        </view>
        <!-- 行结构：距离短标签 + 配速/用时（一行）；分段描述与说明为长文，
             各占整行小字（textarea 自适应高度，可编辑换行，不再截断） -->
        <view class="pace-row" wx:for="{{view.paceRows}}" wx:for-item="row" wx:key="index">
          <view class="pace">
            <view class="pace__seg">
              <view class="pace__seg-dist">{{row.distance}}</view>
              <view wx:if="{{row.desc}}" class="pace__seg-desc">{{row.desc}}</view>
            </view>
            <input
              class="pace__cell pace__cell--edit pace__pace"
              value="{{row.pace}}"
              data-index="{{index}}"
              bindblur="onPaceBlur"
            />
            <view class="pace__time">{{row.segmentTime}}</view>
            <view class="pace__time">{{row.cumulativeTime}}</view>
          </view>
          <textarea
            class="pace__cell--edit pace__note"
            auto-height
            value="{{row.note}}"
            placeholder="说明（稳住/进站/顶坡…）"
            data-index="{{index}}"
            bindblur="onNoteBlur"
          />
        </view>
      </view>

      <!-- 补给计划：逐行可编辑 + 增删。行结构同分段配速表：时间点为行首
           短值（可编辑），内容是长文整行 textarea 自适应换行，不再截断 -->
      <view class="card">
        <view class="card__title">补给计划<text class="card__hint">时间点｜内容，可增删</text></view>
        <view class="fuel-row" wx:for="{{view.fuelingRows}}" wx:for-item="row" wx:key="index">
          <view class="fuel">
            <input
              class="fuel__when pace__cell--edit"
              value="{{row.timePoint}}"
              placeholder="时间点"
              data-index="{{index}}"
              bindblur="onFuelingWhenBlur"
            />
            <view class="fuel__del" data-index="{{index}}" bindtap="onFuelingRemove">✕</view>
          </view>
          <textarea
            class="fuel__what pace__cell--edit"
            auto-height
            value="{{row.content}}"
            placeholder="内容（能量胶 / 水 / 电解质…）"
            data-index="{{index}}"
            bindblur="onFuelingWhatBlur"
          />
        </view>
        <view class="fuel__add" bindtap="onFuelingAdd">+ 添加一条补给</view>
      </view>

      <!-- 提示：赛道（来自调研内容）+ 天气 -->
      <view class="card">
        <view class="card__title">赛道提示</view>
        <view class="tip" wx:for="{{view.courseTips}}" wx:key="*this">· {{item}}</view>
        <view wx:if="{{!view.courseTips.length}}" class="card__empty">待补</view>
      </view>
      <view class="card">
        <view class="card__title">天气提示</view>
        <view class="tip tip--pre">{{view.weatherTips}}</view>
      </view>
      <view class="card" wx:if="{{view.basisNote}}">
        <view class="card__title">依据</view>
        <view class="tip">{{view.basisNote}}</view>
      </view>

      <!-- 草稿模式：应用并保存（PUT 落库，转已保存态）；不应用离开=放弃初稿 -->
      <view wx:if="{{draft}}" class="actions actions--draft">
        <view class="actions__apply {{applying ? 'actions__apply--busy' : ''}}" bindtap="onApplyTap">{{applying ? '应用中…' : '应用并保存'}}</view>
        <view class="actions__draft-hint">应用前不会保存；离开即放弃这份初稿</view>
      </view>
      <!-- 已保存：保存 + 删除此版本 -->
      <view wx:else class="actions">
        <view class="actions__save {{dirty ? 'actions__save--on' : ''}}" bindtap="onSaveTap">{{saving ? '保存中…' : (dirty ? '保存修改' : '已保存 · ' + updatedAtText)}}</view>
        <view class="actions__delete" bindtap="onDeleteTap">{{deleting ? '删除中…' : '删除此版本'}}</view>
      </view>
    </block>
  </view>

  <!-- 配速卡 canvas（离屏绘制后经 previewImage 长按保存） -->
  <canvas type="2d" id="poster" class="poster-canvas"></canvas>
</view>
