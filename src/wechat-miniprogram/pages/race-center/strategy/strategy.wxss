/* 比赛策略报告页 —— 沿用赛事中心深色视觉语言（#385/#392）。 */
.page {
  min-height: 100vh;
  background: #070708;
  color: #f2f2f3;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: rgba(7, 7, 8, 0.92);
  backdrop-filter: blur(12px);
}
.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.top-bar__btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top-bar__icon--back {
  width: 40rpx;
  height: 40rpx;
  transform: rotate(180deg);
}
.top-bar__title-wrap {
  flex: 1;
  text-align: center;
}
.top-bar__title {
  font-size: 32rpx;
  font-weight: 600;
}
.top-bar__btn--spacer {
  width: 72rpx;
}

.content {
  padding: 24rpx;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 0;
}
.state-card__text {
  font-size: 26rpx;
  color: #8a8a8c;
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.15);
  border-top-color: #d8ff3e;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.banner--error {
  background: rgba(255, 92, 92, 0.12);
  border: 1rpx solid rgba(255, 92, 92, 0.3);
  color: #ff9d9d;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.card {
  background: #101111;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.card__hint {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8a8c;
  margin-left: 12rpx;
}
.card__empty {
  font-size: 26rpx;
  color: #8a8a8c;
}

/* hero */
.hero__sub {
  font-size: 24rpx;
  color: #8a8a8c;
}
.hero__name {
  font-size: 40rpx;
  font-weight: 700;
  margin: 8rpx 0 16rpx;
}
.hero__target {
  font-size: 26rpx;
  color: #b9b9bc;
}
.hero__time {
  font-size: 44rpx;
  font-weight: 700;
  color: #d8ff3e;
  margin-left: 8rpx;
}
.hero__summary {
  font-size: 26rpx;
  color: #b9b9bc;
  margin-top: 16rpx;
  line-height: 1.6;
}
.hero__actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.hero__btn {
  margin: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  padding: 0;
}
.hero__btn--lead {
  background: #d8ff3e;
  color: #101111;
  font-weight: 600;
}
.hero__btn--minor {
  background: rgba(255, 255, 255, 0.08);
  color: #f2f2f3;
  flex: 1;
}
.hero__row {
  display: flex;
  gap: 16rpx;
}

/* 分段配速表 */
.pace {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.pace--head {
  font-size: 22rpx;
  color: #8a8a8c;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.12);
}
.pace__seg {
  flex: 1.4;
  font-size: 24rpx;
}
.pace__pace {
  flex: 1;
}
.pace__time {
  flex: 0.9;
  font-size: 24rpx;
  color: #b9b9bc;
}
.pace__note {
  flex: 1.6;
  font-size: 24rpx;
  color: #8a8a8c;
}
.pace__cell--edit {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #f2f2f3;
  min-height: 40rpx;
}

/* 补给 */
.fuel {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.fuel__when {
  flex: 1;
}
.fuel__what {
  flex: 2;
}
.fuel__del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8a8a8c;
  font-size: 26rpx;
}
.fuel__add {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #d8ff3e;
  padding: 8rpx 0;
}

.tip {
  font-size: 26rpx;
  color: #b9b9bc;
  line-height: 1.7;
  margin-bottom: 6rpx;
}
.tip--pre {
  white-space: pre-line;
}

.actions {
  margin: 8rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.actions__save {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: rgba(255, 255, 255, 0.08);
  color: #8a8a8c;
}
.actions__save--on {
  background: #d8ff3e;
  color: #101111;
  font-weight: 600;
}
.actions__goal {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: rgba(216, 255, 62, 0.12);
  color: #d8ff3e;
}

/* 配速卡 canvas：离屏（页面内不可见位置）绘制 */
.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 600px;
  height: 900px;
}

/* 「设为目标」弹层（沿用详情页 sheet 词汇） */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.6);
  z-index: 30;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 31;
  background: #151516;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}
.sheet__hint {
  font-size: 24rpx;
  color: #8a8a8c;
  line-height: 1.6;
  margin-bottom: 20rpx;
}
.sheet__days {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-top: 1rpx solid rgba(255, 255, 255, 0.08);
}
.sheet__days-label {
  font-size: 28rpx;
}
.sheet__days-value {
  font-size: 28rpx;
  color: #d8ff3e;
}
.sheet__confirm {
  margin-top: 24rpx;
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: #d8ff3e;
  color: #101111;
  font-weight: 600;
}
.sheet__cancel {
  margin-top: 16rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8c;
  padding: 12rpx 0;
}

.kv {
  display: flex;
  gap: 16rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.kv__k {
  flex: 0 0 150rpx;
  font-size: 24rpx;
  color: #8a8a8c;
}
.kv__v {
  flex: 1;
  font-size: 24rpx;
  color: #f2f2f3;
}

/* 草稿模式（教练聊天卡片交接的初稿，未落库）：hero 角标 + 应用栏（.actions 的 flex-column/gap 直接沿用） */
.hero__draft-badge {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #d8ff3e;
  background: rgba(216, 255, 62, 0.12);
  border-radius: 8rpx;
  vertical-align: middle;
}
.actions__apply {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #d8ff3e;
  color: #101111;
}
.actions__apply--busy {
  opacity: 0.6;
}
.actions__draft-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8a8a8c;
}
