/* 比赛策略报告页 —— 沿用赛事中心深色视觉语言（#385/#392）。 */
.page {
  min-height: 100vh;
  background: var(--color-bg);
  color: #f2f2f3;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 20;
  background: rgba(7, 7, 8, 0.92);
  backdrop-filter: blur(12px);
}
.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}
.top-bar__btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.top-bar__icon--back {
  width: 40rpx;
  height: 40rpx;
  transform: rotate(180deg);
}
.top-bar__title-wrap {
  flex: 1;
  text-align: center;
}
.top-bar__title {
  font-size: 32rpx;
  font-weight: 600;
}
.top-bar__btn--spacer {
  width: 72rpx;
}

.content {
  padding: 24rpx;
}

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 120rpx 0;
}
.state-card__text {
  font-size: 26rpx;
  color: var(--color-text-muted);
}
.spinner {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(var(--color-overlay-rgb), 0.15);
  border-top-color: #d8ff3e;
  animation: spin 0.9s linear infinite;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.banner--error {
  background: rgba(255, 92, 92, 0.12);
  border: 1rpx solid rgba(255, 92, 92, 0.3);
  color: #ff9d9d;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
  margin-bottom: 24rpx;
}

.card {
  background: var(--color-card);
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}
.card__title {
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}
.card__hint {
  font-size: 22rpx;
  font-weight: 400;
  color: var(--color-text-muted);
  margin-left: 12rpx;
}
.card__empty {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

/* hero */
.hero__sub {
  font-size: 24rpx;
  color: var(--color-text-muted);
}
.hero__name {
  font-size: 40rpx;
  font-weight: 700;
  margin: 8rpx 0 16rpx;
}
.hero__target {
  display: flex;
  flex-direction: row;
  align-items: baseline;
  gap: 40rpx;
}
.hero__stat {
  display: flex;
  flex-direction: row;
  align-items: baseline;
}
.hero__stat-label {
  font-size: 26rpx;
  color: var(--color-text-bright);
}
.hero__time {
  font-size: 44rpx;
  font-weight: 700;
  color: #d8ff3e;
  margin-left: 8rpx;
}
.hero__time--pace {
  color: #f2f2f3;
}
.hero__summary {
  font-size: 26rpx;
  color: var(--color-text-bright);
  margin-top: 16rpx;
  line-height: 1.6;
}
/* 一行三按钮：主按钮占双列，次级平分剩余 */
.hero__actions {
  margin-top: 28rpx;
  display: flex;
  flex-direction: row;
  gap: 16rpx;
}
.hero__btn {
  margin: 0;
  padding: 0;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 84rpx;
  white-space: nowrap;
}
/* 原生 button 的 ::after 默认描边会在深色卡上露出灰边，必须抹掉才是主题的扁平按钮 */
.hero__btn::after {
  border: none;
}
.hero__btn--lead {
  flex: 2;
  background: var(--color-accent);
  color: var(--color-card);
  font-weight: 600;
}
.hero__btn--minor {
  flex: 1;
  background: rgba(var(--color-overlay-rgb), 0.08);
  color: #f2f2f3;
}

/* 分段配速表 */
/* 行容器：一行数值 + 分段描述/说明整行（长文不再挤压列宽） */
.pace-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border-soft);
}
.pace {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.pace--head {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-muted);
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.12);
}
/* flex-basis 0 + min-width 0：列按比例分宽，长内容换行而不是把行撑出屏 */
.pace__seg {
  flex: 1.5 1 0;
  min-width: 0;
}
.pace__seg-dist {
  font-size: 26rpx;
  font-weight: 600;
  color: #f2f2f3;
}
.pace__seg-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-text-muted);
}
.pace__pace {
  flex: 1 1 0;
  min-width: 0;
}
.pace__time {
  flex: 0.9 1 0;
  min-width: 0;
  font-size: 24rpx;
  color: var(--color-text-bright);
}
/* 说明：整行 textarea（auto-height 自动换行），不再是第五列 */
.pace__note {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-text-bright);
}
.pace__cell--edit {
  background: rgba(var(--color-overlay-rgb), 0.05);
  border-radius: 8rpx;
  padding: 8rpx 12rpx;
  font-size: 24rpx;
  color: #f2f2f3;
  min-height: 40rpx;
}

/* 补给 */
/* 补给计划（行结构同分段配速表）：时间点行首短值，内容整行换行不截断 */
.fuel-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border-soft);
}
.fuel {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.fuel__when {
  flex: 1 1 0;
  min-width: 0;
  font-weight: 600;
}
.fuel__what {
  width: 100%;
  box-sizing: border-box;
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-text-bright);
}
.fuel__del {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-muted);
  font-size: 26rpx;
}
.fuel__add {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #d8ff3e;
  padding: 8rpx 0;
}

/* 固定口径的水站提示（教练补给行不再写补水） */
.fuel__water-tip {
  margin-bottom: 16rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-muted);
}

/* 补给打包清单：品类 ×数量 一行，用法小字跟随 */
.check-row {
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--color-border-soft);
}
.check-row:last-child {
  border-bottom: none;
}
.check {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 12rpx;
}
.check__item {
  font-size: 26rpx;
  color: #f2f2f3;
}
.check__count {
  font-size: 28rpx;
  font-weight: 600;
  color: #d8ff3e;
}
.check__note {
  margin-top: 6rpx;
  font-size: 22rpx;
  line-height: 30rpx;
  color: var(--color-text-muted);
}

.tip {
  font-size: 26rpx;
  color: var(--color-text-bright);
  line-height: 1.7;
  margin-bottom: 6rpx;
}
.tip--pre {
  white-space: pre-line;
}

.actions {
  margin: 8rpx 0 48rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.actions__save {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: rgba(var(--color-overlay-rgb), 0.08);
  color: var(--color-text-muted);
}
.actions__save--on {
  background: #d8ff3e;
  color: var(--color-card);
  font-weight: 600;
}
.actions__delete {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  background: rgba(255, 92, 92, 0.1);
  color: #ff5c5c;
}

/* 版本切换 pills：目标成绩键控的多版本（点击切换，active 高亮） */
.versions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 0 32rpx;
  margin-top: 20rpx;
}
.versions__pill {
  padding: 10rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  background: rgba(var(--color-overlay-rgb), 0.06);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.14);
  color: var(--color-text-bright);
}
.versions__pill--on {
  background: rgba(216, 255, 62, 0.14);
  border-color: #d8ff3e;
  color: #d8ff3e;
}

/* 配速卡 canvas：离屏（页面内不可见位置）绘制 */
.poster-canvas {
  position: fixed;
  left: -2000rpx;
  top: 0;
  width: 600px;
  height: 900px;
}

/* 草稿模式（教练聊天卡片交接的初稿，未落库）：hero 角标 + 应用栏（.actions 的 flex-column/gap 直接沿用） */
.hero__draft-badge {
  display: inline-block;
  margin-right: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
  color: #d8ff3e;
  background: rgba(216, 255, 62, 0.12);
  border-radius: 8rpx;
  vertical-align: middle;
}
.actions__apply {
  text-align: center;
  border-radius: 12rpx;
  line-height: 84rpx;
  font-size: 28rpx;
  font-weight: 600;
  background: #d8ff3e;
  color: var(--color-card);
}
.actions__apply--busy {
  opacity: 0.6;
}
.actions__draft-hint {
  margin-top: 12rpx;
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-muted);
}
