/* ============================================================
   手表管理页 —— 深色 STRIDE 主题（与 profile / activity-detail 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

.content {
  padding: 0 40rpx 48rpx;
}

/* ---------- 卡片 ---------- */

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.card--danger {
  border-color: rgba(var(--color-accent-rgb), 0.3);
  background: rgba(var(--color-accent-rgb), 0.05);
}

.card__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--color-text-secondary);
  border-bottom: 1rpx solid var(--color-border-soft);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

.card__label--danger {
  color: var(--color-accent);
}

/* ---------- 提示条 ---------- */

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(var(--color-accent-rgb), 0.1);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.2);
  color: var(--color-accent);
}

.banner--success {
  background: rgba(var(--color-success-rgb), 0.1);
  border: 1rpx solid rgba(var(--color-success-rgb), 0.3);
  color: var(--color-success);
}

/* ---------- 当前绑定 ---------- */

.watch-brand {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
}

.watch-brand__icon-wrap {
  width: 96rpx;
  height: 96rpx;
  border-radius: 20rpx;
  background: rgba(var(--color-success-rgb), 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.watch-brand__icon {
  width: 48rpx;
  height: 48rpx;
}

.watch-brand__meta {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.watch-brand__name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.watch-brand__email {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.watch-status {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: var(--color-success);
  flex-shrink: 0;
}

.watch-status__dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--color-success);
}

.watch-meta-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0 0;
  font-size: 24rpx;
}

.watch-meta-row__label {
  color: var(--color-text-secondary);
}

.watch-meta-row__value {
  color: var(--color-text-primary);
}

.watch-caps {
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  margin-top: 16rpx;
}

.watch-caps__label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.watch-caps__list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

.watch-caps__tag {
  font-size: 18rpx;
  padding: 8rpx 14rpx;
  border-radius: 8rpx;
  background: var(--color-bg);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  color: var(--color-text-secondary);
}

/* ---------- 未绑定空态 ---------- */

.watch-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 32rpx;
  gap: 8rpx;
}

.watch-empty__icon {
  font-size: 72rpx;
  opacity: 0.3;
}

.watch-empty__title {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.watch-empty__sub {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 绑定：provider 选择 ---------- */

.provider-grid {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.provider-btn {
  flex: 1;
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 20rpx;
  padding: 32rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.provider-btn:active {
  border-color: rgba(var(--color-success-rgb), 0.5);
  background: rgba(var(--color-success-rgb), 0.05);
}

.provider-btn__name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.provider-btn__sub {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* ---------- 绑定表单 ---------- */

.bind-form__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.bind-form__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.bind-form__switch {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.bind-form__switch:active {
  color: var(--color-text-primary);
}

.field {
  margin-bottom: 24rpx;
}

.field__input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 16rpx;
  background: var(--color-bg);
  color: var(--color-text-primary);
  font-size: 26rpx;
}

.field__input--picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.field__chevron {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.field__placeholder {
  color: var(--color-text-tertiary);
}

/* ---------- 按钮 ---------- */

.btn {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0;
  margin: 0;
  border-radius: 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.btn::after {
  border: none;
}

.btn--full {
  width: 100%;
}

.btn--primary {
  background: var(--color-success);
  color: var(--color-bg);
}

.btn--primary[disabled] {
  background: rgba(var(--color-success-rgb), 0.4);
  color: rgba(7, 8, 10, 0.5);
}

.btn--danger {
  background: var(--color-accent);
  color: var(--color-on-accent);
}

.btn--danger[disabled] {
  background: rgba(var(--color-accent-rgb), 0.4);
}

.btn--outline-danger {
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.4);
  background: rgba(var(--color-accent-rgb), 0.08);
  color: var(--color-accent);
}

.btn--ghost {
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  background: var(--color-card);
  color: var(--color-text-secondary);
}

.disconnect-desc {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  line-height: 34rpx;
  margin-bottom: 24rpx;
}

.disconnect-confirm {
  display: flex;
  gap: 24rpx;
}

.disconnect-confirm .btn {
  flex: 1;
}

/* ---------- 加载态 ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(var(--color-success-rgb), 0.3);
  border-top-color: var(--color-success);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
