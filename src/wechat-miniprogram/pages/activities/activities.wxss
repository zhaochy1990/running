/* ============================================================
   活动页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

.content {
  padding: 0 40rpx calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: #e3e2e5;
  margin-bottom: 24rpx;
}

/* ---------- 月概览 ---------- */

.summary-card {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.summary-card__label {
  font-size: 24rpx;
  color: #9c9c9d;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.summary-card__stats {
  display: flex;
  gap: 16rpx;
}

.summary-stat {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.summary-stat__value {
  font-size: 40rpx;
  font-weight: 700;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
}

.summary-stat__label {
  font-size: 22rpx;
  color: #9c9c9d;
  margin-top: 4rpx;
}

/* ---------- 活动列表 ---------- */

.activity-list {
  padding: 8rpx 0;
}

.activity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.activity:last-child {
  border-bottom: none;
}

.activity__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.activity__icon-img {
  width: 40rpx;
  height: 40rpx;
}

.activity__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.activity__name {
  font-size: 30rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.activity__date {
  font-size: 22rpx;
  color: #9c9c9d;
  margin-top: 2rpx;
}

.activity__meta {
  font-size: 24rpx;
  color: #9c9c9d;
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.activity__right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.activity__load {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffb3af;
  font-variant-numeric: tabular-nums;
}

.activity__load-label {
  font-size: 20rpx;
  color: #9c9c9d;
  margin-top: 2rpx;
}

/* ---------- 空态 ---------- */

.empty-card {
  padding: 64rpx 32rpx;
  border: 1rpx dashed rgba(255, 255, 255, 0.12);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 48rpx;
}

.empty-card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.empty-card__sub {
  font-size: 24rpx;
  color: #9c9c9d;
}

/* ---------- 刷新按钮 ---------- */

.load-more {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.03);
  color: #e3e2e5;
  font-size: 28rpx;
  text-align: center;
}

.load-more::after {
  border: none;
}
