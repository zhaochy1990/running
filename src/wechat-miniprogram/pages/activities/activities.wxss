/* ============================================================
   活动页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

.content {
  padding: 0 40rpx calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

/* ---------- 按月分组（合并「本月概览 + 活动列表」） ---------- */

/* 活动列表不套卡片边框，直接铺满内容区（避免卡片距屏幕边缘的额外留白） */
.month-list {
  background: transparent;
  border: none;
  border-radius: 0;
  padding: 0;
}

.month-group {
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
}

.month-group:last-child {
  border-bottom: none;
}

.month-group__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 12rpx 0 24rpx;
}

.month-group__title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.month-group__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.month-group__summary {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.month-group__chevron {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
  flex-shrink: 0;
  transition: transform 0.2s ease;
}

.month-group__chevron.is-expanded {
  transform: rotate(90deg);
}

.month-group__empty {
  color: var(--color-text-secondary);
  font-size: 20rpx;
  padding: 8rpx 0 24rpx;
}

/* ---------- 活动列表 ---------- */

.activity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.activity:last-child {
  border-bottom: none;
}

.activity__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  /* 圆槽要真正裁掉缩略图的方角；border-radius 本身不裁剪子元素 */
  overflow: hidden;
}

.activity__icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* 路线缩略图铺满圆槽。PNG 背景透明，且渲染端已把折线收进内切圆，
   所以圆角裁剪只会切掉空白角，不会切到路线本身 */
.activity__thumb {
  width: 72rpx;
  height: 72rpx;
}

.activity__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.activity__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.activity__date {
  font-size: 19rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

.activity__meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.activity__right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.activity__load {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-accent-pale);
  font-variant-numeric: tabular-nums;
}

.activity__load-label {
  font-size: 17rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

/* ---------- 加载更早记录 ---------- */

.load-more {
  height: 88rpx;
  line-height: 88rpx;
  margin: 0 0 8rpx;
  padding: 0;
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.1);
  border-radius: 20rpx;
  background: rgba(var(--color-overlay-rgb), 0.03);
  color: var(--color-text-primary);
  font-size: 24rpx;
  text-align: center;
}

.load-more:active {
  opacity: 0.6;
}

/* ---------- 空态 ---------- */

.empty-card {
  padding: 64rpx 32rpx;
  border: 1rpx dashed rgba(var(--color-overlay-rgb), 0.12);
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 48rpx;
}

.empty-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-card__sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}


