/* ============================================================
   计划页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ---------- 自定义顶部栏 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

/* ---------- 内容 ---------- */

.content {
  padding: 0 40rpx calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 27rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

/* ---------- 本周概览 ---------- */

.week-hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.week-hero__label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.week-hero__title {
  font-size: 37rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.week-hero__range {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

/* ---------- 计划列表 ---------- */

.plan-list {
  padding: 8rpx 0;
}

.plan-day {
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.plan-day:last-child {
  border-bottom: none;
}

.plan-day__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.plan-day__weekday {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.plan-day__num {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  font-variant-numeric: tabular-nums;
}

.plan-day__num--today {
  color: var(--color-card);
  background: var(--color-accent);
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  font-weight: 700;
}

.plan-day__today-tag {
  font-size: 17rpx;
  color: var(--color-accent);
  margin-left: 4rpx;
}

.plan-day__body {
  padding-left: 0;
}

.plan-day__sessions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.plan-session {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 12rpx 16rpx;
  background: rgba(var(--color-overlay-rgb), 0.03);
  border-radius: 12rpx;
}

.plan-session__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.plan-session__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.plan-session__title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.plan-session__meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
  font-variant-numeric: tabular-nums;
}

.plan-session__push {
  flex-shrink: 0;
  font-size: 19rpx;
  font-weight: 600;
  color: #00e676;
  background: rgba(0, 230, 118, 0.1);
  border: 1rpx solid rgba(0, 230, 118, 0.3);
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin-left: 12rpx;
  transition: opacity 0.15s ease;
}

.plan-session__push:active {
  opacity: 0.7;
}

.plan-session__push--done {
  background: rgba(0, 230, 118, 0.2);
  border-color: rgba(0, 230, 118, 0.5);
}

.plan-day__rest {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  padding: 12rpx 16rpx;
}
