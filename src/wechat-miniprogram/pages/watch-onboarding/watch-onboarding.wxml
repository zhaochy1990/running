<!-- 手表绑定引导 + 小程序侧 onboarding 进度 —— 深色 STRIDE 主题（与登录页一致） -->
<view class="ob-page">
  <!-- 加载中：只放转圈，不放文案，避免已绑表用户闪一下"绑表"引导 -->
  <block wx:if="{{phase === 'loading'}}">
    <view class="ob-hero">
      <view class="ob-spinner"></view>
    </view>
  </block>

  <!-- 全部完成 -->
  <block wx:elif="{{phase === 'done'}}">
    <view class="ob-hero">
      <view class="ob-success-badge">✓</view>
      <view class="ob-title">准备就绪</view>
      <view class="ob-subtitle">训练数据已同步，训练负荷、能力基线都算好了</view>
    </view>
    <button class="ob-cta" bindtap="goHome">进入首页</button>
  </block>

  <!-- 部署开关关闭：不承诺自动同步 -->
  <block wx:elif="{{phase === 'disabled'}}">
    <view class="ob-hero">
      <view class="ob-success-badge">✓</view>
      <view class="ob-title">手表已连接</view>
      <view class="ob-subtitle">数据同步当前暂未开放，开放后会自动同步</view>
    </view>
    <button class="ob-cta" bindtap="goHome">进入首页</button>
  </block>

  <!-- 同步中 -->
  <block wx:elif="{{phase === 'syncing'}}">
    <view class="ob-hero">
      <view class="ob-spinner"></view>
      <view class="ob-title">正在准备你的训练数据</view>
      <view class="ob-subtitle">首次同步会拉取历史训练并计算能力基线，通常需要十几分钟</view>
    </view>
    <view class="ob-card ob-progress">
      <view class="ob-progress__text">{{stepText}}</view>
      <view class="ob-progress__bar">
        <view class="ob-progress__fill" style="width: {{percent}}%"></view>
      </view>
      <view class="ob-progress__hint">可以先退出，下次进来会接着同步</view>
    </view>
    <view class="ob-skip" bindtap="goHome">稍后再说，先逛逛</view>
  </block>

  <!-- 轮询到达上限但 run 还在跑（不是失败） -->
  <block wx:elif="{{phase === 'pending'}}">
    <view class="ob-hero">
      <view class="ob-title">还在同步中</view>
      <view class="ob-subtitle">数据量大时会久一些，下次进来会自动接着同步</view>
    </view>
    <button class="ob-cta" bindtap="goHome">先进入首页</button>
  </block>

  <!-- 数据已同步，但还差资料 -->
  <block wx:elif="{{phase === 'needsProfile'}}">
    <view class="ob-hero">
      <view class="ob-success-badge">✓</view>
      <view class="ob-title">数据已同步</view>
      <view class="ob-subtitle">再补一下身体数据，训练负荷和能力基线才算得准</view>
    </view>
    <button class="ob-cta" bindtap="onFillProfile">完善资料</button>
    <view class="ob-skip" bindtap="goHome">稍后再说，先逛逛</view>
  </block>

  <!-- 失败：给出原因和重试入口（生产上 onboarding 有约两成会失败） -->
  <block wx:elif="{{phase === 'failed'}}">
    <view class="ob-hero">
      <view class="ob-title">同步没有成功</view>
      <view class="ob-subtitle">{{errorMsg}}</view>
    </view>
    <button class="ob-cta" bindtap="onRetry">重试</button>
    <view class="ob-skip" bindtap="goHome">稍后再说，先逛逛</view>
  </block>

  <!-- 未绑表：价值说明 + 品牌入口 -->
  <block wx:else>
    <view class="ob-hero">
      <view class="ob-title">连接你的运动手表</view>
      <view class="ob-subtitle">训练数据自动同步，训练量与疲劳趋势无需手动记录</view>
    </view>

    <view class="ob-card">
      <view
        class="ob-provider"
        data-provider="coros"
        bindtap="onProviderTap"
      >
        <view class="ob-provider-info">
          <view class="ob-provider-name">COROS 高驰</view>
          <view class="ob-provider-desc">同步训练与心率数据</view>
        </view>
        <view class="ob-provider-arrow">›</view>
      </view>
      <view class="ob-provider ob-provider-last" data-provider="garmin" bindtap="onProviderTap">
        <view class="ob-provider-info">
          <view class="ob-provider-name">Garmin 佳明</view>
          <view class="ob-provider-desc">同步训练与生理数据</view>
        </view>
        <view class="ob-provider-arrow">›</view>
      </view>
    </view>

    <view class="ob-skip" bindtap="goHome">稍后再说，先逛逛</view>
  </block>
</view>
