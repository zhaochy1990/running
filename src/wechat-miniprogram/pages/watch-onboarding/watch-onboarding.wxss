/* ============================================================
   手表绑定引导页 —— 深色 STRIDE 主题（配色与登录页一致）
   背景 #07080A、卡片 #141517、主色 #FF6363
   ============================================================ */

.ob-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 96rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- Hero ---------- */

.ob-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  margin-bottom: 64rpx;
}

.ob-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: 2rpx;
}

.ob-subtitle {
  margin-top: 20rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: #8a8b8c;
  max-width: 560rpx;
}

.ob-success-badge {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: rgba(255, 99, 99, 0.12);
  color: #ff6363;
  font-size: 64rpx;
  line-height: 120rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

/* ---------- 品牌入口卡片 ---------- */

.ob-card {
  background: #141517;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 48rpx;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.35);
  overflow: hidden;
}

.ob-provider {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.ob-provider-last {
  border-bottom: none;
}

.ob-provider:active {
  background: rgba(255, 99, 99, 0.06);
}

.ob-provider-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}

.ob-provider-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #a0a0a0;
}

.ob-provider-arrow {
  font-size: 44rpx;
  color: #6a6b6c;
  line-height: 1;
}

/* ---------- 跳过 / 主按钮 ---------- */

.ob-skip {
  margin-top: 56rpx;
  text-align: center;
  font-size: 28rpx;
  color: #8a8b8c;
  padding: 16rpx;
}

.ob-skip:active {
  opacity: 0.7;
}

.ob-cta {
  margin-top: 32rpx;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 26rpx;
  background: #ff6363;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 10rpx 24rpx rgba(255, 99, 99, 0.18);
}

.ob-cta::after {
  border: none;
}
