/* 训练课表免登录分享落地页 —— 样式整包复用 workout-detail（类名一致，
   与详情页所见即所得 #691），这里只补页面差异。
   devops#818 P3：浅色令牌收敛（原排期 chip 蓝=计划语义 → --color-info；
   已保存徽章态文字浅粉 → accent-deep 提对比）。 */
@import "../workout-detail/workout-detail.wxss";

/* 原排期 chip（hero__chip 语义色：蓝 = 计划语义，同恢复色系） */
.hero__chip--date {
  color: var(--color-info);
  background: rgba(var(--color-info-rgb), 0.12);
  border: 1rpx solid rgba(var(--color-info-rgb), 0.3);
}

/* summary 左边线引用（V1 沉浸课卡定稿 #694） */
.share-summary {
  font-size: 23rpx;
  line-height: 36rpx;
  color: rgba(var(--color-header-meta-rgb), 0.85);
  margin-top: 24rpx;
  border-left: 6rpx solid rgba(var(--color-accent-rgb), 0.5);
  padding-left: 20rpx;
}

/* 给固定 CTA 栏留出高度（基础 content 已有 120rpx + safe-area 兜底） */
.content--cta {
  padding-bottom: calc(240rpx + env(safe-area-inset-bottom));
}

/* ---------- 并排双 CTA 栏 ---------- */

.cta-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 60;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 40rpx calc(20rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  border-top: 1rpx solid var(--color-border-soft);
}

.cta-bar__btn {
  flex: 1;
  text-align: center;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
}

.cta-bar__btn--primary {
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
}

.cta-bar__btn--secondary {
  background: rgba(var(--color-overlay-rgb), 0.08);
  color: var(--color-text-primary);
}

/* 已保存徽章态（仍可点，处理函数幂等空操作） */
.cta-bar__btn--done {
  background: rgba(var(--color-accent-rgb), 0.15);
  color: var(--color-accent-deep);
  font-weight: 600;
}
