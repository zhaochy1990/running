<view class="page">
  <!-- 粉渐变顶栏 -->
  <view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image wx:if="{{canBack}}" class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right_white.svg" mode="aspectFit" />
        <image wx:else class="top-bar__icon" src="/assets/icons/home_white.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">{{editing ? '编辑地址' : '新增地址'}}</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{loading}}" class="page-loading">加载中…</view>

    <view wx:elif="{{loadFailed}}" class="card load-failed">
      <view class="load-failed__txt">地址加载失败，请检查网络后重试</view>
      <button class="load-failed__btn" hover-class="none" bindtap="onRetry">重新加载</button>
    </view>

    <view wx:else class="card form">
      <view class="frow">
        <text class="frow__label">收货人</text>
        <input class="frow__input" placeholder="姓名" placeholder-class="frow__ph" value="{{form.name}}" bindinput="onNameInput" />
      </view>
      <view class="frow">
        <text class="frow__label">手机号</text>
        <input class="frow__input" type="number" placeholder="手机号码" placeholder-class="frow__ph" value="{{form.phone}}" bindinput="onPhoneInput" />
      </view>
      <view class="frow">
        <text class="frow__label">所在地区</text>
        <view class="frow__region">
          <input class="frow__input frow__input--region" placeholder="省" placeholder-class="frow__ph" value="{{form.province}}" bindinput="onProvinceInput" />
          <input class="frow__input frow__input--region" placeholder="市" placeholder-class="frow__ph" value="{{form.city}}" bindinput="onCityInput" />
          <input class="frow__input frow__input--region" placeholder="区/县" placeholder-class="frow__ph" value="{{form.district}}" bindinput="onDistrictInput" />
        </view>
      </view>
      <view class="frow">
        <text class="frow__label">详细地址</text>
        <input class="frow__input" placeholder="街道、门牌号、楼栋房号" placeholder-class="frow__ph" value="{{form.detail}}" bindinput="onDetailInput" />
      </view>
      <view class="frow frow--last">
        <text class="frow__label">设为默认地址</text>
        <switch checked="{{form.isDefault}}" color="#FF6363" bindchange="onDefaultToggle" />
      </view>
    </view>

    <view wx:if="{{!loading && !loadFailed}}" class="form-foot">
      <button class="save-btn {{saving ? 'save-btn--disabled' : ''}}" hover-class="none" disabled="{{saving}}" bindtap="onSave">
        {{saving ? '保存中…' : '保存'}}
      </button>
    </view>
  </view>

  <!-- 游客态：登录引导弹层（沿用 checkin/profile 游客范式） -->
  <view wx:if="{{guest}}" class="guest-mask">
    <view class="guest-card">
      <view class="guest-card__ic">📍</view>
      <view class="guest-card__h">收货地址</view>
      <view class="guest-card__p">登录后管理你的收货地址</view>
      <button class="guest-card__btn" hover-class="none" bindtap="onGuestLogin">微信一键登录</button>
    </view>
  </view>
</view>
