/* ============================================================
   新增/编辑收货地址表单 —— UI = 抖音商城新建地址页布局（用户
   11-06 拍板）：白卡表单行 + 默认地址独立卡 + 底部固定全宽渐变
   保存按钮。保留本 app 粉渐变顶栏与主题令牌；像素按 375 稿 ×2。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 粉渐变顶栏 ---------- */

.nav-wrap {
  background: linear-gradient(170deg, #ff7d6e, var(--color-accent));
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

/* 顶栏返回小房子约定：栈内=返回箭头（白），栈底=小房子，fail 兜底 switchTab coach */
.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-on-accent);
}

/* 底部固定保存条约占 160rpx + 安全区，content 留出避免遮挡 */
.content {
  padding: 28rpx 0 240rpx;
}

.page-loading {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 表单卡 ---------- */

.card {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 8rpx 32rpx;
  margin: 0 28rpx;
}

.defcard {
  margin-top: 20rpx;
}

.frow {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 2rpx solid var(--color-border-soft);
}

.frow--last {
  border-bottom: none;
}

/* 默认地址行：label 左、switch 顶到最右（抖音式） */
.defrow {
  justify-content: space-between;
}

.defrow .frow__label {
  width: auto;
}

.frow__label {
  width: 176rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex: none;
}

.frow__input {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-field-text);
}

.frow__ph {
  color: var(--color-text-tertiary);
}

/* ---------- 所在地区 picker 行 ---------- */

.frow__picker {
  flex: 1;
  min-width: 0;
}

.frow__picker-inner {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.frow__picker-txt {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-field-text);
}

.frow__picker-ph {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.frow__picker-arrow {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  opacity: 0.4;
}

/* ---------- 底部固定全宽保存 ----------
   view 自绘：原生 button 内置样式（默认宽 184px / size=mini 的
   inline-block 小字号）会反压页面类样式，纯点击入口直接绕开 */

.form-foot {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  /* 内容滚过时按钮下方不露出生硬切断 */
  background: linear-gradient(180deg, rgba(247, 249, 251, 0), var(--color-bg) 30%);
}

.save-btn {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 46rpx;
  background: linear-gradient(90deg, #ff8a6e, var(--color-accent));
  color: var(--color-on-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}

.save-btn--hover {
  opacity: 0.85;
}

.save-btn--disabled {
  background: #e7e7ec;
  color: var(--color-text-secondary);
}

/* ---------- 加载失败 ---------- */

.load-failed {
  padding: 32rpx;
  text-align: center;
}

.load-failed__txt {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.load-failed__btn {
  display: block;
  margin: 24rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.load-failed__btn--hover {
  opacity: 0.85;
}

/* ---------- 游客态登录引导弹层 ---------- */

.guest-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 246, 248, 0.86);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.guest-card {
  background: var(--color-card);
  border-radius: 36rpx;
  padding: 52rpx 48rpx;
  text-align: center;
  width: 540rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.08);
}

.guest-card__ic {
  font-size: 68rpx;
}

.guest-card__h {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 16rpx 0 8rpx;
}

.guest-card__p {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.guest-card__btn {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}
