/* ============================================================
   今日页 —— 依据 design/today.html 深色 STRIDE 主题
   背景 #07080A、卡片 #101111、主色 #FF6363
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 自定义顶部栏 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- 内容区 ---------- */

.content {
  padding: 0 40rpx calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 32rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: #e3e2e5;
  margin-bottom: 24rpx;
}

/* ---------- 周历 ---------- */

.week-card {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 24rpx 16rpx;
}

.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: opacity 0.15s ease;
}

.week-day:active {
  opacity: 0.7;
}

.week-day__label {
  font-size: 20rpx;
  text-transform: uppercase;
  color: #9c9c9d;
}

.week-day__num {
  font-size: 32rpx;
  font-weight: 700;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
}

.week-day--today {
  background: #ff6363;
}

.week-day--today .week-day__label {
  color: rgba(16, 17, 17, 0.8);
  font-weight: 700;
}

.week-day--today .week-day__num {
  color: #101111;
  font-weight: 700;
}

/* ---------- 训练卡片 ---------- */

.workout-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.workout__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.workout__title-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.workout__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.workout__icon-img {
  width: 40rpx;
  height: 40rpx;
}

.workout__title {
  font-size: 40rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: #e3e2e5;
}

.workout__actions {
  display: flex;
  gap: 16rpx;
}

.workout__action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.workout__action:active {
  opacity: 0.7;
}

.workout__action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* ---------- 强度柱状图 ---------- */

.workout__chart-block {
  margin-bottom: 24rpx;
}

.workout__label {
  font-size: 24rpx;
  color: #9c9c9d;
  margin-bottom: 16rpx;
}

.workout__chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 128rpx;
}

.workout__bar {
  flex: 1;
  border-top-left-radius: 4rpx;
  border-top-right-radius: 4rpx;
  background: #2f97e1;
}

.workout__bar--dim {
  background: rgba(47, 151, 225, 0.6);
}

.workout__chart-baseline {
  width: 100%;
  height: 1rpx;
  background: rgba(255, 255, 255, 0.1);
  margin-top: 8rpx;
}

/* ---------- 统计指标 ---------- */

.stat-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.stat-row--second {
  margin-bottom: 32rpx;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat--spacer {
  flex: 1;
}

.stat__value {
  font-size: 36rpx;
  font-weight: 700;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat__label {
  font-size: 20rpx;
  color: #9c9c9d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 备注框 ---------- */

.note-box {
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
  border-left: 4rpx solid rgba(255, 99, 99, 0.5);
}

.note-box__title {
  font-size: 20rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  color: #9c9c9d;
  margin-bottom: 8rpx;
}

.note-box__text {
  font-size: 24rpx;
  line-height: 36rpx;
  color: rgba(227, 226, 229, 0.9);
}

/* ---------- 教练按钮 ---------- */

.workout__cta {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: normal;
  border: none;
  border-radius: 20rpx;
  background: #ff6363;
  color: #101111;
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.workout__cta::after {
  border: none;
}

.workout__cta:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.workout__cta-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.workout__cta-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #101111;
}

/* ---------- 营养卡片 ---------- */

.nutrition-card {
  display: flex;
  flex-direction: column;
}

.meal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.05);
}

.meal__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}

.meal__name {
  font-size: 28rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.meal__time {
  font-size: 20rpx;
  color: #9c9c9d;
  margin-top: 4rpx;
}

.meal__detail {
  font-size: 24rpx;
  line-height: 34rpx;
  color: rgba(225, 191, 188, 0.8);
  margin-top: 8rpx;
}

.meal__kcal {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffb3af;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}
.content__tail {
  height: 24rpx;
}
