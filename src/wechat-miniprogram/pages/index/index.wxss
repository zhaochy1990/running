/* ============================================================
   今日页 —— 依据 design/today.html 深色 STRIDE 主题
   页面/卡片/主色令牌见 styles/theme.wxss
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ---------- 自定义顶部栏 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

/* ---------- 内容区 ---------- */

.content {
  padding: 0 40rpx calc(140rpx + env(safe-area-inset-bottom));
}

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.section-title {
  font-size: 27rpx;
  line-height: 52rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

/* ---------- 周历 ---------- */

.week-card {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 24rpx 16rpx;
}

.week-day {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 0;
  border-radius: 16rpx;
  transition: opacity 0.15s ease;
}

.week-day:active {
  opacity: 0.7;
}

.week-day__label {
  font-size: 17rpx;
  text-transform: uppercase;
  color: var(--color-text-secondary);
}

.week-day__num {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
}

.week-day--today {
  background: var(--color-accent);
}

.week-day--today .week-day__label {
  color: rgba(16, 17, 17, 0.8);
  font-weight: 700;
}

.week-day--today .week-day__num {
  color: var(--color-card);
  font-weight: 700;
}

/* ---------- 训练卡片 ---------- */

.workout-card {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.workout__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.workout__title-wrap {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.workout__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
}

.workout__icon-img {
  width: 40rpx;
  height: 40rpx;
}

.workout__title {
  font-size: 34rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.workout__actions {
  display: flex;
  gap: 16rpx;
}

.workout__action {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s ease;
}

.workout__action--pushed {
  background: rgba(var(--color-accent-rgb), 0.14);
}

.workout__action:active {
  opacity: 0.7;
}

.workout__action-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 今日卡分享钮（手表右侧，仅自建课显示）：裸图标无背景无描边。
   原生 button（白底/固定宽高/椭圆）全套透明化归零 */
.workout__share {
  display: flex;
  align-items: center;
  justify-content: center;
  align-self: center;
  margin: 0;
  padding: 0;
  width: auto;
  height: auto;
  min-width: 0;
  min-height: 0;
  line-height: 1;
  background: transparent;
  border: none;
  border-radius: 0;
}

.workout__share::after {
  border: none;
}

.workout__share-icon {
  display: block;
  width: 40rpx;
  height: 40rpx;
}

.workout__source {
  flex-shrink: 0;
  font-size: 20rpx;
  line-height: 28rpx;
  color: var(--color-text-secondary);
  background: rgba(var(--color-overlay-rgb), 0.05);
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
}


/* ---------- 强度柱状图 ---------- */

.workout__chart-block {
  margin-bottom: 24rpx;
}

.workout__label-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.workout__label {
  font-size: 20rpx;
  color: var(--color-text-secondary);
}

.workout__label-hint {
  font-size: 18rpx;
  color: rgba(var(--color-accent-pale-rgb), 0.55);
}

.workout__chart {
  display: flex;
  align-items: flex-end;
  gap: 8rpx;
  height: 128rpx;
}

.workout__bar {
  /* flex-basis 0：宽度纯按内联 flex-grow（段估时权重）比例分配——时间轴 */
  flex: 1 1 0%;
  border-top-left-radius: 4rpx;
  border-top-right-radius: 4rpx;
  background: #2f97e1;
}

.workout__bar--dim {
  background: rgba(47, 151, 225, 0.6);
}

.workout__chart-baseline {
  width: 100%;
  height: 1rpx;
  background: rgba(var(--color-overlay-rgb), 0.1);
  margin-top: 8rpx;
}

/* ---------- 统计指标 ---------- */

.stat-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 16rpx;
  width: 100%;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.stat-row--second {
  margin-bottom: 32rpx;
}

.stat {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.stat--spacer {
  flex: 1;
}

.stat__value {
  font-size: 31rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.stat__label {
  font-size: 17rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* ---------- 备注框 ---------- */

.note-box {
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(var(--color-overlay-rgb), 0.05);
  border-left: 4rpx solid rgba(var(--color-accent-rgb), 0.5);
}

.note-box__title {
  font-size: 17rpx;
  text-transform: uppercase;
  letter-spacing: 1rpx;
  color: var(--color-text-secondary);
  margin-bottom: 8rpx;
}

.note-box__text {
  font-size: 20rpx;
  line-height: 36rpx;
  color: rgba(227, 226, 229, 0.9);
}

/* ---------- 教练按钮 ---------- */

.workout__cta {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  margin: 16rpx 0 0;
  padding: 0;
  height: 96rpx;
  line-height: normal;
  border: none;
  border-radius: 20rpx;
  background: var(--color-accent);
  color: var(--color-card);
  box-sizing: border-box;
  transition: opacity 0.15s ease;
}

.workout__cta::after {
  border: none;
}

.workout__cta:active {
  opacity: 0.8;
  transform: scale(0.98);
}

.workout__cta-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

.workout__cta-text {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-card);
}

/* ---------- 营养卡片 ---------- */

.nutrition-card {
  display: flex;
  flex-direction: column;
}

.meal-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.meal {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 16rpx;
  background: rgba(var(--color-overlay-rgb), 0.05);
}

.meal__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
  padding-right: 16rpx;
}

.meal__name {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.meal__time {
  font-size: 17rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.meal__detail {
  font-size: 20rpx;
  line-height: 34rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
  margin-top: 8rpx;
}

.meal__kcal {
  font-size: 24rpx;
  font-weight: 700;
  color: var(--color-accent-pale);
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
  white-space: nowrap;
}
/* ---------- 今日活动卡片 ---------- */

.activity {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 24rpx 24rpx 0;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.activity:last-child {
  border-bottom: none;
}

.activity__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  /* 圆槽要真正裁掉缩略图的方角；border-radius 本身不裁剪子元素 */
  overflow: hidden;
}

.activity__icon-img {
  width: 40rpx;
  height: 40rpx;
}

/* 路线缩略图铺满圆槽。PNG 背景透明，且渲染端已把折线收进内切圆，
   所以圆角裁剪只会切掉空白角，不会切到路线本身 */
.activity__thumb {
  width: 72rpx;
  height: 72rpx;
}

.activity__info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.activity__name {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.activity__meta {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  font-variant-numeric: tabular-nums;
}

.activity__right {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.activity__load {
  font-size: 27rpx;
  font-weight: 700;
  color: var(--color-accent-pale);
  font-variant-numeric: tabular-nums;
}

.activity__load-label {
  font-size: 17rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

.content__tail {
  height: 24rpx;
}
