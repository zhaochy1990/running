.page {
  padding: var(--spacing-lg);
}

.hero {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.hero-title {
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  color: var(--color-text-primary);
}

.hero-subtitle {
  font-size: var(--font-size-md);
  color: var(--color-text-secondary);
}
