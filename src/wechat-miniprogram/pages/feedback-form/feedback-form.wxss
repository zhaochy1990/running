/* ============================================================
   意见反馈·全屏表单页（devops#554，原型 518 variant C）——
   深色 STRIDE 主题，顶栏同 feedback 列表页。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 顶栏（同 feedback 列表页） ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.content {
  padding: 0 32rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- type 分段 ---------- */

.seg {
  display: flex;
  gap: 12rpx;
  margin-top: 12rpx;
}

.seg__item {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-chip);
  border-radius: 24rpx;
}

.seg__item--on {
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
}

/* ---------- 描述 ---------- */

.fld-label {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin: 32rpx 4rpx 14rpx;
}

.fld-label__req {
  color: var(--color-accent-light);
}

.fld-label__opt {
  color: var(--color-text-tertiary);
}

.fld-textarea {
  width: 100%;
  min-height: 216rpx;
  box-sizing: border-box;
  background: var(--color-chip);
  border-radius: 24rpx;
  padding: 24rpx 26rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: var(--color-text-primary);
}

/* placeholder 深灰（原型 #5a5a5c） */
.fld-placeholder {
  color: #5a5a5c;
}

/* ---------- 图片四列格 ---------- */

.grid9 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.ph {
  aspect-ratio: 1;
  border-radius: 20rpx;
  background: var(--color-chip);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #4a4a4c;
  position: relative;
  overflow: hidden;
}

.ph--pic {
  background: var(--color-chip);
}

.ph__img {
  width: 100%;
  height: 100%;
}

.ph__x {
  position: absolute;
  top: 6rpx;
  right: 10rpx;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  padding: 4rpx;
  text-shadow: 0 0 8rpx rgba(0, 0, 0, 0.8);
}

/* ---------- 提交 ---------- */

.submit {
  margin-top: 36rpx;
  height: 92rpx;
  line-height: 92rpx;
  text-align: center;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 30rpx;
  font-weight: 600;
}

.submit--off {
  opacity: 0.35;
  pointer-events: none;
}

.submit--press {
  opacity: 0.85;
}

.hint {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  line-height: 30rpx;
  margin-top: 24rpx;
  text-align: center;
}
