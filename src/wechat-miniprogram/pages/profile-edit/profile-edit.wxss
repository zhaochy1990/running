/* ============================================================
   个人资料设置页 —— 深色 STRIDE 主题（与 profile / watch 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部栏 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.content {
  padding: 0 40rpx 48rpx;
}

/* ---------- 加载 / 提示 ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: #9c9c9d;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: #5fc992;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(255, 99, 99, 0.1);
  border: 1rpx solid rgba(255, 99, 99, 0.2);
  color: #ff6363;
}

/* ---------- 头像 header ---------- */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 48rpx;
}

/* 小程序基础库默认 `wx-button:not([size=mini]){width:184px}` 特异度高于单类选择器，
   故用 .hero .hero__avatar-btn 提升特异度，才能得到预期的圆形尺寸。 */
.hero .hero__avatar-btn {
  width: 176rpx;
  height: 176rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.06);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__avatar-btn::after {
  border: none;
}

.hero__avatar {
  width: 176rpx;
  height: 176rpx;
}

.hero__avatar--placeholder {
  width: 176rpx;
  height: 176rpx;
  padding: 48rpx;
  box-sizing: border-box;
}

.hero__hint {
  font-size: 22rpx;
  color: #9c9c9d;
}

.hero__name {
  font-size: 32rpx;
  font-weight: 700;
  color: #e3e2e5;
}

/* ---------- 字段行 ---------- */

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 48rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.field-row--last {
  border-bottom: none;
}

.field-row__label {
  font-size: 26rpx;
  color: #e3e2e5;
  flex-shrink: 0;
}

.field-row__value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #e3e2e5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-row__value--muted {
  color: #6a6b6c;
}

.field-row__input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: #e3e2e5;
  height: 100rpx;
}

.field-row__input--num {
  min-width: 0;
}

.field-row__unit {
  font-size: 24rpx;
  color: #9c9c9d;
  flex-shrink: 0;
}

.field-row__chevron {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* ---------- 完善身体数据入口 ---------- */

.body-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 0;
}

.body-entry__text {
  flex: 1;
  min-width: 0;
}

.body-entry__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #ffb3af;
}

.body-entry__sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: #9c9c9d;
}

/* 同 hero 头像按钮：提升特异度以压过基础库按钮默认 width:184px。 */
.card .save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 24rpx 0;
  padding: 0;
  border-radius: 20rpx;
  background: #ff6363;
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.5;
}
