/* ============================================================
   个人资料设置页 —— 深色 STRIDE 主题（与 profile / watch 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

/* ---------- 顶部栏 ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.content {
  padding: 0 40rpx 48rpx;
}

/* ---------- 加载 / 提示 ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(var(--color-success-rgb), 0.3);
  border-top-color: var(--color-success);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(var(--color-accent-rgb), 0.1);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.2);
  color: var(--color-accent);
}

/* ---------- 头像 header ---------- */

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 0 48rpx;
}

/* 小程序基础库默认 `wx-button:not([size=mini]){width:184px}` 特异度高于单类选择器，
   故用 .hero .hero__avatar-btn 提升特异度，才能得到预期的圆形尺寸。 */
.hero .hero__avatar-btn {
  width: 176rpx;
  height: 176rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.06);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.hero__avatar-btn::after {
  border: none;
}

.hero__avatar {
  width: 176rpx;
  height: 176rpx;
}

.hero__avatar--placeholder {
  width: 176rpx;
  height: 176rpx;
  padding: 48rpx;
  box-sizing: border-box;
}

.hero__hint {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.hero__name {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

/* ---------- 字段行 ---------- */

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 8rpx 32rpx;
  margin-bottom: 48rpx;
}

.field-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-height: 100rpx;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.field-row--last {
  border-bottom: none;
}

.field-row__label {
  font-size: 26rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.field-row__value {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.field-row__value--muted {
  color: var(--color-text-tertiary);
}

.field-row__input {
  flex: 1;
  text-align: right;
  font-size: 26rpx;
  color: var(--color-text-primary);
  height: 100rpx;
}

.field-row__input--num {
  min-width: 0;
}

.field-row__unit {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  flex-shrink: 0;
}

.field-row__chevron {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* ---------- 完善身体数据入口 ---------- */

.body-entry {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 36rpx 0;
}

.body-entry__text {
  flex: 1;
  min-width: 0;
}

.body-entry__title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-accent-pale);
}

.body-entry__sub {
  margin-top: 6rpx;
  font-size: 21rpx;
  color: var(--color-text-secondary);
}

/* 同 hero 头像按钮：提升特异度以压过基础库按钮默认 width:184px。 */
.card .save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 24rpx 0;
  padding: 0;
  border-radius: 20rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
}

.save-btn::after {
  border: none;
}

.save-btn[disabled] {
  opacity: 0.5;
}

/* ---------- 退出登录 ---------- */

/* 同 save-btn：提升特异度压过基础库按钮默认 width:184px。 */
.content .logout-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  margin: 0;
  padding: 0;
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.4);
  border-radius: 20rpx;
  background: rgba(var(--color-accent-rgb), 0.08);
  color: var(--color-accent);
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
}

.logout-btn::after {
  border: none;
}
