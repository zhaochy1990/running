<view class="page">
  <!-- 自定义顶部栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">产品路线</view>
        <view class="top-bar__subtitle">你投票 · 我们做</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;">
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <!-- 错误态（点按重试） -->
    <view wx:elif="{{loadError}}" class="banner banner--error" bindtap="onRetry">{{loadError}} · 点按重试</view>

    <block wx:else>
      <!-- 全量空态：三区都没有数据 -->
      <view
        wx:if="{{!releasedRows.length && !acceptedRows.length && !poolRows.length}}"
        class="empty-card"
      >
        <view class="empty-card__title">产品路线还在筹备中</view>
        <view class="empty-card__sub">上线后在这里投票，决定我们做什么</view>
      </view>

      <block wx:else>
        <!-- hero 聚合 -->
        <view class="hero">
          <view class="hero__kicker">STRIDE · 跑者共建</view>
          <view class="hero__nums">
            <view>
              <view class="hero__num hero__num--accent">{{myVotes}}</view>
              <view class="hero__lab">我的投票</view>
            </view>
            <view>
              <view class="hero__num">{{participants}}</view>
              <view class="hero__lab">人次参与</view>
            </view>
            <view>
              <view class="hero__num">{{releasedRows.length}}</view>
              <view class="hero__lab">想法已上线</view>
            </view>
          </view>
          <view class="hero__cta" hover-class="hero__cta--press" bindtap="onCtaTap">
            🗳 {{myVotes ? '继续投票' : '去投出第一票'}}
          </view>
        </view>

        <!-- 最近上线 changelog 时间线（常开） -->
        <view class="sec-head">
          <view class="sec-dot sec-dot--done"></view>
          <view class="sec-head__t">最近上线</view>
          <view class="sec-head__s">· 你的票变成了功能</view>
          <view class="sec-head__n">{{releasedRows.length}}</view>
        </view>
        <view class="sec-body rel-list">
          <view
            class="rel"
            wx:for="{{releasedRows}}"
            wx:key="id"
          >
            <view class="rel__line {{index === releasedRows.length - 1 ? 'rel__line--last' : ''}}"></view>
            <view class="rel__node"></view>
            <view class="rel__date">{{item.date}} 上线</view>
            <view class="rel__card">
              <view class="rel__title">{{item.title}}</view>
              <view class="rel__blurb">{{item.description}}</view>
              <view class="rel__proof">🔥 由 {{item.proof}} 位跑友投票促成</view>
            </view>
          </view>
        </view>

        <!-- 正在做（折叠） -->
        <view class="sec-head" bindtap="onFoldPlan">
          <view class="sec-dot sec-dot--plan"></view>
          <view class="sec-head__t">正在做</view>
          <view class="sec-head__s">· 已采纳</view>
          <view class="sec-head__n">{{acceptedRows.length}}</view>
          <view class="sec-head__arrow {{planOpen ? 'sec-head__arrow--open' : ''}}">›</view>
        </view>
        <view class="sec-body" wx:if="{{planOpen}}">
          <view class="plan-card" wx:for="{{acceptedRows}}" wx:key="id">
            <view class="plan-card__body">
              <view class="plan-card__title">{{item.title}}</view>
              <view class="plan-card__desc">{{item.description}}</view>
            </view>
            <view class="plan-card__right">
              <view wx:if="{{item.plannedNote}}" class="chip-plan">预计 {{item.plannedNote}}</view>
              <view class="plan-card__votes">{{item.votes}} 票 · 已采纳</view>
            </view>
          </view>
        </view>

        <!-- 投票池（折叠=Top3 预览 + 展开全部） -->
        <view class="sec-head" id="pool-head" bindtap="onFoldPool">
          <view class="sec-dot sec-dot--vote"></view>
          <view class="sec-head__t">投票池</view>
          <view class="sec-head__s">· 决定我们接下来做什么</view>
          <view class="sec-head__n">{{poolRows.length}} 个想法</view>
          <view class="sec-head__arrow {{poolOpen ? 'sec-head__arrow--open' : ''}}">›</view>
        </view>
        <view class="sec-body">
          <view wx:if="{{poolOpen}}" class="rule">
            🗳 每个想法可各投 <text class="rule__b">1 票</text>，再点一次即撤销 · 完全匿名
          </view>

          <block wx:for="{{poolRows}}" wx:key="id">
            <view wx:if="{{poolOpen || index < 3}}" class="idea">
              <view class="idea__body">
                <view class="idea__title">{{item.title}}</view>
                <view class="idea__desc">{{item.description}}</view>
                <view class="idea__meta">
                  <view wx:if="{{item.category}}" class="cat">{{item.category}}</view>
                  <view wx:if="{{item.isNew}}" class="idea__new">NEW</view>
                </view>
              </view>
              <view
                class="vote-btn {{item.voted ? 'vote-btn--on' : ''}} {{poolOpen ? '' : 'vote-btn--sm'}}"
                hover-class="vote-btn--press"
                data-id="{{item.id}}"
                bindtap="onVoteTap"
              >
                <view class="vote-btn__arrow">{{item.voted ? '✓' : '▲'}}</view>
                <view class="vote-btn__count">{{item.votes}}</view>
              </view>
            </view>
          </block>

          <view wx:if="{{!poolRows.length}}" class="pool-empty">还没有可以投票的想法</view>
          <view
            wx:if="{{!poolOpen && poolRows.length > 3}}"
            class="pool-expand"
            hover-class="pool-expand--press"
            bindtap="onExpandPool"
          >展开全部 {{poolRows.length}} 个想法 ↓</view>
        </view>

        <view class="hint-end">— 每个想法可各投 1 票 · 完全匿名 —</view>
      </block>
    </block>
  </view>
</view>
