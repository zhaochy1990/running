/* ============================================================
   产品路线页（devops#553，原型 514 variant C 定稿）—— 深色 STRIDE
   主题，与 my-races / watch / race-center 一致：深色令牌抽至
   styles/dark.wxss 由本页 @import；顶栏 / 加载 / 错误样式同 my-races。
   用户拍板：主题藕粉 #ff6363（--color-accent），卡片无边框。
   ============================================================ */
@import "../../styles/dark.wxss";

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 顶栏（同 my-races） ---------- */

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

.content {
  padding: 0 24rpx calc(60rpx + env(safe-area-inset-bottom));
}

/* ---------- 加载 / 错误（同 my-races） ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(var(--color-accent-rgb), 0.1);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.2);
  color: var(--color-accent);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: var(--color-success);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }
  to {
    transform: rotate(360deg);
  }
}

/* ---------- hero 聚合 ---------- */

.hero {
  padding: 36rpx 32rpx 32rpx;
  background:
    radial-gradient(120% 140% at 85% 0%, rgba(255, 99, 99, 0.22), rgba(255, 99, 99, 0) 55%),
    var(--color-card);
  border-radius: 32rpx;
  margin: 4rpx 0 8rpx;
}

.hero__kicker {
  font-size: 20rpx;
  color: rgba(255, 179, 175, 0.9);
  letter-spacing: 2rpx;
}

.hero__nums {
  display: flex;
  align-items: baseline;
  gap: 36rpx;
  margin-top: 16rpx;
}

.hero__num {
  font-size: 64rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 72rpx;
  font-variant-numeric: tabular-nums;
}

.hero__num--accent {
  color: var(--color-accent-light);
}

.hero__lab {
  font-size: 22rpx;
  color: var(--color-text-secondary);
  margin-top: 2rpx;
}

.hero__cta {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  text-align: center;
  border-radius: 36rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 26rpx;
  font-weight: 600;
}

.hero__cta--press {
  opacity: 0.85;
}

/* ---------- 分区头 ---------- */

.sec-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx 12rpx 16rpx;
}

.sec-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.sec-dot--vote {
  background: var(--color-accent);
}

.sec-dot--plan {
  background: var(--color-info);
}

.sec-dot--done {
  background: var(--color-success);
}

.sec-head__t {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.sec-head__s {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.sec-head__n {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.sec-head__arrow {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  transition: transform 0.18s;
}

.sec-head__arrow--open {
  transform: rotate(90deg);
}

/* ---------- 规则文案 ---------- */

.rule {
  margin: 4rpx 8rpx 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
}

.rule__b {
  color: var(--color-accent-light);
  font-weight: 600;
}

/* ---------- 想法卡（投票池，无边框） ---------- */

.idea {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.idea__body {
  flex: 1;
  min-width: 0;
}

.idea__title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-text-primary);
}

.idea__desc {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.idea__meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 14rpx;
}

.cat {
  font-size: 18rpx;
  line-height: 32rpx;
  padding: 0 14rpx;
  border-radius: 10rpx;
  color: var(--color-text-bright);
  background: rgba(255, 255, 255, 0.07);
}

.idea__new {
  font-size: 18rpx;
  line-height: 32rpx;
  padding: 0 12rpx;
  border-radius: 10rpx;
  color: var(--color-accent-light);
  background: rgba(var(--color-accent-rgb), 0.13);
}

.vote-btn {
  flex-shrink: 0;
  width: 112rpx;
  padding: 14rpx 0 12rpx;
  border-radius: 22rpx;
  background: var(--color-chip);
  text-align: center;
  transition: background 0.15s, transform 0.1s;
}

.vote-btn--press {
  transform: scale(0.94);
}

.vote-btn__arrow {
  font-size: 26rpx;
  line-height: 28rpx;
  color: var(--color-accent-light);
}

.vote-btn__count {
  font-size: 28rpx;
  font-weight: 700;
  line-height: 34rpx;
  color: var(--color-text-primary);
  font-variant-numeric: tabular-nums;
  margin-top: 4rpx;
}

.vote-btn--on {
  background: var(--color-accent);
  box-shadow: 0 8rpx 28rpx rgba(var(--color-accent-rgb), 0.35);
}

/* 折叠预览态的小号投票 pill（原型 vote-btn--sm） */
.vote-btn--sm {
  width: 100rpx;
  padding: 10rpx 0 8rpx;
  border-radius: 20rpx;
}

.vote-btn--sm .vote-btn__arrow {
  font-size: 22rpx;
  line-height: 24rpx;
}

.vote-btn--sm .vote-btn__count {
  font-size: 24rpx;
  line-height: 30rpx;
  margin-top: 2rpx;
}

.vote-btn--on .vote-btn__arrow {
  color: rgba(255, 255, 255, 0.85);
}

.vote-btn--on .vote-btn__count {
  color: #ffffff;
}

.pool-empty {
  text-align: center;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  padding: 40rpx 0 24rpx;
}

.pool-expand {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-accent-light);
  background: var(--color-card);
  border-radius: 28rpx;
  padding: 24rpx 0;
  margin-bottom: 20rpx;
}

.pool-expand--press {
  opacity: 0.85;
}

/* ---------- 已排期卡（正在做，无边框） ---------- */

.plan-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx;
  background: var(--color-card);
  border-radius: 28rpx;
  margin-bottom: 20rpx;
}

.plan-card__body {
  flex: 1;
  min-width: 0;
}

.plan-card__title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-text-primary);
}

.plan-card__desc {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.plan-card__right {
  flex-shrink: 0;
  text-align: right;
}

.chip-plan {
  display: inline-block;
  font-size: 20rpx;
  line-height: 34rpx;
  padding: 0 16rpx;
  border-radius: 18rpx;
  color: var(--color-info);
  background: rgba(143, 184, 232, 0.12);
}

.plan-card__votes {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  margin-top: 10rpx;
  font-variant-numeric: tabular-nums;
}

/* ---------- 最近上线 changelog 时间线 ---------- */

.rel-list {
  padding: 4rpx 12rpx 0 16rpx;
}

.rel {
  position: relative;
  padding: 0 0 32rpx 44rpx;
}

.rel__line {
  position: absolute;
  left: 10rpx;
  top: 16rpx;
  bottom: -12rpx;
  width: 4rpx;
  background: rgba(95, 201, 146, 0.18);
}

.rel__line--last {
  bottom: auto;
  height: 28rpx;
}

.rel__node {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 24rpx;
  height: 24rpx;
  border-radius: 50%;
  background: var(--color-bg);
  border: 5rpx solid var(--color-success);
  box-sizing: border-box;
}

.rel__date {
  font-size: 20rpx;
  color: var(--color-text-tertiary);
  font-variant-numeric: tabular-nums;
}

.rel__card {
  margin-top: 12rpx;
  padding: 26rpx 28rpx;
  background: var(--color-card);
  border-radius: 26rpx;
}

.rel__title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-text-primary);
}

.rel__blurb {
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.rel__proof {
  font-size: 20rpx;
  color: var(--color-accent-light);
  margin-top: 14rpx;
}

/* ---------- 尾注 ---------- */

.hint-end {
  text-align: center;
  font-size: 20rpx;
  color: #4a4a4c;
  padding: 20rpx 0 8rpx;
}
