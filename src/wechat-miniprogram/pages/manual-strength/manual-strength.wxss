page {
  background: var(--color-bg);
}

.strength-page {
  box-sizing: border-box;
  padding: 40rpx var(--spacing-lg) calc(160rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
}

.strength-state {
  padding: 60rpx var(--spacing-md);
  text-align: center;
  color: var(--color-text-secondary);
}

.name-field {
  flex: 1;
  min-width: 0;
}

.field-label {
  color: var(--color-text-bright);
  font-size: var(--font-size-xs);
  font-weight: var(--font-weight-semibold);
}

.field-input {
  height: 80rpx;
  border-bottom: 2rpx solid var(--color-hairline);
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-semibold);
}

.field-input--invalid {
  border-color: var(--color-danger);
}

.field-placeholder {
  color: var(--color-text-bright);
}

.field-error {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  line-height: 1.4;
}

.action-heading {
  margin: 44rpx 0 18rpx;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
}

.action-card {
  padding: 20rpx var(--spacing-md) var(--spacing-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-card);
}

.action-card + .action-card {
  margin-top: var(--spacing-md);
}

.action-card--collapsed {
  padding-block: var(--spacing-xs);
}

.action-header {
  display: flex;
  align-items: flex-start;
  gap: var(--spacing-xs);
}

/* WeChat style v2 sets the width and horizontal margins on native buttons. */
.strength-page button {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  color: inherit;
  line-height: 1.4;
}

.strength-page button::after {
  border: 0;
}

.strength-page .action-toggle {
  justify-content: flex-start;
  gap: var(--spacing-sm);
  width: 100%;
  min-height: 88rpx;
  text-align: left;
}

.action-title {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}

.action-count {
  flex: none;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.chevron {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.strength-page .icon-button {
  flex: none;
  width: 64rpx;
  height: 88rpx;
  border-radius: var(--radius-sm);
  color: var(--color-text-secondary);
}

.strength-page .remove-action {
  width: 72rpx;
  height: 72rpx;
}

.control-mark {
  position: relative;
  flex: none;
  width: 24rpx;
  height: 24rpx;
}

.control-mark::before,
.control-mark::after {
  content: '';
  position: absolute;
  top: 50%;
  left: 50%;
  width: 18rpx;
  height: 2rpx;
  border-radius: var(--radius-full);
  background: currentColor;
  transform: translate(-50%, -50%);
}

.control-mark::after {
  transform: translate(-50%, -50%) rotate(90deg);
}

.control-mark--cross {
  transform: rotate(45deg);
}

.set-labels,
.set-row {
  display: grid;
  grid-template-columns: 52rpx minmax(0, 1fr) 92rpx minmax(0, 1.12fr) 128rpx;
  gap: var(--spacing-xs);
  align-items: center;
  text-align: center;
}

.set-labels {
  margin-top: var(--spacing-md);
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
}

.set-row {
  border-bottom: 2rpx solid var(--color-hairline);
}

.set-number {
  font-weight: var(--font-weight-semibold);
  color: var(--color-text-secondary);
}

.set-number,
.set-input,
.unit {
  font-size: var(--font-size-sm);
  font-variant-numeric: tabular-nums;
}

.set-cell,
.unit,
.set-actions {
  display: flex;
  align-items: center;
}

.set-cell {
  min-width: 0;
  border-bottom: 2rpx solid transparent;
}

.set-cell--invalid {
  border-color: var(--color-danger);
}

.set-input {
  flex: 1;
  width: 100%;
  min-width: 0;
  height: 88rpx;
  text-align: center;
}

.set-cell picker {
  flex: none;
}

.unit {
  justify-content: center;
  gap: 6rpx;
  min-height: 88rpx;
  white-space: nowrap;
}

.unit image {
  flex: none;
  width: 18rpx;
  height: 18rpx;
  transform: rotate(90deg);
}

.set-actions {
  justify-content: flex-end;
}

.icon-button image {
  width: 34rpx;
  height: 34rpx;
}

.strength-page .add-set,
.strength-page .add-action {
  gap: 8rpx;
  min-height: 88rpx;
  color: var(--color-accent-deep);
  font-weight: var(--font-weight-semibold);
}

.strength-page .add-set {
  width: fit-content;
  margin-top: var(--spacing-xs);
  padding-right: var(--spacing-sm);
  font-size: var(--font-size-sm);
}

.strength-page .add-action {
  width: 100%;
  margin-top: var(--spacing-md);
  border: 2rpx dashed var(--color-hairline);
  border-radius: var(--radius-lg);
  font-size: var(--font-size-md);
}

.note-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  height: 208rpx;
  margin-top: var(--spacing-md);
  padding: var(--spacing-sm);
  border: 2rpx solid var(--color-text-tertiary);
  border-radius: var(--radius-md);
  color: var(--color-field-text);
  font-size: var(--font-size-md);
  line-height: 1.55;
}

.strength-footer {
  position: fixed;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-sm) var(--spacing-lg) calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-hairline);
  background: var(--color-card);
}

.strength-footer__message {
  margin: 0 0 var(--spacing-xs);
}

.strength-page .save-button {
  width: 100%;
  min-height: 96rpx;
  border-radius: var(--radius-lg);
  background: var(--color-accent-deep);
  color: var(--color-on-accent);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
}

.strength-page .save-button[disabled] {
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
}

.strength-page .action-toggle[disabled],
.strength-page .icon-button[disabled],
.strength-page .add-set[disabled],
.strength-page .add-action[disabled] {
  opacity: 0.5;
}

@media (max-width: 380px) {
  .action-card {
    padding-inline: var(--spacing-sm);
  }

  .set-labels,
  .set-row {
    grid-template-columns: 44rpx minmax(0, 1fr) 88rpx minmax(0, 1.12fr) 128rpx;
    gap: 6rpx;
  }
}
