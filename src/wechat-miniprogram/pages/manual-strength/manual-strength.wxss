.strength-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: var(--spacing-md) var(--spacing-sm) calc(160rpx + env(safe-area-inset-bottom));
  background: var(--color-bg);
  color: var(--color-text-primary);
}

.strength-state {
  padding: 60rpx var(--spacing-md);
  text-align: center;
  color: var(--color-text-secondary);
}

.strength-page .card {
  padding: 20rpx;
  margin-bottom: var(--spacing-sm);
}

.field-label {
  font-size: var(--font-size-sm);
  font-weight: var(--font-weight-semibold);
  margin-bottom: var(--spacing-xs);
}

.field-input {
  height: 68rpx;
  border-bottom: 2rpx solid var(--color-border-soft);
  font-size: var(--font-size-md);
}

.field-input--invalid,
.set-cell--invalid {
  border-color: var(--color-danger);
}

.field-placeholder {
  color: var(--color-text-secondary);
}

.field-error {
  margin-top: var(--spacing-xs);
  font-size: var(--font-size-xs);
  color: var(--color-danger);
  line-height: 1.4;
}

.action-header,
.action-toggle,
.set-actions,
.set-cell,
.unit {
  display: flex;
  align-items: center;
}

.action-toggle,
.icon-button,
.add-set,
.add-action,
.save-button {
  padding: 0;
  margin: 0;
  border: 0;
  border-radius: 0;
  background: transparent;
  line-height: 1.4;
  color: inherit;
}

.action-toggle::after,
.icon-button::after,
.add-set::after,
.add-action::after,
.save-button::after {
  border: 0;
}

.action-toggle {
  flex: 1;
  min-width: 0;
  min-height: 64rpx;
  gap: var(--spacing-xs);
  text-align: left;
}

.action-title {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}

.action-count {
  flex: none;
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
}

.chevron {
  flex: none;
  width: 24rpx;
  height: 24rpx;
}

.chevron--expanded {
  transform: rotate(90deg);
}

.icon-button {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 64rpx;
  font-size: 36rpx;
}

.icon-button image {
  width: 32rpx;
  height: 32rpx;
}

.action-body {
  margin-top: var(--spacing-sm);
}

.set-labels,
.set-row {
  display: grid;
  grid-template-columns: 38rpx minmax(0, 1.25fr) minmax(0, 1fr) 96rpx;
  gap: 8rpx;
  align-items: center;
}

.set-labels {
  color: var(--color-text-secondary);
  font-size: var(--font-size-xs);
  margin-top: 18rpx;
}

.set-row {
  min-height: 78rpx;
  border-bottom: 2rpx solid var(--color-border-soft);
}

.set-number {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.set-cell {
  min-width: 0;
  border-bottom: 2rpx solid transparent;
}

.set-cell--invalid {
  border-color: var(--color-danger);
}

.set-input {
  flex: 1;
  min-width: 0;
  height: 68rpx;
  font-size: var(--font-size-sm);
}

.unit {
  gap: 6rpx;
  min-height: 68rpx;
  padding: 0 8rpx;
  font-size: var(--font-size-xs);
  white-space: nowrap;
}

.unit image {
  width: 18rpx;
  height: 18rpx;
  transform: rotate(90deg);
}

.set-actions {
  justify-content: flex-end;
}

.set-button {
  width: 48rpx;
}

.set-button image {
  width: 28rpx;
  height: 28rpx;
}

.add-set {
  width: fit-content;
  min-height: 70rpx;
  padding: var(--spacing-sm) 0 0;
  color: var(--color-accent-deep);
  font-size: var(--font-size-sm);
  text-align: left;
}

.add-action {
  width: 100%;
  min-height: 80rpx;
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
  background: var(--color-card);
  color: var(--color-accent-deep);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-semibold);
}

.add-error {
  margin-left: var(--spacing-sm);
}

.note-card {
  margin-top: var(--spacing-sm);
}

.note-input {
  width: 100%;
  height: 160rpx;
  color: var(--color-field-text);
  font-size: var(--font-size-md);
  line-height: 1.4;
}

.strength-footer {
  position: fixed;
  z-index: 2;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg);
  padding: var(--spacing-sm) var(--spacing-md) calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-border-soft);
}

.strength-footer__message {
  margin: 0 0 var(--spacing-xs);
}

.save-button {
  border-radius: var(--radius-lg);
  min-height: 88rpx;
  line-height: 88rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
}

.save-button[disabled] {
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
}
