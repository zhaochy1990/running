/* ============================================================
   我的比赛页 —— 双 tab（我的赛事 / 我的成绩），深色 STRIDE 主题
   （与 watch / race-center 一致）。app.wxss 的全局令牌是浅色主题，
   深色令牌抽至 styles/dark.wxss 由本页 @import；深色页仍需在页面内
   重定义 .card / .card__label / banner / spinner（同 watch 页做法）；
   .empty-card 为 app.wxss 里已是深色的全局类。
   「我的赛事」tab 样式自 race-center/plans 页并入，计划卡类名
   统一 plan- 前缀，避免与成绩列表 .card 冲突。
   ============================================================ */
@import "../../styles/dark.wxss";

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- tab：我的赛事 / 我的成绩（分段选择器，主题色点亮） ---------- */

.tabs {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 40rpx 20rpx;
}

.tabs__item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-sunken);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
}

.tabs__item--on {
  color: var(--color-on-accent);
  font-weight: 600;
  background: var(--color-accent);
  border-color: var(--color-accent);
}

.content {
  padding: 0 24rpx calc(140rpx + env(safe-area-inset-bottom));
}

/* ---------- 卡片 ----------
   app.wxss 的全局 .card 用浅色主题令牌，深色页都在页面内
   重定义暗卡（与 watch / activities 一致）；
   此处 .card 只用于「我的成绩」列表容器。 */

.card {
  background: var(--color-card);
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.card__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: var(--color-text-secondary);
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

/* ---------- 提示条 / 加载（同 watch 页） ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(var(--color-accent-rgb), 0.1);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.2);
  color: var(--color-accent);
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: var(--color-success);
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* ---------- 「我的赛事」计划卡（自 plans 页并入） ---------- */

.plan {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: var(--color-card);
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 26rpx;
}

/* 已下架占位 / 自定义已结束：灰卡、记录保留 */
.plan--off,
.plan--past {
  background: var(--color-bg-dim);
  border-color: rgba(255, 255, 255, 0.03);
}

.plan__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan__name--dim {
  color: var(--color-text-muted);
}

.plan__meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: var(--color-text-secondary);
}

/* 开赛倒计时：主题藕粉文字（与全马徽章同色族），不加底色避免卡上徽章过密 */
.plan__countdown {
  margin-left: auto;
  flex-shrink: 0;
  font-weight: 600;
  color: var(--color-accent-light);
}

.plan__meta--dim {
  color: var(--color-text-tertiary);
  white-space: normal;
}

/* 徽章：项目=中性；状态=四态配色（与列表页双徽章同族暖/冷/绿） */

.plan-badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 30rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.plan-badge--item {
  color: var(--color-text-bright);
  background: rgba(255, 255, 255, 0.08);
}

.plan-badge--state--registered {
  color: var(--color-info);
  background: rgba(143, 184, 232, 0.12);
}

.plan-badge--state--won {
  color: var(--color-warning);
  background: rgba(232, 192, 125, 0.12);
}

.plan-badge--state--lost {
  color: var(--color-text-secondary);
  background: rgba(156, 156, 157, 0.14);
}

.plan-badge--state--confirmed {
  color: var(--color-success);
  background: rgba(95, 201, 146, 0.12);
}

.plan-badge--off {
  color: var(--color-text-muted);
  background: rgba(255, 255, 255, 0.06);
}

/* ---------- 状态条：想报名→已报名→已中签→确认参赛 chips（四枚在一行放不下，可换行） ---------- */

.steps {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 8rpx;
  padding: 16rpx;
  background: var(--color-bg-sunken);
  border-radius: 18rpx;
}

.steps__chip {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: var(--color-text-cool);
  background: var(--color-chip);
  border-radius: 24rpx;
}

.steps__chip--on {
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
}

.steps__arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

.steps__hint {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 20rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 未中签旁路：转化引导 ---------- */

.lost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: var(--color-bg-sunken);
  border-radius: 18rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.lost-row__link {
  flex-shrink: 0;
  color: var(--color-accent);
}

/* ---------- 行程布尔勾选 ---------- */

.trip {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trip__chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
}

.trip__chip--on {
  color: var(--color-success);
  border-color: rgba(95, 201, 146, 0.6);
  background: rgba(95, 201, 146, 0.08);
  font-weight: 600;
}

/* ---------- 页脚说明 / 空态（我的赛事） ---------- */

.note {
  margin: 28rpx 8rpx 8rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  color: var(--color-text-tertiary);
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty__icon {
  font-size: 88rpx;
  line-height: 120rpx;
}

.empty__title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-bright);
}

.empty__hint {
  margin: 12rpx 0 36rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: var(--color-text-muted);
  text-align: center;
}

.empty__btn {
  padding: 18rpx 52rpx;
  font-size: 26rpx;
  color: var(--color-on-accent);
  background: var(--color-accent);
  border-radius: 36rpx;
  font-weight: 600;
}

/* ---------- 我的成绩：比赛行 ---------- */

.race {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.race:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.race__main {
  flex: 1;
  min-width: 0;
}

.race__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.race__band {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.race__band--marathon {
  color: var(--color-accent-light);
  background: rgba(var(--color-accent-rgb), 0.14);
}

.race__band--half {
  color: var(--color-success-light);
  background: rgba(95, 201, 146, 0.14);
}

.race__band--other {
  color: var(--color-band-other);
  background: rgba(255, 255, 255, 0.08);
}

/* PB 徽章：与 race__band 同形，金色 */
.race__pb {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  color: var(--color-warning);
  background: rgba(232, 192, 125, 0.14);
}

.race__date {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.race__name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 等级双徽章（#545）：仅官方识别行，名下一行，色值复刻 race-center 的 .badge--cn/--wa */

.race__badges {
  display: flex;
  gap: 12rpx;
  margin-top: 6rpx;
  white-space: nowrap;
  overflow: hidden;
}

.race__badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 28rpx;
  padding: 0 10rpx;
  border-radius: 6rpx;
}

.race__badge--cn {
  color: #e8c07d;
  background: rgba(232, 192, 125, 0.12);
}

.race__badge--wa {
  color: #8fb8e8;
  background: rgba(143, 184, 232, 0.12);
}

.race__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.race__meta-dot {
  flex-shrink: 0;
}

.race__result {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.race__duration {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--color-accent-pale);
  font-variant-numeric: tabular-nums;
}

.race__duration-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: var(--color-text-secondary);
}

/* ---------- 自定义比赛卡（#475）---------- */

/* 「＋」添加自定义比赛：右下角 FAB（#456 拍板，从顶栏移出让开胶囊安全区）。
   藕粉主题实心圆 + 白色＋，安全区沿仓内 calc(Nrpx + env(safe-area-inset-bottom)) 惯例 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: calc(48rpx + env(safe-area-inset-bottom));
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 52rpx;
  line-height: 96rpx;
  text-align: center;
  font-weight: 500;
  box-shadow: 0 8rpx 24rpx rgba(var(--color-accent-rgb), 0.35);
  z-index: 10;
}

/* 粉色「自定义」徽章：与官方项目徽章同族、主题藕粉 */
.plan-badge--custom {
  color: var(--color-accent-light);
  background: rgba(var(--color-accent-rgb), 0.12);
}

/* 想跑：琥珀（与已中签同族暖色）；已结束：灰（与已下架同族） */
.plan-badge--state--want {
  color: var(--color-warning);
  background: rgba(232, 192, 125, 0.12);
}

.plan-badge--state--done {
  color: var(--color-text-muted);
  background: rgba(255, 255, 255, 0.06);
}

/* ··· 菜单：编辑 / 删除唯一入口（自定义名称不可点） */
.more-btn {
  flex-shrink: 0;
  padding: 0 8rpx;
  font-size: 30rpx;
  line-height: 36rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* 卡面备注：📝 前缀，弱化灰字 */
.plan__note {
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: var(--color-text-secondary);
  background: var(--color-bg-sunken);
  border-radius: 18rpx;
}

/* 空态次级引导：赛事中心没有？手动添加一场 */
.empty__ghost {
  margin-top: 24rpx;
  padding: 12rpx 36rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}
