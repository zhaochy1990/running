/* ============================================================
   我的比赛页 —— 双 tab（我的赛事 / 我的成绩），深色 STRIDE 主题
   （与 watch / race-center 一致）。app.wxss 的全局令牌是浅色主题，
   深色页需在页面内重定义 .card / .card__label / banner / spinner
   （同 watch 页做法）；.empty-card 为 app.wxss 里已是深色的全局类。
   「我的赛事」tab 样式自 race-center/plans 页并入，计划卡类名
   统一 plan- 前缀，避免与成绩列表 .card 冲突。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- tab：我的赛事 / 我的成绩（分段选择器，主题色点亮） ---------- */

.tabs {
  display: flex;
  gap: 8rpx;
  padding: 4rpx 40rpx 20rpx;
}

.tabs__item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9c9c9d;
  background: #0a0b0d;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 32rpx;
}

.tabs__item--on {
  color: #ffffff;
  font-weight: 600;
  background: #ff6363;
  border-color: #ff6363;
}

.content {
  padding: 0 24rpx 48rpx;
}

/* ---------- 卡片 ----------
   app.wxss 的全局 .card 用浅色主题令牌（--color-card: #ffffff），
   深色页都在页面内重定义暗卡（与 watch / activities 一致）；
   此处 .card 只用于「我的成绩」列表容器。 */

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

.card__label {
  font-size: 20rpx;
  letter-spacing: 2rpx;
  text-transform: uppercase;
  color: #9c9c9d;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
  padding-bottom: 16rpx;
  margin-bottom: 24rpx;
}

/* ---------- 提示条 / 加载（同 watch 页） ---------- */

.state-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  padding: 96rpx 0;
}

.state-card__text {
  font-size: 24rpx;
  color: #9c9c9d;
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 24rpx;
  margin-bottom: 32rpx;
}

.banner--error {
  background: rgba(255, 99, 99, 0.1);
  border: 1rpx solid rgba(255, 99, 99, 0.2);
  color: #ff6363;
}

.spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid rgba(95, 201, 146, 0.3);
  border-top-color: #5fc992;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  from {
    transform: rotate(0deg);
  }

  to {
    transform: rotate(360deg);
  }
}

/* ---------- 「我的赛事」计划卡（自 plans 页并入） ---------- */

.plan {
  margin-top: 24rpx;
  padding: 28rpx 28rpx 24rpx;
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  border-radius: 26rpx;
}

/* 已下架占位：灰卡、记录保留、不可交互 */
.plan--off {
  background: #0d0e10;
  border-color: rgba(255, 255, 255, 0.03);
}

.plan__head {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.plan__name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #e3e2e5;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.plan__name--dim {
  color: #8a8a8c;
}

.plan__meta {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin: 8rpx 0 20rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #9c9c9d;
}

/* 开赛倒计时：主题藕粉文字（与全马徽章同色族），不加底色避免卡上徽章过密 */
.plan__countdown {
  margin-left: auto;
  flex-shrink: 0;
  font-weight: 600;
  color: #ff8f8f;
}

.plan__meta--dim {
  color: #6a6a6c;
  white-space: normal;
}

/* 徽章：项目=中性；状态=四态配色（与列表页双徽章同族暖/冷/绿） */

.plan-badge {
  flex-shrink: 0;
  font-size: 18rpx;
  line-height: 30rpx;
  padding: 0 12rpx;
  border-radius: 8rpx;
}

.plan-badge--item {
  color: #b9b8bc;
  background: rgba(255, 255, 255, 0.08);
}

.plan-badge--state--registered {
  color: #8fb8e8;
  background: rgba(143, 184, 232, 0.12);
}

.plan-badge--state--won {
  color: #e8c07d;
  background: rgba(232, 192, 125, 0.12);
}

.plan-badge--state--lost {
  color: #9c9c9d;
  background: rgba(156, 156, 157, 0.14);
}

.plan-badge--state--confirmed {
  color: #5fc992;
  background: rgba(95, 201, 146, 0.12);
}

.plan-badge--off {
  color: #8a8a8c;
  background: rgba(255, 255, 255, 0.06);
}

/* ---------- 状态条：已报名→已中签→确认参赛 chips ---------- */

.steps {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx;
  background: #0a0b0d;
  border-radius: 18rpx;
}

.steps__chip {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #8a8f99;
  background: #17181a;
  border-radius: 24rpx;
}

.steps__chip--on {
  background: #ff6363;
  color: #ffffff;
  font-weight: 600;
}

.steps__arrow {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #6a6a6c;
}

.steps__hint {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 20rpx;
  color: #6a6a6c;
}

/* ---------- 未中签旁路：转化引导 ---------- */

.lost-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-top: 16rpx;
  padding: 16rpx 24rpx;
  background: #0a0b0d;
  border-radius: 18rpx;
  font-size: 22rpx;
  color: #9c9c9d;
}

.lost-row__link {
  flex-shrink: 0;
  color: #ff6363;
}

/* ---------- 行程布尔勾选 ---------- */

.trip {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.trip__chip {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 22rpx;
  color: #9c9c9d;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
}

.trip__chip--on {
  color: #5fc992;
  border-color: rgba(95, 201, 146, 0.6);
  background: rgba(95, 201, 146, 0.08);
  font-weight: 600;
}

/* ---------- 页脚说明 / 空态（我的赛事） ---------- */

.note {
  margin: 28rpx 8rpx 8rpx;
  font-size: 20rpx;
  line-height: 36rpx;
  color: #6a6a6c;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx;
}

.empty__icon {
  font-size: 88rpx;
  line-height: 120rpx;
}

.empty__title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #b9b8bc;
}

.empty__hint {
  margin: 12rpx 0 36rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #8a8a8c;
  text-align: center;
}

.empty__btn {
  padding: 18rpx 52rpx;
  font-size: 26rpx;
  color: #ffffff;
  background: #ff6363;
  border-radius: 36rpx;
  font-weight: 600;
}

/* ---------- 我的成绩：比赛行 ---------- */

.race {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.race:last-child {
  border-bottom: none;
  padding-bottom: 8rpx;
}

.race__main {
  flex: 1;
  min-width: 0;
}

.race__head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.race__band {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.race__band--marathon {
  color: #ff8f8f;
  background: rgba(255, 99, 99, 0.14);
}

.race__band--half {
  color: #7ec9a6;
  background: rgba(95, 201, 146, 0.14);
}

.race__band--other {
  color: #c9c3c4;
  background: rgba(255, 255, 255, 0.08);
}

/* PB 徽章：与 race__band 同形，金色 */
.race__pb {
  font-size: 20rpx;
  font-weight: 600;
  line-height: 32rpx;
  padding: 2rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
  color: #e8c07d;
  background: rgba(232, 192, 125, 0.14);
}

.race__date {
  font-size: 22rpx;
  color: #9c9c9d;
}

.race__name {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
  color: #e3e2e5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.race__meta {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9c9c9d;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.race__meta-dot {
  flex-shrink: 0;
}

.race__result {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.race__duration {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffb3af;
  font-variant-numeric: tabular-nums;
}

.race__duration-label {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #9c9c9d;
}
