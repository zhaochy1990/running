<view class="page">
  <!-- 自定义顶部栏 + 双 tab -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">我的比赛</view>
        <view class="top-bar__subtitle">参赛计划与成绩</view>
      </view>
      <!-- 「＋」：添加自定义比赛（仅我的赛事 tab；我的成绩 tab 保持占位对称） -->
      <view
        wx:if="{{activeTab === 'plans'}}"
        class="top-bar__btn"
        bindtap="onAddTap"
      >
        <view class="top-bar__plus">＋</view>
      </view>
      <view wx:else class="top-bar__btn top-bar__btn--spacer"></view>
    </view>

    <!-- tab：我的赛事（默认）/ 我的成绩 -->
    <view class="tabs">
      <view
        class="tabs__item {{activeTab === 'plans' ? 'tabs__item--on' : ''}}"
        data-tab="plans"
        bindtap="onTabTap"
      >我的赛事</view>
      <view
        class="tabs__item {{activeTab === 'results' ? 'tabs__item--on' : ''}}"
        data-tab="results"
        bindtap="onTabTap"
      >我的成绩</view>
    </view>
  </view>

  <!-- 「我的赛事」tab：参赛计划 -->
  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;" wx:if="{{activeTab === 'plans'}}">
    <!-- 加载态 -->
    <view wx:if="{{plansLoading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <block wx:else>
      <view wx:if="{{plansError}}" class="banner banner--error">{{plansError}}</view>

      <!-- 混排卡（#474/#475：官方计划 + 自定义比赛按比赛日合并，已结束沉底；后端排序，前端保序） -->
      <block wx:if="{{mixRows.length}}">
        <block wx:for="{{mixRows}}" wx:key="key">
          <!-- 官方计划卡：已下架占位灰卡不可交互，常规卡可交互 -->
          <block wx:if="{{item.kind === 'official'}}">
            <view wx:if="{{item.plan.offboarded}}" class="plan plan--off">
              <view class="plan__head">
                <view class="plan__name plan__name--dim">{{item.plan.name}}</view>
                <text class="plan-badge plan-badge--off">已下架</text>
              </view>
              <view class="plan__meta plan__meta--dim">
                {{item.plan.dateLabel ? item.plan.dateLabel + ' · ' : ''}}{{item.plan.city ? item.plan.city + ' · ' : ''}}该赛事已被管理员下架，你的参赛记录保留
              </view>
            </view>

            <view wx:else class="plan">
              <view class="plan__head">
                <view class="plan__name" data-race-id="{{item.plan.raceId}}" bindtap="onRaceNameTap">{{item.plan.name}}</view>
                <text class="plan-badge plan-badge--item">{{item.plan.itemLabel}}</text>
                <text class="plan-badge plan-badge--state plan-badge--state--{{item.plan.state}}">{{item.plan.stateLabel}}</text>
              </view>
              <view class="plan__meta">
                <text>{{item.plan.dateLabel}}{{item.plan.city ? ' · ' + item.plan.city : ''}}</text>
                <text wx:if="{{item.plan.countdown}}" class="plan__countdown">{{item.plan.countdown}}</text>
              </view>

              <!-- 状态条：已报名→已中签→确认参赛 chips 点击流转 -->
              <view class="steps">
                <block wx:for="{{item.plan.steps}}" wx:for-item="s" wx:key="state">
                  <view
                    class="steps__chip {{s.on ? 'steps__chip--on' : ''}}"
                    data-race-id="{{item.plan.raceId}}"
                    data-state="{{s.state}}"
                    bindtap="onStateTap"
                  >{{s.label}}</view>
                  <text wx:if="{{index < item.plan.steps.length - 1}}" class="steps__arrow">›</text>
                </block>
                <text class="steps__hint">点状态切换</text>
              </view>

              <!-- 未中签旁路：转化引导 -->
              <view wx:if="{{item.plan.lost}}" class="lost-row">
                <text>可惜没中签——看看同期还有哪些赛事</text>
                <text class="lost-row__link" bindtap="onGoListTap">去找替代 ›</text>
              </view>

              <!-- 行程布尔勾选 -->
              <view class="trip">
                <view
                  class="trip__chip {{item.plan.hotel ? 'trip__chip--on' : ''}}"
                  data-race-id="{{item.plan.raceId}}"
                  data-field="hotel"
                  bindtap="onTripTap"
                >🏨 酒店 · {{item.plan.hotel ? '已订' : '未订'}}</view>
                <view
                  class="trip__chip {{item.plan.transit ? 'trip__chip--on' : ''}}"
                  data-race-id="{{item.plan.raceId}}"
                  data-field="transit"
                  bindtap="onTripTap"
                >🚄 火车票·机票 · {{item.plan.transit ? '已订' : '未订'}}</view>
              </view>
            </view>
          </block>

          <!-- 自定义比赛卡（#475）：粉色「自定义」徽章 + 类型（距离）徽章；
               名称不可点（无详情页，#456 补充决议）；已结束 = 灰化 + 隐藏倒计时/状态条 -->
          <view wx:else class="plan {{item.custom.done ? 'plan--past' : ''}}">
            <view class="plan__head">
              <view class="plan__name {{item.custom.done ? 'plan__name--dim' : ''}}">{{item.custom.name}}</view>
              <text class="plan-badge plan-badge--custom">自定义</text>
              <text class="plan-badge plan-badge--item">{{item.custom.badgeLabel}}</text>
              <text class="plan-badge plan-badge--state plan-badge--state--{{item.custom.done ? 'done' : item.custom.state}}">{{item.custom.stateLabel}}</text>
              <view class="more-btn" data-key="{{item.key}}" catchtap="onMoreTap">⋯</view>
            </view>
            <view class="plan__meta {{item.custom.done ? 'plan__meta--dim' : ''}}">
              <text>{{item.custom.metaLabel}}</text>
              <text wx:if="{{item.custom.countdown}}" class="plan__countdown">{{item.custom.countdown}}</text>
            </view>

            <!-- 状态 chips：想跑 ↔ 已报名 点击切换（镜像官方卡）；已结束隐藏 -->
            <view wx:if="{{!item.custom.done}}" class="steps">
              <block wx:for="{{item.custom.steps}}" wx:for-item="s" wx:key="state">
                <view
                  class="steps__chip {{s.on ? 'steps__chip--on' : ''}}"
                  data-key="{{item.key}}"
                  data-state="{{s.state}}"
                  bindtap="onCustomStateTap"
                >{{s.label}}</view>
                <text wx:if="{{index < item.custom.steps.length - 1}}" class="steps__arrow">›</text>
              </block>
              <text class="steps__hint">点状态切换</text>
            </view>

            <view wx:if="{{item.custom.note && !item.custom.done}}" class="plan__note">📝 {{item.custom.note}}</view>
          </view>
        </block>

        <!-- 页脚说明：收藏 ≠ 参赛计划 -->
        <view class="note">收藏 ≠ 参赛计划：收藏但未报名的赛事不会出现在这里，可在赛事中心列表的「收藏」视图查看。带「自定义」角标的是你手动添加的赛历外比赛。</view>
      </block>

      <!-- 空态 -->
      <view wx:elif="{{!plansError}}" class="empty">
        <view class="empty__icon">🗓</view>
        <view class="empty__title">还没有参赛计划</view>
        <view class="empty__hint">去赛事中心收藏心仪赛事，报名后在这里追踪进度</view>
        <view class="empty__btn" bindtap="onGoListTap">去赛事中心逛逛</view>
        <view class="empty__ghost" bindtap="onAddTap">赛事中心没有？手动添加一场</view>
      </view>
    </block>
  </view>

  <!-- 「我的成绩」tab：已跑完的比赛 -->
  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;" wx:else>
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <block wx:else>
      <view wx:if="{{error}}" class="banner banner--error">{{error}}</view>

      <!-- 比赛列表 -->
      <view wx:if="{{rows.length}}" class="card">
        <view class="card__label">{{summary}}</view>
        <view
          wx:for="{{rows}}"
          wx:key="labelId"
          class="race"
          data-id="{{item.labelId}}"
          bindtap="onRaceTap"
        >
          <view class="race__main">
            <view class="race__head">
              <view class="race__band race__band--{{item.bandClass}}">{{item.bandLabel}}</view>
              <view wx:if="{{item.isPb}}" class="race__pb">🏆 PB</view>
              <view class="race__date">{{item.dateLabel}}</view>
            </view>
            <view class="race__name">{{item.name}}</view>
            <view class="race__meta">
              <text>{{item.distanceKm}} km</text>
              <text wx:if="{{item.pace}}" class="race__meta-dot"> · {{item.pace}}</text>
              <text wx:if="{{item.avgHr}}" class="race__meta-dot"> · {{item.avgHr}} bpm</text>
              <text wx:if="{{item.ascent}}" class="race__meta-dot"> · 爬升 {{item.ascent}} m</text>
            </view>
          </view>
          <view class="race__result">
            <view class="race__duration">{{item.duration}}</view>
            <view class="race__duration-label">净成绩</view>
          </view>
        </view>
      </view>

      <!-- 空态 -->
      <view wx:elif="{{!error}}" class="empty-card">
        <view class="empty-card__title">还没有识别到比赛</view>
        <view class="empty-card__sub">同步手表数据后，半马 / 全马比赛会自动出现在这里</view>
      </view>
    </block>
  </view>
</view>
