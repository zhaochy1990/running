/* ============================================================
   活动详情页 —— 深色 STRIDE 主题（与活动列表 / 今日页一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: #07080a;
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 44rpx;
  height: 44rpx;
}

/* 返回箭头：复用 chevron_right，旋转 180° 指向左 */
.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
  max-width: 480rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

.content {
  padding: 0 40rpx calc(60rpx + env(safe-area-inset-bottom));
}

.card {
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 22rpx;
  line-height: 40rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #9c9c9d;
  text-transform: uppercase;
  margin-bottom: 24rpx;
}

/* ---------- 状态卡 ---------- */

.state-card {
  padding: 96rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 4rpx solid rgba(255, 179, 175, 0.3);
  border-top-color: #ffb3af;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.state-card__title {
  font-size: 27rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.state-card__text {
  font-size: 20rpx;
  color: #9c9c9d;
}

.state-card__btn {
  margin-top: 16rpx;
  padding: 16rpx 48rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 999rpx;
  color: #e3e2e5;
  font-size: 22rpx;
}

/* ---------- 头图卡 ---------- */

.header-card__tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 17rpx;
  font-weight: 500;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
}

.tag--sport {
  color: #00e676;
  background: rgba(0, 230, 118, 0.12);
}

.tag--type {
  color: #ff6d00;
  background: rgba(255, 109, 0, 0.12);
}

.header-card__title {
  font-size: 34rpx;
  line-height: 56rpx;
  font-weight: 700;
  color: #e3e2e5;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.header-card__emoji {
  font-size: 27rpx;
}

.header-card__date {
  font-size: 20rpx;
  color: #9c9c9d;
  margin-top: 8rpx;
  font-variant-numeric: tabular-nums;
}

/* ---------- 指标网格 ---------- */

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx 24rpx;
}

.metric {
  flex: 0 0 calc(33.33% - 16rpx);
  min-width: 0;
}

.metric__value {
  font-size: 31rpx;
  font-weight: 700;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.metric__unit {
  font-size: 19rpx;
  font-weight: 400;
  color: #9c9c9d;
  margin-left: 2rpx;
}

.metric__label {
  font-size: 19rpx;
  color: #9c9c9d;
  margin-top: 4rpx;
}

/* ---------- 区间分布 ---------- */

.zone-group-title {
  font-size: 20rpx;
  color: #c3c2c5;
  font-weight: 600;
  margin: 16rpx 0 16rpx;
}

.zone-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.zone-row:last-child {
  margin-bottom: 0;
}

.zone-row__label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 19rpx;
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
}

.zone-row__bar {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.zone-row__fill {
  height: 100%;
  border-radius: 999rpx;
  background: #ffb3af;
}

.zone-row__duration {
  width: 120rpx;
  flex-shrink: 0;
  text-align: right;
  font-size: 19rpx;
  color: #9c9c9d;
  font-variant-numeric: tabular-nums;
}

/* ---------- 分段 / 圈速 ---------- */

.lap-head,
.lap-row {
  display: flex;
  align-items: center;
  padding: 12rpx;
  margin: 0 -12rpx;
  border-radius: 10rpx;
}

.lap-head {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  margin-bottom: 8rpx;
}

.lap-head__cell,
.lap-row__cell {
  flex: 1;
  text-align: center;
  font-size: 19rpx;
  min-width: 0;
}

/* 配速列比其他列宽一点：要放下 “91'36"” + 箭头图标，不让它换行 */
.lap-head__cell--pace,
.lap-row__cell--pace {
  flex: 1.3;
  white-space: nowrap;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 心率列同样留出箭头位；箭头与配速列同尺寸，两列视觉对齐 */
.lap-row__cell--hr {
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 箭头右侧也给固定位，有箭头 / 没箭头的圈，配速都停在同一列 */
.lap-head__cell--pace,
.lap-head__cell--hr {
  padding-right: 26rpx;
  box-sizing: border-box;
}

/* 配速按 `'` 对齐：分钟段定宽右对齐，秒段定宽左对齐 */
.lap-row__pace-mm {
  flex: 0 0 34rpx;
  text-align: right;
}

.lap-row__pace-ss {
  flex: 0 0 36rpx;
  text-align: left;
}

.lap-row__trend-slot {
  flex: 0 0 26rpx;
  display: flex;
  align-items: center;
}

.lap-head__cell {
  color: #9c9c9d;
  font-weight: 500;
}

.lap-row__cell {
  color: #e3e2e5;
  font-variant-numeric: tabular-nums;
}

.lap-head__cell--idx,
.lap-row__cell--idx {
  flex: 0 0 104rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 圈数右侧给徽标留固定位，标记行的圈数不会跟着左右跳 */
.lap-head__cell--idx {
  padding-right: 58rpx;
  box-sizing: border-box;
}

.lap-row__num {
  flex: 0 0 40rpx;
  text-align: center;
}

.lap-row__tag-slot {
  flex: 0 0 58rpx;
  display: flex;
  align-items: center;
}

/* 最快 / 最慢圈：整行底色 + 圈数右侧徽标（黑底胶囊） */
.lap-row--fastest {
  background: rgba(255, 59, 48, 0.18);
}

.lap-row--slowest {
  background: rgba(255, 255, 255, 0.13);
}

/* 恢复圈：灰色底、不计圈号，圈号位置显示「恢复」，配速压暗 */
.lap-row--rest {
  background: rgba(255, 255, 255, 0.05);
}

.lap-row--rest .lap-row__num,
.lap-row--rest .lap-row__pace-mm,
.lap-row--rest .lap-row__pace-ss {
  color: #8a8a8d;
}

.lap-row__tag {
  margin-left: 8rpx;
  padding: 0 10rpx;
  border-radius: 999rpx;
  font-size: 15rpx;
  line-height: 28rpx;
  color: #f4f4f6;
  background: rgba(0, 0, 0, 0.6);
  white-space: nowrap;
  flex-shrink: 0;
}

.lap-row__tag--fastest {
  color: #ff6b6b;
}

/* 配速后的走向箭头：绿 ↗ 变快，红 ↘ 变慢 */
.lap-row__trend {
  width: 20rpx;
  height: 20rpx;
  margin-left: 6rpx;
}

.segment-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}

.segment-row:last-child {
  border-bottom: none;
}

.segment-row__name {
  font-size: 26rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.segment-row__meta {
  font-size: 20rpx;
  color: #9c9c9d;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* ---------- 备注 ---------- */

.note-text {
  font-size: 24rpx;
  line-height: 44rpx;
  color: #d5d4d7;
  white-space: pre-wrap;
}

/* ---------- 天气 ---------- */

.weather-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx 40rpx;
}

.weather-item__label {
  font-size: 17rpx;
  color: #9c9c9d;
  text-transform: uppercase;
  letter-spacing: 1rpx;
}

.weather-item__value {
  font-size: 24rpx;
  color: #e3e2e5;
  margin-top: 4rpx;
}

/* ---------- 轨迹地图 ---------- */

.route-map-wrap {
  position: relative;
}

.route-map {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.map-toggle {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  display: flex;
  background: rgba(16, 17, 18, 0.85);
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  border-radius: 12rpx;
  overflow: hidden;
}

.map-toggle__btn {
  padding: 8rpx 20rpx;
  font-size: 22rpx;
  color: #9c9c9d;
}

.map-toggle__btn--on {
  color: #00a85a;
  background: rgba(0, 168, 90, 0.14);
  font-weight: 600;
}
