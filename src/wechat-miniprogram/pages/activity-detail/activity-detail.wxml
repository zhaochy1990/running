<view class="page">
  <!-- 自定义顶部栏 -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image wx:if="{{canBack}}" class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right.svg" mode="aspectFit" />
        <image wx:else class="top-bar__icon" src="/assets/icons/home.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">{{header.name || '活动详情'}}</view>
        <view wx:if="{{header.dateLabel}}" class="top-bar__subtitle">{{header.dateLabel}}</view>
      </view>
      <!-- 右侧仅保留对称占位，避开微信胶囊 -->
      <view class="top-bar__btn" aria-hidden="true"></view>
    </view>
  </view>

  <!-- 内容 -->
  <view class="content" style="padding-top: {{contentPaddingTop}}rpx;">
    <!-- 加载态 -->
    <view wx:if="{{loading}}" class="state-card">
      <view class="spinner"></view>
      <view class="state-card__text">加载中…</view>
    </view>

    <!-- 未找到 -->
    <view wx:elif="{{notFound}}" class="state-card">
      <view class="state-card__title">未找到该训练记录</view>
      <view class="state-card__text">可能已删除或同步发生错误</view>
      <view class="state-card__btn" bindtap="onBack">返回</view>
    </view>

    <block wx:else>
      <!-- 轨迹地图 -->
      <view wx:if="{{hasMap}}" class="map-card">
        <view class="route-map-wrap">
          <map
            class="route-map"
            latitude="{{mapLatitude}}"
            longitude="{{mapLongitude}}"
            scale="13"
            include-points="{{mapFitPoints}}"
            polyline="{{mapPolylines}}"
            markers="{{mapMarkers}}"
            show-location="{{false}}"
          />
          <view class="map-overlay">
            <view wx:if="{{weather.length}}" class="env-line">
              <view wx:for="{{weather}}" wx:key="key" class="env-item">
                <image class="env-item__icon" src="{{item.icon}}" mode="aspectFit" />
                <text>{{item.value}}</text>
              </view>
            </view>
            <view class="map-toggle">
              <view class="map-toggle__btn {{mapColoring === 'pace' ? 'map-toggle__btn--on' : ''}}" data-coloring="pace" bindtap="onColoringChange">配速</view>
              <view class="map-toggle__btn {{mapColoring === 'hr' ? 'map-toggle__btn--on' : ''}}" data-coloring="hr" bindtap="onColoringChange">HR</view>
              <view class="map-toggle__btn {{mapColoring === 'none' ? 'map-toggle__btn--on' : ''}}" data-coloring="none" bindtap="onColoringChange">无色</view>
            </view>
          </view>
          <button class="map-share" bindtap="onSharePoster" aria-label="分享图片" hover-class="map-share--pressed">
            <view class="map-share__surface">
              <image class="map-share__icon" src="/assets/icons/share-poster-white.svg" mode="aspectFit" />
            </view>
          </button>
        </view>
      </view>
      <!-- 室内等无轨迹的活动也可以生成分享图片 -->
      <view wx:else class="poster-entry">
        <button class="poster-entry__button" bindtap="onSharePoster" aria-label="分享图片" hover-class="poster-entry__button--pressed">
          <image class="poster-entry__icon" src="/assets/icons/share.svg" mode="aspectFit" />
          <text>分享图片</text>
        </button>
      </view>

      <!-- 主指标：距离/配速/心率 + 负荷/时长/最大心率 + 步幅/步频/爬升 一卡三行 -->
      <view wx:if="{{metrics.length}}" class="card">
        <view class="metric-grid">
          <view wx:for="{{metrics}}" wx:key="label" class="metric">
            <view class="metric__value" style="{{item.color ? 'color:' + item.color : ''}}">{{item.value}}<text wx:if="{{item.unit}}" class="metric__unit">{{item.unit}}</text></view>
            <view class="metric__label">{{item.label}}</view>
          </view>
        </view>
      </view>

      <!-- 心率区间 -->
      <view wx:if="{{hrZones.length || hasHrCurve}}" class="card">
        <view class="card-title">心率区间</view>
        <canvas
          wx:if="{{hasHrCurve}}"
          type="2d"
          id="hr-curve"
          class="curve"
          bindtouchstart="onHrCurveTouch"
          bindtouchmove="onHrCurveTouch"
        ></canvas>
        <view wx:for="{{hrZones}}" wx:key="key" class="zone-row">
          <view class="zone-row__label">{{item.label}}</view>
          <view class="zone-row__bar"><view class="zone-row__fill" style="width: {{item.percent}}%; background: {{item.color}};"></view></view>
          <view class="zone-row__duration">{{item.duration}}</view>
        </view>
      </view>

      <!-- 配速区间 -->
      <view wx:if="{{paceZones.length || hasPaceCurve}}" class="card">
        <view class="card-title">配速区间</view>
        <canvas
          wx:if="{{hasPaceCurve}}"
          type="2d"
          id="pace-curve"
          class="curve"
          bindtouchstart="onPaceCurveTouch"
          bindtouchmove="onPaceCurveTouch"
        ></canvas>
        <view wx:for="{{paceZones}}" wx:key="key" class="zone-row">
          <view class="zone-row__label">{{item.label}}</view>
          <view class="zone-row__bar"><view class="zone-row__fill" style="width: {{item.percent}}%; background: {{item.color}};"></view></view>
          <view class="zone-row__duration">{{item.duration}}</view>
        </view>
      </view>

      <!-- 分段 / 圈速 -->
      <view wx:if="{{hasSegments}}" class="card">
        <view class="card-title">{{isStrength ? '动作组' : '分段数据'}}</view>
        <block wx:if="{{!isStrength}}">
          <view class="lap-head">
            <view class="lap-head__cell lap-head__cell--idx">圈数</view>
            <view class="lap-head__cell">时间</view>
            <view class="lap-head__cell">距离</view>
            <view class="lap-head__cell lap-head__cell--pace">平均配速</view>
            <view class="lap-head__cell lap-head__cell--hr">平均心率</view>
            <view class="lap-head__cell">平均步频</view>
          </view>
          <view wx:for="{{laps}}" wx:key="index" class="lap-row {{item.rowClass}}">
            <view class="lap-row__cell lap-row__cell--idx">
              <text class="lap-row__num">{{item.index}}</text>
              <view class="lap-row__tag-slot">
                <text wx:if="{{item.tag}}" class="lap-row__tag {{item.tagClass}}">{{item.tag}}</text>
              </view>
            </view>
            <view class="lap-row__cell">{{item.duration}}</view>
            <view class="lap-row__cell">{{item.distanceKm}}</view>
            <view class="lap-row__cell lap-row__cell--pace">
              <text class="lap-row__pace-mm">{{item.paceMin}}</text>
              <text class="lap-row__pace-ss">{{item.paceSec}}</text>
              <view class="lap-row__trend-slot">
                <image wx:if="{{item.paceTrend}}" class="lap-row__trend" src="/assets/icons/trend_{{item.paceTrend}}.svg" mode="aspectFit" />
              </view>
            </view>
            <view class="lap-row__cell lap-row__cell--hr">
              <text>{{item.hr}}</text>
              <view class="lap-row__trend-slot">
                <image wx:if="{{item.hrTrend}}" class="lap-row__trend" src="/assets/icons/trend_hr_{{item.hrTrend}}.svg" mode="aspectFit" />
              </view>
            </view>
            <view class="lap-row__cell">{{item.cadence}}</view>
          </view>
        </block>
        <block wx:else>
          <view wx:for="{{segments}}" wx:key="key" class="segment-row">
            <view class="segment-row__name">{{item.name}}</view>
            <view class="segment-row__meta">
              <text>{{item.sets}} 组</text>
              <text> · {{item.duration}}</text>
              <text wx:if="{{item.avgHr !== '—'}}"> · {{item.avgHr}} bpm</text>
            </view>
          </view>
        </block>
      </view>

      <!-- 训练反馈 -->
      <view wx:if="{{sportNote || feelNote}}" class="card">
        <view class="card-title">训练反馈{{header.feelEmoji ? ' ' + header.feelEmoji : ''}}</view>
        <view wx:if="{{feelNote}}" class="note-text">{{feelNote}}</view>
        <view wx:if="{{sportNote}}" class="note-text">{{sportNote}}</view>
      </view>

      <!-- 教练简评 -->
      <view wx:if="{{hasCommentary}}" class="card">
        <view class="card-title">教练简评</view>
        <view class="note-text">{{commentary}}</view>
      </view>
    </block>
  </view>

  <!-- 分享海报 canvas（离屏绘制，devops#945；主题/比例由海报弹层选择，devops#947） -->
  <canvas type="2d" id="poster-canvas" class="poster-canvas"></canvas>

  <!-- 分享海报弹层（devops#947）：九色系色卡圆点横滑选择器（偏好持久化）+
       双比例 + 预览大图 / 保存相册 -->
  <view wx:if="{{posterSheetVisible}}" class="poster-sheet-mask" catchtouchmove="noop" bindtap="onPosterClose">
    <view class="poster-sheet" catchtap="noop">
      <view class="poster-sheet__handle"></view>
      <view class="poster-sheet__title">分享海报 · {{posterThemeLabel}}</view>

      <scroll-view scroll-x class="poster-theme-scroll" enhanced show-scrollbar="{{false}}">
        <view class="poster-theme-row">
          <view
            wx:for="{{posterThemeDots}}"
            wx:key="key"
            class="poster-dot {{posterThemeKey === item.key ? 'poster-dot--on' : ''}}"
            data-key="{{item.key}}"
            bindtap="onPosterThemeTap"
          >
            <view class="poster-dot__circle {{item.dark ? 'poster-dot__circle--dark' : ''}}" style="background: linear-gradient(135deg, {{item.colorA}}, {{item.colorB}});"></view>
            <view class="poster-dot__label">{{item.label}}</view>
          </view>
        </view>
      </scroll-view>

      <view class="poster-aspect">
        <view
          wx:for="{{posterPlatforms}}"
          wx:key="aspect"
          class="poster-aspect__btn {{!posterLongImage && posterAspect === item.aspect ? 'poster-aspect__btn--on' : ''}}"
          data-aspect="{{item.aspect}}"
          bindtap="onPosterAspectTap"
        >{{item.label}}</view>
        <view
          class="poster-aspect__btn {{posterLongImage ? 'poster-aspect__btn--on' : ''}}"
          bindtap="onPosterLongImageTap"
        >详情长图</view>
      </view>

      <view class="poster-preview-wrap">
        <image
          wx:if="{{posterPreviewPath}}"
          class="poster-preview"
          src="{{posterPreviewPath}}"
          mode="aspectFit"
          bindtap="onPosterPreviewTap"
        />
        <view wx:else class="poster-preview poster-preview--loading"><view class="spinner"></view></view>
      </view>

      <view class="poster-sheet__actions">
        <view class="poster-sheet__btn" bindtap="onPosterPreviewTap">预览大图</view>
        <view class="poster-sheet__btn poster-sheet__btn--primary" bindtap="onPosterSaveTap">保存到相册</view>
      </view>
    </view>
  </view>
</view>
