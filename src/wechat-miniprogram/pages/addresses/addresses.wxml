<view class="page">
  <!-- 粉渐变顶栏；单选模式标题「可选择地址」 -->
  <view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onBack">
        <image wx:if="{{canBack}}" class="top-bar__icon top-bar__icon--back" src="/assets/icons/chevron_right_white.svg" mode="aspectFit" />
        <image wx:else class="top-bar__icon" src="/assets/icons/home_white.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">{{pickMode ? '选择地址' : '收货地址'}}</view>
      </view>
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <view class="content">
    <view wx:if="{{loading}}" class="page-loading">加载中…</view>

    <view wx:elif="{{loadFailed}}" class="card load-failed">
      <view class="load-failed__txt">地址簿加载失败，请检查网络后重试</view>
      <!-- 纯点击入口用 view 自绘：原生 button 内置样式反压页面类样式 -->
      <view class="load-failed__btn" hover-class="load-failed__btn--hover" bindtap="onRetry">重新加载</view>
    </view>

    <block wx:else>
      <!-- 分节头：标题 + 右侧「＋新建地址」文字链（抖音式，两种模式都给入口） -->
      <!-- hover-class 仅 view/button 支持，文字链一律用 view -->
      <view class="sechead">
        <text class="sechead__title">{{pickMode ? '可选择地址' : '收货地址'}}</text>
        <view class="sechead__add" hover-class="sechead__add--hover" bindtap="onAdd">＋ 新建地址</view>
      </view>

      <!-- 空态 -->
      <view wx:if="{{addresses.length === 0}}" class="empty">
        <view>还没有收货地址</view>
        <view>点右上角「新建地址」添加第一个地址</view>
      </view>

      <view wx:else class="alist">
        <view
          wx:for="{{addresses}}"
          wx:key="id"
          class="acard"
          data-id="{{item.id}}"
          bindtap="onAddressTap"
        >
          <view class="acard__main">
            <view class="acard__body">
              <view class="acard__region">{{item.region}}</view>
              <view class="acard__detail">{{item.detail}}</view>
              <view class="acard__owner">{{item.name}} {{item.phone}}</view>
            </view>
            <!-- 单选模式 radio 放右侧垂直居中（抖音式：内容在左、圆圈在右） -->
            <view wx:if="{{pickMode}}" class="radio {{item.selected ? 'radio--on' : ''}}">
              <text wx:if="{{item.selected}}" class="radio__check">✓</text>
            </view>
          </view>
          <!-- 操作行（抖音式：选择页也带管理操作；catchtap 防误触点卡回传） -->
          <view class="acard__acts" catchtap="onActsTap">
            <view
              wx:if="{{item.isDefault}}"
              class="acard__def acard__def--on"
            >已设为默认</view>
            <view
              wx:else
              class="acard__def"
              data-id="{{item.id}}"
              hover-class="acard__def--hover"
              catchtap="onSetDefault"
            >设为默认</view>
            <view class="acard__spacer"></view>
            <view class="acard__op" data-id="{{item.id}}" hover-class="acard__op--hover" catchtap="onCopy">复制</view>
            <view class="acard__op" data-id="{{item.id}}" hover-class="acard__op--hover" catchtap="onEdit">编辑</view>
            <view class="acard__op" data-id="{{item.id}}" hover-class="acard__op--hover" catchtap="onDelete">删除</view>
          </view>
        </view>
      </view>
    </block>
  </view>

  <!-- 游客态：登录引导弹层（沿用 checkin/profile 游客范式） -->
  <view wx:if="{{guest}}" class="guest-mask">
    <view class="guest-card">
      <view class="guest-card__ic">📍</view>
      <view class="guest-card__h">收货地址</view>
      <view class="guest-card__p">登录后管理你的收货地址</view>
      <view class="guest-card__btn" aria-role="button" hover-class="none" bindtap="onGuestLogin">微信一键登录</view>
    </view>
  </view>
</view>
