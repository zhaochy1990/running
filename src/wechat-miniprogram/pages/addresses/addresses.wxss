/* ============================================================
   地址簿页 —— UI 权威 = devops#852 resolution + 原型
   prototypes/852-redeem-spike.html。像素值按 375 设计稿 ×2 转 rpx；
   主题色走 styles/theme.wxss 令牌，一次性灰阶沿用原型字面量。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 粉渐变顶栏 ---------- */

.nav-wrap {
  background: linear-gradient(170deg, #ff7d6e, var(--color-accent));
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

/* 顶栏返回小房子约定：栈内=返回箭头（白），栈底=小房子，fail 兜底 switchTab coach */
.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-on-accent);
}

.content {
  padding: 28rpx 0 48rpx;
}

.page-loading {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 地址卡 ---------- */

.alist {
  padding: 0 28rpx;
}

.acard {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

/* 单选模式：选中粉描边 */
.acard--sel {
  box-shadow: 0 0 0 4rpx var(--color-accent);
}

.aline1 {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.aline1__n {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.aline1__p {
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.adef {
  font-size: 20rpx;
  background: rgba(var(--color-accent-rgb), 0.08);
  color: var(--color-accent-deep);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

.aaddr {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
  line-height: 1.5;
}

.aacts {
  display: flex;
  gap: 32rpx;
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid var(--color-border-soft);
}

.aacts__pri {
  font-size: 24rpx;
  color: var(--color-accent-deep);
}

.aacts__op {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

/* ---------- 底部虚线新增（原生 button 三坑复位） ---------- */

.addbtn {
  display: block;
  width: calc(100% - 56rpx);
  margin: 8rpx 28rpx 0;
  height: 88rpx;
  padding: 0;
  box-sizing: border-box;
  border: 2rpx dashed var(--color-accent);
  border-radius: 44rpx;
  background: rgba(var(--color-accent-rgb), 0.08);
  color: var(--color-accent-deep);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 84rpx;
  text-align: center;
}

.addbtn::after {
  border: none;
}

/* ---------- 空态 / 加载失败 ---------- */

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.8;
  padding: 120rpx 0;
}

.card {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 32rpx;
  margin: 0 28rpx 24rpx;
}

.load-failed {
  text-align: center;
}

.load-failed__txt {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.load-failed__btn {
  margin: 24rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 40rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.load-failed__btn::after {
  border: none;
}

/* ---------- 游客态登录引导弹层 ---------- */

.guest-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 246, 248, 0.86);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.guest-card {
  background: var(--color-card);
  border-radius: 36rpx;
  padding: 52rpx 48rpx;
  text-align: center;
  width: 540rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.08);
}

.guest-card__ic {
  font-size: 68rpx;
}

.guest-card__h {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 16rpx 0 8rpx;
}

.guest-card__p {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.guest-card__btn {
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.guest-card__btn::after {
  border: none;
}
