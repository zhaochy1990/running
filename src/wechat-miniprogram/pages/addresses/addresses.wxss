/* ============================================================
   地址簿页 —— UI = 抖音商城地址页布局（用户 11-06 拍板）：分节头
   「标题 + ＋新建地址文字链」、卡片「区域灰行 / 详址粗体 / 联系人 /
   分隔线 / 操作行（默认态·编辑·删除）」、单选模式右侧 radio 圆圈。
   保留本 app 粉渐变顶栏与主题令牌；像素按 375 稿 ×2 转 rpx。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 粉渐变顶栏 ---------- */

.nav-wrap {
  background: linear-gradient(170deg, #ff7d6e, var(--color-accent));
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

/* 顶栏返回小房子约定：栈内=返回箭头（白），栈底=小房子，fail 兜底 switchTab coach */
.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-on-accent);
}

.content {
  padding: 8rpx 0 48rpx;
}

.page-loading {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 分节头 ---------- */

.sechead {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx 20rpx;
}

.sechead__title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.sechead__add {
  margin-left: auto;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-accent-deep);
}

.sechead__add--hover {
  opacity: 0.6;
}

/* ---------- 地址卡（抖音式分层：区域/详址/联系人/操作行） ---------- */

.alist {
  padding: 0 28rpx;
}

.acard {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.acard__main {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.acard__body {
  flex: 1;
  min-width: 0;
}

.acard__region {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.5;
}

.acard__detail {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  line-height: 1.5;
  margin-top: 8rpx;
}

.acard__owner {
  font-size: 26rpx;
  color: var(--color-text-primary);
  margin-top: 12rpx;
}

/* 单选模式 radio：右侧垂直居中，选中实心粉圆 + 白勾；
   未选圈用占位灰（border-soft 太浅看不见） */
.radio {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  box-sizing: border-box;
  border: 3rpx solid var(--color-text-tertiary);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.radio--on {
  border-color: var(--color-accent);
  background: var(--color-accent);
}

.radio__check {
  font-size: 24rpx;
  color: var(--color-on-accent);
  line-height: 1;
}

/* 操作行：默认态在左，编辑/删除在右 */
.acard__acts {
  display: flex;
  align-items: center;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border-soft);
}

.acard__def {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.acard__def--on {
  color: var(--color-accent-deep);
}

.acard__def--hover {
  opacity: 0.6;
}

.acard__spacer {
  flex: 1;
}

.acard__op {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-left: 40rpx;
}

.acard__op--hover {
  opacity: 0.6;
}

/* ---------- 空态 / 加载失败 ---------- */

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.8;
  padding: 120rpx 0;
}

.card {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 32rpx;
  margin: 20rpx 28rpx 24rpx;
}

.load-failed {
  text-align: center;
}

.load-failed__txt {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

/* view 自绘按钮：原生 button 内置样式（默认宽/mini inline-block）反压
   页面类样式，纯点击入口一律 view */
.load-failed__btn {
  display: block;
  margin: 24rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
  text-align: center;
}

.load-failed__btn--hover {
  opacity: 0.85;
}

/* ---------- 游客态登录引导弹层 ---------- */

.guest-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 246, 248, 0.86);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.guest-card {
  background: var(--color-card);
  border-radius: 36rpx;
  padding: 52rpx 48rpx;
  text-align: center;
  width: 540rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.08);
}

.guest-card__ic {
  font-size: 68rpx;
}

.guest-card__h {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 16rpx 0 8rpx;
}

.guest-card__p {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.guest-card__btn {
  display: block;
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
  text-align: center;
}
