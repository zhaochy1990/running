<view class="coach">
  <!-- 自定义顶部栏（与 index 页一致：菜单在左，标题居中，右侧为胶囊保留区） -->
  <view class="top-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="top-bar__inner">
      <view class="top-bar__btn" bindtap="onMenuTap">
        <image class="top-bar__icon" src="/assets/icons/menu.svg" mode="aspectFit" />
      </view>
      <view class="top-bar__title-wrap">
        <view class="top-bar__title">教练</view>
        <view class="top-bar__subtitle">AI 训练助手</view>
      </view>
      <!-- 右侧留白给系统胶囊按钮 -->
      <view class="top-bar__btn top-bar__btn--spacer"></view>
    </view>
  </view>

  <!-- 对话区 + 输入栏 -->
  <view class="coach-body" style="padding-top: {{contentPaddingTop}}rpx; {{keyboardPaddedStyle}}">
    <scroll-view class="coach-list" scroll-y scroll-with-animation scroll-into-view="{{scrollIntoId}}">
      <view
        wx:for="{{messages}}"
        wx:key="id"
        id="msg-{{item.id}}"
        class="coach-msg {{item.role === 'user' ? 'coach-msg--user' : 'coach-msg--assistant'}}"
      >
        <view class="coach-msg__bubble">
          <text wx:if="{{item.role === 'user'}}">{{item.content}}</text>
          <mp-html
            wx:else
            content="{{item.html}}"
            containerStyle="{{containerStyle}}"
            tagStyle="{{tagStyle}}"
            selectable="{{true}}"
          />
        </view>
        <view
          wx:if="{{item.role === 'user' && item.failed}}"
          class="coach-msg__retry"
          data-id="{{item.id}}"
          bindtap="onRetry"
        >发送失败，点击重试</view>
      </view>
    </scroll-view>

    <view class="coach-input">
      <input
        class="coach-input__field"
        value="{{input}}"
        placeholder="问问教练…"
        placeholder-class="coach-input__placeholder"
        confirm-type="send"
        adjust-position="{{false}}"
        cursor-spacing="{{16}}"
        bindkeyboardheightchange="onKeyboardHeightChange"
        bindblur="onBlur"
        bindinput="onInput"
        bindconfirm="onSend"
      />
      <view
        class="coach-input__send {{sending ? 'coach-input__send--disabled' : ''}}"
        bindtap="onSend"
      >发送</view>
    </view>
  </view>

  <!-- 会话历史抽屉 -->
  <view wx:if="{{drawerOpen}}" class="drawer-mask" bindtap="onCloseDrawer"></view>
  <view class="drawer {{drawerOpen ? 'drawer--open' : ''}}" catchtap="noop">
    <view class="drawer__header" style="padding-top: calc({{statusBarHeight}}px + 24rpx);">
      <view class="drawer__title">历史对话</view>
    </view>
    <scroll-view scroll-y class="drawer__list">
      <view
        wx:for="{{sessions}}"
        wx:key="id"
        class="drawer__item {{item.id === currentSessionId ? 'drawer__item--active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSelectSession"
      >
        <view class="drawer__item-icon">
          <image class="drawer__item-icon-img" src="/assets/icons/tab_coach_on.svg" mode="aspectFit" />
        </view>
        <text class="drawer__item-title">{{item.title}}</text>
        <text wx:if="{{item.id === currentSessionId}}" class="drawer__item-current">当前</text>
      </view>
      <view wx:if="{{sessions.length === 0}}" class="drawer__empty">还没有对话，点下方新建</view>
    </scroll-view>
    <view class="drawer__footer">
      <view class="drawer__search" bindtap="onSearchTap">
        <image class="drawer__search-icon" src="/assets/icons/search.svg" mode="aspectFit" />
        <text class="drawer__search-placeholder">搜索对话</text>
      </view>
      <view class="drawer__compose" bindtap="onNewConversation">
        <image class="drawer__compose-icon" src="/assets/icons/compose.svg" mode="aspectFit" />
      </view>
    </view>
  </view>
</view>
