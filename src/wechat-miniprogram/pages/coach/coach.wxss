/* ============================================================
   教练页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.coach {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #07080a;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- 对话主体 ---------- */

.coach-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.coach-list {
  flex: 1;
  min-height: 0;
  padding: 32rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.coach-msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.coach-msg--assistant {
  align-items: flex-start;
}

.coach-msg--user {
  align-items: flex-end;
}

.coach-msg__retry {
  margin-top: 12rpx;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #ffb3af;
  background: rgba(255, 99, 99, 0.12);
  border: 1rpx solid rgba(255, 99, 99, 0.4);
}

.coach-msg__bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #e3e2e5;
  word-break: break-word;
}

.coach-msg--assistant .coach-msg__bubble {
  background: #1b1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-top-left-radius: 8rpx;
}

.coach-msg--user .coach-msg__bubble {
  background: #ff6363;
  color: #101111;
  font-weight: 500;
  border-top-right-radius: 8rpx;
}

/* ---------- 输入栏 ---------- */

.coach-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.coach-input__field {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #1b1c1e;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #e3e2e5;
}

.coach-input__placeholder {
  color: #7a7a7b;
}

.coach-input__send {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff6363;
  color: #101111;
  font-size: 24rpx;
  font-weight: 600;
}

.coach-input__send--disabled {
  opacity: 0.6;
}

/* ---------- 会话历史抽屉 ---------- */

.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 98;
  background: rgba(0, 0, 0, 0.55);
}

.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  width: 640rpx;
  background: #121316;
  border-right: 1rpx solid rgba(255, 255, 255, 0.06);
  transform: translateX(-100%);
  transition: transform 0.28s ease;
  display: flex;
  flex-direction: column;
}

.drawer--open {
  transform: translateX(0);
}

.drawer__header {
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
}

.drawer__footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.drawer__search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #1b1c1e;
  border-radius: 36rpx;
}

.drawer__search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.drawer__search-placeholder {
  font-size: 24rpx;
  color: #7a7a7b;
}

.drawer__compose {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
}

.drawer__compose-icon {
  width: 44rpx;
  height: 44rpx;
}

.drawer__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.drawer__list {
  flex: 1;
  min-height: 0;
  padding: 16rpx 0;
}

.drawer__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.drawer__item--active {
  background: rgba(255, 99, 99, 0.08);
}

.drawer__item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1b1c1e;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drawer__item-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.drawer__item-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #e3e2e5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drawer__item-current {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ffb3af;
  border: 1rpx solid rgba(255, 179, 175, 0.4);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.drawer__empty {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7a7a7b;
}
