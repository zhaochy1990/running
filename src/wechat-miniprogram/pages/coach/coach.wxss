/* ============================================================
   教练页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.coach {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #07080a;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 40rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 24rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- 对话主体 ---------- */

.coach-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.coach-list {
  flex: 1;
  min-height: 0;
  padding: 32rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.coach-msg {
  display: flex;
  margin-bottom: 20rpx;
}

.coach-msg--assistant {
  justify-content: flex-start;
}

.coach-msg--user {
  justify-content: flex-end;
}

.coach-msg__bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 40rpx;
  color: #e3e2e5;
  word-break: break-word;
}

.coach-msg--assistant .coach-msg__bubble {
  background: #1b1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-top-left-radius: 8rpx;
}

.coach-msg--user .coach-msg__bubble {
  background: #ff6363;
  color: #101111;
  font-weight: 500;
  border-top-right-radius: 8rpx;
}

/* ---------- 输入栏 ---------- */

.coach-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.coach-input__field {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #1b1c1e;
  border-radius: 36rpx;
  font-size: 28rpx;
  color: #e3e2e5;
}

.coach-input__placeholder {
  color: #7a7a7b;
}

.coach-input__send {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff6363;
  color: #101111;
  font-size: 28rpx;
  font-weight: 600;
}

.coach-input__send--disabled {
  opacity: 0.6;
}
