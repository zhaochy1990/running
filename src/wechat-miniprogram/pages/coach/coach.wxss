/* ============================================================
   教练页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.coach {
  height: 100vh;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: #07080a;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: #07080a;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: #ffb3af;
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(225, 191, 188, 0.8);
}

/* ---------- 对话主体 ---------- */

.coach-body {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.coach-context-hint {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin: 0 32rpx 8rpx;
  padding: 12rpx 12rpx 12rpx 20rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  line-height: 34rpx;
  color: #ffb3af;
  background: rgba(255, 99, 99, 0.08);
  border: 1rpx solid rgba(255, 99, 99, 0.25);
}

.coach-context-hint__text {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.coach-context-hint__close {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 99, 99, 0.12);
  border: 1rpx solid rgba(255, 99, 99, 0.3);
}

.coach-context-hint__close-icon {
  font-size: 30rpx;
  line-height: 44rpx;
  color: #ffb3af;
}

.coach-list {
  flex: 1;
  min-height: 0;
  padding: 32rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.coach-msg {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
}

.coach-msg--assistant {
  align-items: flex-start;
}

.coach-msg--user {
  align-items: flex-end;
}

.coach-msg__retry {
  margin-top: 12rpx;
  padding: 8rpx 26rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 32rpx;
  color: #ffb3af;
  background: rgba(255, 99, 99, 0.12);
  border: 1rpx solid rgba(255, 99, 99, 0.4);
}

.coach-msg__bubble {
  max-width: 82%;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  line-height: 40rpx;
  color: #e3e2e5;
  word-break: break-word;
}

.coach-msg--assistant .coach-msg__bubble {
  background: #1b1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-top-left-radius: 8rpx;
}

.coach-msg--user .coach-msg__bubble {
  background: #ff6363;
  color: #101111;
  font-weight: 500;
  border-top-right-radius: 8rpx;
}

/* ---------- 思考中指示 ---------- */

.coach-msg__thinking {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.coach-msg__thinking-text {
  font-size: 24rpx;
  color: #8a8a8e;
}

.think-dots {
  display: flex;
  gap: 8rpx;
}

.think-dot {
  width: 9rpx;
  height: 9rpx;
  border-radius: 50%;
  background: #8a8a8e;
  animation: think-blink 1.2s infinite ease-in-out;
}

.think-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.think-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes think-blink {
  0%,
  80%,
  100% {
    opacity: 0.25;
  }
  40% {
    opacity: 1;
  }
}

/* ---------- 流式回复 ---------- */

.coach-msg__streaming {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  min-width: 132rpx;
}

.coach-msg__phase {
  font-size: 22rpx;
  line-height: 30rpx;
  color: #ffb3af;
}

.coach-msg__stream-text-wrap {
  display: flex;
  align-items: baseline;
  gap: 3rpx;
}

.coach-msg__stream-text {
  white-space: pre-wrap;
  word-break: break-word;
}

.coach-stream-cursor {
  width: 3rpx;
  height: 28rpx;
  background: #ffb3af;
  animation: cursor-blink 0.8s infinite ease-in-out;
}

@keyframes cursor-blink {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0;
  }
}

/* ---------- 输入栏 ---------- */

.coach-input {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 32rpx;
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
}

.coach-input__field {
  flex: 1;
  height: 72rpx;
  padding: 0 24rpx;
  background: #1b1c1e;
  border-radius: 36rpx;
  font-size: 24rpx;
  color: #e3e2e5;
}

.coach-input__placeholder {
  color: #7a7a7b;
}

.coach-input__send {
  flex-shrink: 0;
  height: 72rpx;
  padding: 0 32rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #ff6363;
  color: #101111;
  font-size: 24rpx;
  font-weight: 600;
}

.coach-input__send--disabled {
  opacity: 0.6;
}

/* ---------- 会话历史抽屉 ---------- */

.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 98;
  background: rgba(0, 0, 0, 0.55);
}

.drawer {
  position: fixed;
  top: 0;
  bottom: 0;
  left: 0;
  z-index: 99;
  width: 640rpx;
  background: #121316;
  border-right: 1rpx solid rgba(255, 255, 255, 0.06);
  transform: translateX(-100%);
  transition: transform 0.28s ease;
  display: flex;
  flex-direction: column;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.drawer--open {
  transform: translateX(0);
}

.drawer__header {
  padding: 24rpx 32rpx;
  padding-bottom: 8rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.drawer__footer {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
  background: #121316;
  border-top: 1rpx solid rgba(255, 255, 255, 0.06);
  flex-shrink: 0;
}

.drawer__search {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
  height: 72rpx;
  padding: 0 24rpx;
  background: #1b1c1e;
  border-radius: 36rpx;
}

.drawer__search-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.drawer__search-placeholder {
  font-size: 24rpx;
  color: #7a7a7b;
}

.drawer__compose {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border-radius: 50%;
}

.drawer__compose-icon {
  width: 44rpx;
  height: 44rpx;
}

.drawer__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.drawer__list {
  flex: 1;
  height: 0;
  min-height: 0;
  padding: 16rpx 0;
}

.drawer__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 32rpx;
}

.drawer__item--active {
  background: rgba(255, 99, 99, 0.08);
}

.drawer__item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #1b1c1e;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.drawer__item-icon-img {
  width: 32rpx;
  height: 32rpx;
}

.drawer__item-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  color: #e3e2e5;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.drawer__item-current {
  flex-shrink: 0;
  font-size: 20rpx;
  color: #ffb3af;
  border: 1rpx solid rgba(255, 179, 175, 0.4);
  border-radius: 999rpx;
  padding: 4rpx 16rpx;
}

.drawer__empty {
  padding: 64rpx 32rpx;
  text-align: center;
  font-size: 24rpx;
  color: #7a7a7b;
}

/* ---------- 计划提案 / 计划任务卡片 ---------- */

.coach-card {
  max-width: 82%;
  min-width: 480rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #1b1c1e;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-top-left-radius: 8rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.coach-card__title {
  font-size: 26rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.coach-card__summary {
  font-size: 24rpx;
  line-height: 36rpx;
  color: #b8b8bc;
  word-break: break-word;
}

.coach-card__stage {
  font-size: 24rpx;
  color: #e3e2e5;
}

.coach-card__stage--error {
  color: #ffb3af;
}

.coach-card__pct {
  font-size: 22rpx;
  color: #8a8a8e;
}

.coach-card__progress {
  height: 12rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.08);
  overflow: hidden;
}

.coach-card__progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff6363, #ff9a6b);
  transition: width 0.3s ease;
}

.coach-card__primary {
  align-self: flex-start;
  padding: 14rpx 40rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #101111;
  background: #ff6363;
}

.coach-card__primary--disabled {
  opacity: 0.5;
}

.coach-card__actions {
  display: flex;
  gap: 16rpx;
}

.coach-card__action {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #e3e2e5;
  background: rgba(255, 255, 255, 0.08);
  border: 1rpx solid rgba(255, 255, 255, 0.12);
}

.coach-card__action--primary {
  color: #101111;
  background: #ff6363;
  border-color: transparent;
}

.coach-card__action--disabled {
  opacity: 0.5;
}
