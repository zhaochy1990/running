/* 自定义比赛表单页 —— 深色令牌与 my-races 页一致（#07080a / #101111 / #ff6363）。 */

page {
  background: #07080a;
}

.form {
  padding: 24rpx 32rpx 64rpx;
}

.sec {
  margin: 40rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #b9b8bc;
}

.sec:first-child {
  margin-top: 8rpx;
}

.opt {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: #6a6a6c;
}

.field {
  box-sizing: border-box;
  width: 100%;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #e8e8ea;
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 18rpx;
}

.field--ph {
  color: #6a6a6c;
}

.field--gap {
  margin-top: 16rpx;
}

.field--area {
  margin-top: 16rpx;
  min-height: 120rpx;
  line-height: 40rpx;
}

.ph {
  color: #6a6a6c;
}

.hint {
  margin: 10rpx 4rpx 0;
  font-size: 20rpx;
  line-height: 32rpx;
  color: #6a6a6c;
}

.req {
  color: #ff8f8f;
}

/* 越野 D+ 建议：主题藕粉高亮 */
.hint--hl {
  color: #ff8f8f;
  background: rgba(255, 99, 99, 0.08);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

/* 类型 chips（七值，默认越野跑） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: #8a8f99;
  background: #17181a;
  border-radius: 28rpx;
}

.chip--on {
  background: #ff6363;
  color: #ffffff;
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.row2 .field {
  flex: 1;
  min-width: 0;
}

/* 参赛状态 seg：想跑 / 已报名 二选一 */
.seg {
  display: flex;
  gap: 16rpx;
}

.seg__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #9c9c9d;
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 18rpx;
}

.seg__item--on {
  color: #ffffff;
  border-color: #ff6363;
  background: rgba(255, 99, 99, 0.12);
  font-weight: 600;
}

/* 保存按钮：主题藕粉，与空态 CTA 同族 */
.save {
  margin-top: 56rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
  background: #ff6363;
  border-radius: 40rpx;
}

.save[disabled] {
  opacity: 0.6;
  color: #ffffff;
  background: #ff6363;
}
