/* 自定义比赛表单页 —— 主题令牌由 styles/theme.wxss 唯一定义（#816）。 */

page {
  background: var(--color-bg);
}

.form {
  padding: 24rpx 32rpx 64rpx;
}

.sec {
  margin: 40rpx 4rpx 16rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--color-text-bright);
}

.sec:first-child {
  margin-top: 8rpx;
}

.opt {
  margin-left: 8rpx;
  font-size: 20rpx;
  font-weight: 400;
  color: var(--color-text-tertiary);
}

/* 原生 input 的纵向 padding 不参与内容盒：统一定高 + 水平 padding，
   行高与高度一致让文字/占位符垂直居中（仓内同 profile-edit 的显式高度做法） */
.field {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  color: var(--color-field-text);
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 18rpx;
}

.field--ph {
  color: var(--color-text-tertiary);
}

.field--gap {
  margin-top: 16rpx;
}

.field--area {
  height: auto;
  margin-top: 16rpx;
  min-height: 120rpx;
  padding: 20rpx 24rpx;
  line-height: 40rpx;
}

.ph {
  color: var(--color-text-tertiary);
}

.hint {
  margin: 10rpx 4rpx 0;
  font-size: 20rpx;
  line-height: 32rpx;
  color: var(--color-text-tertiary);
}

.req {
  color: var(--color-accent-light);
}

/* 越野 D+ 建议：主题藕粉高亮 */
.hint--hl {
  color: var(--color-accent-light);
  background: rgba(var(--color-accent-rgb), 0.08);
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
}

/* 类型 chips（七值，默认越野跑） */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}

.chip {
  padding: 10rpx 26rpx;
  font-size: 24rpx;
  color: var(--color-text-cool);
  background: var(--color-chip);
  border-radius: 28rpx;
}

.chip--on {
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-weight: 600;
}

.row2 {
  display: flex;
  gap: 16rpx;
  margin-top: 16rpx;
}

.row2 .field {
  flex: 1;
  min-width: 0;
}

/* 参赛状态 seg：想跑 / 已报名 二选一 */
.seg {
  display: flex;
  gap: 16rpx;
}

.seg__item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.1);
  border-radius: 18rpx;
}

.seg__item--on {
  color: var(--color-accent-deep);
  border-color: var(--color-accent);
  background: var(--color-accent-tint);
  font-weight: 600;
}

/* 保存按钮：主题藕粉，与空态 CTA 同族 */
.save {
  margin-top: 56rpx;
  padding: 22rpx 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-on-accent);
  background: var(--color-accent);
  border-radius: 40rpx;
}

.save[disabled] {
  opacity: 0.6;
  color: var(--color-on-accent);
  background: var(--color-accent);
}
