/* ============================================================
   我的页 —— 深色 STRIDE 主题（与 today.html / login 一致）
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
  display: flex;
  flex-direction: column;
}

.top-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  background: var(--color-bg);
  border-bottom: 1rpx solid var(--color-border-soft);
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  line-height: 48rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  color: var(--color-accent-pale);
}

.top-bar__subtitle {
  font-size: 20rpx;
  line-height: 32rpx;
  color: rgba(var(--color-header-meta-rgb), 0.8);
}

.content {
  padding: 0 0 48rpx;
}

.card {
  background: var(--color-card);
  border-radius: 0;
  padding: 32rpx;
  margin-bottom: 48rpx;
}

/* ---------- 头像资料 ---------- */

.profile-card {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: rgba(var(--color-overlay-rgb), 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  flex-shrink: 0;
}

.profile-avatar__img {
  width: 128rpx;
  height: 128rpx;
}

.profile-avatar__placeholder {
  width: 64rpx;
  height: 64rpx;
}

.profile-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.profile-info__name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--color-text-primary);
}

.profile-info__email {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-info__tag {
  align-self: flex-start;
  font-size: 17rpx;
  color: var(--color-accent);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: rgba(var(--color-accent-rgb), 0.1);
}

.profile-chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}

/* ---------- 菜单 ---------- */

.menu-card {
  padding: 8rpx 0;
}

.menu-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 28rpx 32rpx 28rpx 48rpx;
  border-bottom: 1rpx solid rgba(var(--color-overlay-rgb), 0.04);
}

.menu-row:last-child {
  border-bottom: none;
}

.menu-row__icon {
  width: 44rpx;
  height: 44rpx;
  flex-shrink: 0;
}

.menu-row__title {
  flex: 1;
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.menu-row__body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.menu-row__body .menu-row__title {
  flex: none;
}

.menu-row__subtitle {
  font-size: 19rpx;
  line-height: 1.4;
  color: var(--color-text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-row__chevron {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

/* 意见反馈入口红点（total_unread，99+ 截断） */
.menu-row__badge {
  min-width: 32rpx;
  height: 32rpx;
  box-sizing: border-box;
  padding: 0 10rpx;
  border-radius: 16rpx;
  background: #ff5f5f;
  color: var(--color-on-accent);
  font-size: 20rpx;
  line-height: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.menu-row--disabled {
  opacity: 0.6;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.menu-row__icon--spin {
  animation: spin 1.2s linear infinite;
}
