/* ============================================================
   我的兑换页 —— UI 权威 = devops#852 resolution + 原型
   prototypes/852-redeem-spike.html。像素值按 375 设计稿 ×2 转 rpx；
   状态 chip 两色为 #852 定稿字面量（橙 #f5a623 / 绿 #34b47a），
   其余主题色走 styles/theme.wxss 令牌。
   ============================================================ */

.page {
  min-height: 100vh;
  box-sizing: border-box;
  background: var(--color-bg);
}

/* ---------- 粉渐变顶栏 ---------- */

.nav-wrap {
  background: linear-gradient(170deg, #ff7d6e, var(--color-accent));
}

.top-bar__inner {
  height: 128rpx;
  display: flex;
  align-items: center;
  padding: 0 40rpx;
}

.top-bar__btn {
  width: 88rpx;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.top-bar__btn--spacer {
  width: 88rpx;
}

.top-bar__icon {
  width: 48rpx;
  height: 48rpx;
}

/* 顶栏返回小房子约定：栈内=返回箭头（白），栈底=小房子，fail 兜底 switchTab coach */
.top-bar__icon--back {
  transform: rotate(180deg);
}

.top-bar__title-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.top-bar__title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--color-on-accent);
}

.content {
  padding: 28rpx 0 48rpx;
}

.page-loading {
  padding: 64rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

/* ---------- 订单卡（无边框白卡约定） ---------- */

.olist {
  padding: 0 28rpx;
}

.ocard {
  background: var(--color-card);
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}

.otop {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.otop__no {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

/* 两态 chip：#852 定稿字面量（橙待发货 #f5a623 / 绿已发货 #34b47a） */
.ost {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.ost--pending {
  background: #fff4e3;
  color: #f5a623;
}

.ost--shipped {
  background: #e6f4ee;
  color: #34b47a;
}

.obody {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
  align-items: center;
}

.obody__img {
  width: 104rpx;
  height: 104rpx;
  border-radius: 20rpx;
  background: #ffe9e6;
  flex: none;
}

.obody__tx {
  flex: 1;
  min-width: 0;
}

.obody__n {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.obody__m {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.obody__cost {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--color-accent);
  flex: none;
}

/* 已发货运单号行：虚线分隔 + 整行点按复制 */

.otrack {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 2rpx dashed #f0f0f3;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.otrack__no {
  color: var(--color-text-primary);
  font-weight: 600;
}

.otrack__copy {
  color: var(--color-accent-deep);
}

/* ---------- 分页脚注 ---------- */

.more {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  padding: 16rpx 0 8rpx;
}

/* ---------- 空态 / 加载失败 ---------- */

.empty {
  text-align: center;
  color: var(--color-text-secondary);
  font-size: 26rpx;
  line-height: 1.8;
  padding: 120rpx 0;
}

.load-failed {
  margin: 0 28rpx;
  text-align: center;
}

.load-failed__txt {
  font-size: 26rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
}

.load-failed__btn {
  margin: 24rpx auto 0;
  width: 320rpx;
  height: 80rpx;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 40rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 28rpx;
  font-weight: 600;
  line-height: 80rpx;
}

.load-failed__btn::after {
  border: none;
}

/* ---------- 游客态登录引导弹层 ---------- */

.guest-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(246, 246, 248, 0.86);
  backdrop-filter: blur(6rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 20;
}

.guest-card {
  background: var(--color-card);
  border-radius: 36rpx;
  padding: 52rpx 48rpx;
  text-align: center;
  width: 540rpx;
  box-shadow: 0 16rpx 60rpx rgba(0, 0, 0, 0.08);
}

.guest-card__ic {
  font-size: 68rpx;
}

.guest-card__h {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin: 16rpx 0 8rpx;
}

.guest-card__p {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.6;
  margin-bottom: 28rpx;
}

.guest-card__btn {
  width: 100%;
  height: 92rpx;
  padding: 0;
  box-sizing: border-box;
  border: none;
  border-radius: 46rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 32rpx;
  font-weight: 600;
  line-height: 92rpx;
}

.guest-card__btn::after {
  border: none;
}
