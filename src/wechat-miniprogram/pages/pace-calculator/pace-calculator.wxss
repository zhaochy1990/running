.calculator {
  box-sizing: border-box;
  padding: 24rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
  font-size: 28rpx;
}

.calculator button,
.card-dialog button {
  box-sizing: border-box;
  margin: 0;
  line-height: 1.25;
  font-size: 26rpx;
}

.calculator button::after,
.card-dialog button::after {
  border: 0;
}

.tabs {
  display: flex;
  gap: 6rpx;
  padding: 6rpx;
  border-radius: 18rpx;
  background: var(--color-bg-sunken);
}

.tabs .tab {
  flex: 1;
  min-width: 0;
  min-height: 68rpx;
  padding: 12rpx 6rpx;
  border-radius: 14rpx;
  color: var(--color-text-secondary);
  background: transparent;
  font-weight: 600;
}

.tabs .active {
  color: var(--color-accent-deep);
  background: var(--color-card);
}

.panel {
  margin-top: 20rpx;
  padding: 24rpx;
  border: 1rpx solid var(--color-border-soft);
  border-radius: 22rpx;
  background: var(--color-card);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.hint,
.row-note {
  margin-top: 10rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.field-label {
  margin: 18rpx 0 8rpx;
  color: var(--color-text-secondary);
  font-size: 24rpx;
}

.field {
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  padding: 0 14rpx;
  border: 1rpx solid var(--color-hairline);
  border-radius: 12rpx;
  background: var(--color-bg);
  color: var(--color-field-text);
  line-height: 72rpx;
}

.select {
  display: flex;
  justify-content: space-between;
  margin-top: 16rpx;
}

.select text,
.read-only {
  color: var(--color-text-secondary);
}

.chips,
.actions,
.template-error {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 14rpx;
  align-items: center;
}

.chips .chip {
  flex: 0 0 auto;
  width: auto;
  padding: 14rpx 17rpx;
  border-radius: 12rpx;
  background: var(--color-chip);
  color: var(--color-text-bright);
}

.chips .selected,
.secondary {
  color: var(--color-accent-deep);
  background: var(--color-accent-tint);
}

.calculator .secondary,
.card-dialog .secondary,
.calculator .primary,
.card-dialog .primary {
  min-height: 72rpx;
  padding: 14rpx 22rpx;
  border-radius: 14rpx;
  font-weight: 600;
}

.panel > .secondary,
.calculator > .primary {
  width: 100%;
  margin-top: 16rpx;
}

.primary {
  color: var(--color-on-accent);
  background: var(--color-accent-deep);
}

.actions button {
  flex: 1;
  min-width: 0;
  padding-right: 6rpx;
  padding-left: 6rpx;
}

.calculator button[disabled],
.card-dialog button[disabled] {
  opacity: 0.55;
}

.template-error {
  justify-content: space-between;
}

.segment,
.favorite {
  margin-top: 16rpx;
  padding-top: 14rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.segment-header,
.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 600;
}

.segment-fields,
.metrics {
  display: flex;
  gap: 10rpx;
}

.field-wrap,
.metric {
  flex: 1;
  min-width: 0;
}

.calculator .text-action,
.card-dialog .text-action {
  padding: 12rpx 6rpx;
  color: var(--color-accent-deep);
  background: transparent;
}

.calculator .destructive,
.error {
  color: var(--color-danger);
}

.error {
  margin-top: 18rpx;
  font-size: 25rpx;
}

.metrics {
  margin-top: 18rpx;
}

.metric {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 14rpx 8rpx;
  border-radius: 12rpx;
  background: var(--color-bg-sunken);
  font-size: 24rpx;
  text-align: center;
}

.metric text:first-child {
  color: var(--color-text-secondary);
}

.metric text:last-child {
  font-weight: 700;
  overflow-wrap: anywhere;
}

.metric.emphasis {
  background: var(--color-accent-tint);
  color: var(--color-accent-deep);
}

.split-tabs,
.table {
  margin-top: 18rpx;
}

.table-entry {
  border-top: 1rpx solid var(--color-border-soft);
}

.table-row {
  display: grid;
  grid-template-columns: minmax(0, 1.15fr) repeat(3, minmax(0, 1fr));
  align-items: center;
  gap: 4rpx;
  padding: 14rpx 0;
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.table-row text {
  overflow-wrap: anywhere;
}

.table-row text:not(:first-child) {
  text-align: right;
}

.table-head {
  color: var(--color-text-secondary);
  font-weight: 600;
}

.row-note {
  margin-top: 0;
  padding-bottom: 12rpx;
}

.favorites-toggle {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  padding: 0;
  min-height: 48rpx;
  color: var(--color-text-primary);
  background: transparent;
  font-weight: 700;
}

.favorites-toggle text:last-child {
  color: var(--color-accent-deep);
  font-weight: 500;
}

.favorite-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.favorite-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
  overflow-wrap: anywhere;
}

.favorite-name {
  font-weight: 600;
}

.shade {
  position: fixed;
  z-index: 5;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(var(--color-overlay-rgb), 0.5);
}

.card-dialog {
  display: flex;
  flex-direction: column;
  width: 650rpx;
  max-width: 92vw;
  height: 82vh;
  max-height: 1180rpx;
  box-sizing: border-box;
  overflow: hidden;
  border-radius: 22rpx;
  color: var(--color-text-primary);
  background: var(--color-card);
}

.card-header,
.card-actions {
  flex: 0 0 auto;
  padding: 12rpx 24rpx;
}

.card-scroll {
  flex: 1 1 auto;
  min-height: 0;
  height: 0;
}

.card-content {
  padding: 0 24rpx 24rpx;
}

.card-actions {
  margin-top: 0;
  padding-top: 16rpx;
  padding-bottom: 20rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.card-header .text-action,
.card-actions .secondary,
.card-actions .primary {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 84rpx;
}

.card-header .text-action {
  width: auto;
  padding-right: 0;
  padding-left: 20rpx;
}

.card-preview {
  display: block;
  width: 100%;
  border-radius: 12rpx;
}

.pace-canvas {
  position: fixed;
  left: -9999px;
  top: 0;
  width: 1px;
  height: 1px;
}

.terrain {
  display: inline-block;
  margin-right: 8rpx;
  padding: 0 8rpx;
  border-radius: 6rpx;
  background: var(--color-bg-sunken);
  color: var(--color-text-bright);
}

.calculator .favorite-detail {
  text-align: left;
}
