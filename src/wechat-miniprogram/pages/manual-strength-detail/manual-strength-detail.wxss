page {
  background: var(--color-bg);
}

.strength-detail {
  box-sizing: border-box;
  padding: var(--spacing-lg) var(--spacing-lg) calc(160rpx + env(safe-area-inset-bottom));
  color: var(--color-text-primary);
}

.detail-status {
  display: grid;
  justify-items: center;
  gap: var(--spacing-sm);
  padding: 60rpx var(--spacing-md);
  color: var(--color-text-secondary);
}

.strength-detail .detail-retry,
.strength-detail .detail-edit {
  box-sizing: border-box;
  margin: 0;
  background: var(--color-card);
  color: var(--color-text-primary);
  font-size: var(--font-size-md);
  border: 2rpx solid var(--color-hairline);
  border-radius: var(--radius-lg);
}

.detail-retry::after,
.detail-edit::after,
.detail-delete::after,
.detail-coach::after {
  border: 0;
}

.detail-summary {
  padding-bottom: var(--spacing-md);
  border-bottom: 2rpx solid var(--color-hairline);
}

.detail-summary-header {
  display: grid;
  grid-template-columns: minmax(0, 1fr) auto;
  align-items: start;
  gap: var(--spacing-sm);
}

.strength-detail button.detail-delete {
  margin: 0;
  width: auto;
  min-width: 0;
  padding: var(--spacing-xs) var(--spacing-sm);
  min-height: 88rpx;
  background: transparent;
  color: var(--color-danger);
  font-size: var(--font-size-sm);
  line-height: 1.4;
}

.detail-title {
  overflow-wrap: anywhere;
  font-size: var(--font-size-2xl);
  font-weight: var(--font-weight-bold);
  line-height: 1.25;
}

.detail-time,
.detail-meta,
.detail-set-number {
  color: var(--color-text-secondary);
  font-size: var(--font-size-sm);
}

.detail-time {
  margin-top: var(--spacing-xs);
}

.detail-heading {
  margin-bottom: var(--spacing-xs);
  overflow-wrap: anywhere;
  font-size: var(--font-size-lg);
  font-weight: var(--font-weight-bold);
}

.detail-action,
.detail-note-section {
  padding: var(--spacing-md) 0;
}

.detail-action {
  border-bottom: 2rpx solid var(--color-hairline);
}

.detail-set {
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  align-items: baseline;
  gap: var(--spacing-md);
  padding: var(--spacing-xs) 0;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
}

.detail-set-value {
  overflow-wrap: anywhere;
  font-size: var(--font-size-md);
}

.detail-note {
  white-space: pre-wrap;
  overflow-wrap: anywhere;
  color: var(--color-text-secondary);
  line-height: 1.65;
  font-size: var(--font-size-sm);
}

.detail-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: var(--spacing-sm) var(--spacing-lg) calc(var(--spacing-sm) + env(safe-area-inset-bottom));
  border-top: 2rpx solid var(--color-hairline);
  background: var(--color-card);
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
  gap: var(--spacing-xs);
}

.strength-detail button.detail-edit,
.strength-detail button.detail-coach {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  padding: 0;
  margin: 0;
  min-height: 92rpx;
  font-size: var(--font-size-md);
  font-weight: var(--font-weight-bold);
  line-height: 1.4;
}

.detail-coach {
  background: var(--color-accent);
  color: var(--color-on-accent);
  border: 2rpx solid transparent;
  border-radius: var(--radius-lg);
}
