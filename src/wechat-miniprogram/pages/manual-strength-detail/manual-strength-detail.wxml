<view class="strength-detail">
  <view wx:if="{{loading}}" class="detail-status">加载中…</view>
  <view wx:elif="{{error}}" class="detail-status">
    <view>{{error}}</view>
    <button wx:if="{{canRetry}}" class="detail-retry" bindtap="load">重新加载</button>
  </view>
  <block wx:elif="{{record}}">
    <view class="detail-summary">
      <view class="detail-summary-header">
        <view class="detail-title">{{record.name}}</view>
        <button class="detail-delete" bindtap="onDelete" disabled="{{deleting}}">删除记录</button>
      </view>
      <view class="detail-time">{{timeLabel}}</view>
      <view class="detail-meta">{{summaryLabel}}</view>
    </view>
    <view wx:for="{{actionRows}}" wx:for-item="action" wx:key="key" class="detail-action">
      <view class="detail-heading">{{action.name}}</view>
      <view wx:for="{{action.sets}}" wx:for-item="set" wx:key="number" class="detail-set">
        <text class="detail-set-number">第 {{set.number}} 组</text>
        <text class="detail-set-value">{{set.label}}</text>
      </view>
    </view>
    <view wx:if="{{record.note}}" class="detail-note-section">
      <view class="detail-heading">训练备注</view>
      <view class="detail-note">{{record.note}}</view>
    </view>
    <view class="detail-footer">
      <button class="detail-edit" bindtap="onEdit" disabled="{{deleting}}">编辑记录</button>
      <button class="detail-coach" bindtap="onCoachReview" disabled="{{deleting}}">和教练聊一聊</button>
    </view>
  </block>
</view>
