/* 推送日期选择底部弹层 —— 主题令牌（devops#818 P3：选中态由深色时代
   青蓝 #3fd2ff 收敛到 accent 族，选中语义与 detail 页 .sheet__opt--on
   （--color-accent）对齐；文字在浅衬底上统一用 accent-deep 阶）。 */

.sheet-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--color-chip);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: sheet-up 0.2s ease;
}

@keyframes sheet-up {
  from {
    transform: translateY(100%);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(var(--color-overlay-rgb), 0.2);
  margin: 0 auto 24rpx;
}

.sheet__title {
  font-size: 27rpx;
  line-height: 44rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 24rpx;
}

.sheet__list {
  max-height: 560rpx;
}

.sheet__item {
  padding: 28rpx 24rpx;
  border-radius: 16rpx;
  background: rgba(var(--color-overlay-rgb), 0.04);
  margin-bottom: 16rpx;
  transition: opacity 0.15s ease;
}

.sheet__item:active {
  opacity: 0.7;
}

.sheet__item {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sheet__item--selected {
  background: var(--color-accent-tint);
}

.sheet__item--selected .sheet__item-text {
  color: var(--color-accent-deep);
  font-weight: 600;
}

.sheet__item-text {
  font-size: 26rpx;
  color: var(--color-text-primary);
}

.sheet__item-check {
  font-size: 26rpx;
  line-height: 1;
  color: var(--color-accent-deep);
  font-weight: 700;
}

.sheet__cancel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 20rpx;
  background: rgba(var(--color-overlay-rgb), 0.06);
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-secondary);
}

.sheet__cancel:active {
  opacity: 0.7;
}
