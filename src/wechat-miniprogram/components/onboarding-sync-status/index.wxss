/* 首次同步状态卡（devops#1015）。颜色全部走 theme.wxss 令牌（组件内禁止
   重定义令牌，#665），danger/warning/success 用各自的 -rgb 组合透明度。 */

.oss {
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--color-hairline);
  background: var(--color-card);
  font-size: 24rpx;
  color: var(--color-text-primary);
}

.oss--bad {
  border-color: rgba(215, 67, 49, 0.35);
  background: rgba(215, 67, 49, 0.05);
}

.oss--warn {
  border-color: rgba(216, 154, 61, 0.35);
  background: rgba(216, 154, 61, 0.06);
}

/* —— 头部：状态点 + 标题 + 折叠 —— */

.oss__head {
  display: flex;
  align-items: center;
}

.oss__dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 14rpx;
  background: var(--color-success);
}

.oss--bad .oss__dot {
  background: var(--color-danger);
}

.oss--warn .oss__dot {
  background: var(--color-warning);
}

.oss__dot--pulse {
  animation: oss-pulse 1.6s ease-in-out infinite;
}

@keyframes oss-pulse {
  0%,
  100% {
    opacity: 1;
  }
  50% {
    opacity: 0.35;
  }
}

.oss__title {
  flex: 1;
  min-width: 0;
  font-weight: 600;
  font-size: 26rpx;
}

.oss__state {
  color: var(--color-text-secondary);
  font-weight: 400;
}

.oss__toggle {
  color: var(--color-text-muted);
  font-size: 22rpx;
  padding: 8rpx 0 8rpx 16rpx;
}

/* —— 摘要 chips：近期数据 / 近期分析 / 历史扩展 / 历史补齐 / 辅助任务 —— */

.oss__chips {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.oss-chip {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  border: 1rpx solid var(--color-hairline);
  background: var(--color-bg-sunken);
  font-size: 20rpx;
  line-height: 1.4;
}

.oss-chip__label {
  color: var(--color-text-muted);
  margin-right: 8rpx;
}

.oss-chip__text {
  font-weight: 500;
}

.oss-chip--good .oss-chip__text {
  color: var(--color-success);
}

.oss-chip--warn {
  border-color: rgba(216, 154, 61, 0.4);
  background: rgba(216, 154, 61, 0.08);
}

.oss-chip--warn .oss-chip__text {
  color: var(--color-warning);
}

.oss-chip--bad {
  border-color: rgba(215, 67, 49, 0.4);
  background: rgba(215, 67, 49, 0.06);
}

.oss-chip--bad .oss-chip__text {
  color: var(--color-danger);
}

.oss-chip--muted .oss-chip__text {
  color: var(--color-text-secondary);
}

/* —— 动作行 —— */

.oss__actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 24rpx;
  margin-top: 16rpx;
}

.oss__link {
  color: var(--color-accent-deep);
  font-size: 22rpx;
  text-decoration: underline;
}

.oss__link--muted {
  color: var(--color-text-muted);
}

.oss__btn {
  padding: 8rpx 20rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(215, 67, 49, 0.45);
  color: var(--color-danger);
  font-size: 22rpx;
}

.oss__btn--disabled {
  opacity: 0.5;
}

/* —— 展开区：顶层错误 + 逐阶段明细 + 脚注 —— */

.oss__body {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--color-border-soft);
}

.oss__alert {
  color: var(--color-danger);
  font-size: 22rpx;
  margin-bottom: 10rpx;
}

.oss-stage {
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  border: 1rpx solid var(--color-border-soft);
  background: var(--color-bg);
  margin-bottom: 12rpx;
}

.oss-stage__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.oss-stage__label {
  font-weight: 500;
  font-size: 22rpx;
}

.oss-stage__readiness {
  font-size: 20rpx;
  padding: 4rpx 10rpx;
  border-radius: 8rpx;
  border: 1rpx solid var(--color-hairline);
}

.oss-stage__readiness--good {
  color: var(--color-success);
}

.oss-stage__readiness--warn {
  color: var(--color-warning);
  border-color: rgba(216, 154, 61, 0.4);
}

.oss-stage__readiness--bad {
  color: var(--color-danger);
  border-color: rgba(215, 67, 49, 0.4);
}

.oss-stage__readiness--muted {
  color: var(--color-text-secondary);
}

.oss-stage__meta {
  margin-top: 8rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
}

/* 合法缺测（厂商真没有）与失败分开：warn 不带“出错”语义 */
.oss-stage__gaps {
  margin-top: 6rpx;
  color: var(--color-warning);
  font-size: 20rpx;
}

.oss-stage__error {
  margin-top: 6rpx;
  color: var(--color-danger);
  font-size: 20rpx;
}

.oss__footnote {
  margin-top: 4rpx;
  color: var(--color-text-muted);
  font-size: 20rpx;
  line-height: 1.6;
}
