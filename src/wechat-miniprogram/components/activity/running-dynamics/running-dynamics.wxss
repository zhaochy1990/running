.dynamics-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  padding: 0 40rpx;
  color: var(--color-text-primary);
  white-space: nowrap;
}

.dynamics-heading {
  display: flex;
  flex: none;
  align-items: center;
  font-size: 29rpx;
  font-weight: 700;
}

.dynamics-info {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 84rpx;
  min-width: 0;
  max-width: 84rpx;
  width: 84rpx;
  height: 84rpx;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--color-text-secondary);
}

.dynamics-info::after {
  border: 0;
}

.dynamics-info-icon {
  width: 28rpx;
  height: 28rpx;
  line-height: 28rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  text-align: center;
  font-size: 20rpx;
  font-weight: 600;
}

.dynamics-help {
  margin: 0 40rpx 16rpx;
  padding: 16rpx 24rpx;
  border-radius: 16rpx;
  background: var(--color-bg-sunken);
  color: var(--color-text-bright);
  font-size: 24rpx;
  line-height: 1.55;
}

.dynamics-help view + view {
  margin-top: 10rpx;
}

.dynamics-emphasis {
  font-weight: 650;
}

.dynamics-card {
  padding: 24rpx 40rpx 20rpx;
  margin-bottom: 16rpx;
  background: var(--color-card);
  border-top: 1rpx solid var(--color-border-soft);
  border-bottom: 1rpx solid var(--color-border-soft);
  color: var(--color-text-primary);
}

.dynamics-card-title {
  color: var(--color-text-bright);
  font-size: 26rpx;
  font-weight: 650;
}

.dynamics-readings {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 12rpx;
  margin: 12rpx 0 6rpx;
  font-variant-numeric: tabular-nums;
}

.dynamics-average {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  gap: 6rpx;
}

.dynamics-value {
  font-size: 50rpx;
  line-height: 1.1;
  font-weight: 700;
}

.dynamics-selection {
  text-align: right;
  white-space: nowrap;
}

.dynamics-range {
  font-size: 26rpx;
  font-weight: 650;
}

.dynamics-caption {
  color: var(--color-text-secondary);
  font-size: 23rpx;
}

.dynamics-chart {
  display: block;
  width: 100%;
  height: 216rpx;
}
