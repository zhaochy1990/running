.control {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  height: 72rpx;
  align-items: center;
  border: 1rpx solid var(--color-hairline);
  border-radius: 12rpx;
  background: var(--color-bg);
  color: var(--color-field-text);
}

.value {
  box-sizing: border-box;
  flex: 1;
  min-width: 0;
  height: 100%;
  padding-left: 14rpx;
}

.picker {
  box-sizing: border-box;
  min-width: 60rpx;
  height: 70rpx;
  line-height: 60rpx;
  color: var(--color-accent-deep);
  font-size: 32rpx;
  text-align: center;
}
