/* 教练卡片：深色浅浮雕，accent 用品牌黄绿（与配速卡海报一致）。 */
.cc-card {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.cc-card__head {
  display: flex;
  align-items: flex-start;
}

.cc-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cc-card__title-wrap {
  flex: 1;
  min-width: 0;
}

.cc-card__title-row {
  display: flex;
  align-items: center;
}

.cc-card__title {
  font-size: 15px;
  font-weight: 600;
  color: #f2f2f3;
}

.cc-card__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 10px;
  color: #d8ff3e;
  background: rgba(216, 255, 62, 0.12);
  border-radius: 8rpx;
}

.cc-card__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 12px;
  line-height: 18px;
  color: #b8b8bc;
}

.cc-card__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 20rpx;
  padding: 14rpx 0;
  background: rgba(216, 255, 62, 0.14);
  border-radius: 12rpx;
}

.cc-card__cta-text {
  font-size: 13px;
  font-weight: 600;
  color: #d8ff3e;
}

.cc-card__cta-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
  transform: rotate(180deg);
}
