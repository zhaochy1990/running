/* 教练卡片：深色浅浮雕，accent 主题藕粉（var 引用 styles/dark.wxss 令牌；
   coach 页已 @import 该令牌组——组件用变量，换主题色随 dark.wxss 一处生效）。 */
.cc-card {
  width: 100%;
  box-sizing: border-box;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.cc-card__head {
  display: flex;
  align-items: flex-start;
}

.cc-card__icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.cc-card__title-wrap {
  flex: 1;
  min-width: 0;
}

.cc-card__title-row {
  display: flex;
  align-items: center;
}

.cc-card__title {
  font-size: 15px;
  font-weight: 600;
  color: #f2f2f3;
}

.cc-card__badge {
  margin-left: 12rpx;
  padding: 2rpx 12rpx;
  font-size: 10px;
  color: var(--color-accent, #ff6363);
  background: rgba(var(--color-accent-rgb), 0.12);
  border-radius: 8rpx;
}

.cc-card__subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 12px;
  line-height: 18px;
  color: #b8b8bc;
}

.cc-card__actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cc-card__cta {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 14rpx 0;
  background: var(--color-accent, #ff6363);
  border-radius: 12rpx;
}

/* 次级动作：主题色浅底 + 主题色文字，与主 CTA 同色系，层级靠深浅区分。 */
.cc-card__cta--ghost {
  flex: none;
  padding: 14rpx 32rpx;
  background: rgba(var(--color-accent-rgb), 0.16);
  border: 1rpx solid rgba(var(--color-accent-rgb), 0.45);
}

.cc-card__cta-text {
  font-size: 13px;
  font-weight: 600;
  color: #ffffff;
}

.cc-card__cta-text--ghost {
  color: var(--color-accent, #ff6363);
}

.cc-card__cta-arrow {
  width: 24rpx;
  height: 24rpx;
  margin-left: 4rpx;
}
