/* 训练调整追问弹窗（#858 PR-E）—— 底部半屏弹层，结构对齐 push-date-sheet
   （mask + sheet + handle），颜色/圆角/间距全走 styles/theme.wxss 令牌；
   浅色主题、无边框卡片风格（分区靠底色与留白）。 */

.adj-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: rgba(0, 0, 0, 0.6);
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.adj-sheet {
  width: 100%;
  box-sizing: border-box;
  background: var(--color-card);
  border-radius: 32rpx 32rpx 0 0;
  padding: 24rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  display: flex;
  flex-direction: column;
  animation: adj-sheet-up 0.2s ease;
}

@keyframes adj-sheet-up {
  from {
    transform: translateY(100%);
    opacity: 0.6;
  }
  to {
    transform: translateY(0);
    opacity: 1;
  }
}

.adj-sheet__handle {
  width: 72rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: rgba(var(--color-overlay-rgb), 0.2);
  margin: 0 auto 24rpx;
}

.adj-sheet__title {
  font-size: 30rpx;
  line-height: 46rpx;
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 8rpx;
}

/* Step1 副行证据 / Step2 证据行 */
.adj-sheet__sub {
  font-size: 24rpx;
  line-height: 38rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 20rpx;
}

/* —— Step1 六选项（单选列表） —— */
.adj-options {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.adj-option {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 22rpx 24rpx;
  border-radius: 20rpx;
  background: var(--color-bg-sunken);
}

.adj-option--on {
  background: var(--color-accent-tint);
}

.adj-option__dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  border: 4rpx solid var(--color-text-tertiary);
  box-sizing: border-box;
  flex-shrink: 0;
}

.adj-option__dot--on {
  border-color: var(--color-accent);
  background: var(--color-accent);
  /* 内白点：实心选中态 */
  box-shadow: inset 0 0 0 6rpx var(--color-card);
}

.adj-option__label {
  font-size: 28rpx;
  line-height: 42rpx;
  color: var(--color-text-primary);
}

.adj-option--on .adj-option__label {
  color: var(--color-accent-deep);
  font-weight: 600;
}

/* —— 主 CTA（实心主题色；禁用态降透明度） —— */
.adj-cta {
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  background: var(--color-accent);
  color: var(--color-on-accent);
}

.adj-cta--disabled {
  opacity: 0.5;
}

.adj-cta--ghost {
  background: var(--color-bg-sunken);
  color: var(--color-text-secondary);
  flex: 1;
}

.adj-cta--fill {
  flex: 1.4;
}

.adj-cta-row {
  display: flex;
  gap: 20rpx;
}

.adj-cta--mt {
  margin-top: 28rpx;
  flex: none;
}

/* —— Step2：diff 表 —— */
.adj-window {
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 8rpx;
}

.adj-diff-scroll {
  max-height: 480rpx;
  margin-top: 16rpx;
}

.adj-diff {
  background: var(--color-bg-sunken);
  border-radius: 20rpx;
  padding: 8rpx 24rpx;
}

.adj-diff__head,
.adj-diff__row {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.adj-diff__head {
  border-bottom: 1rpx solid var(--color-hairline);
}

.adj-diff__th {
  flex: 1;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.adj-diff__row {
  border-bottom: 1rpx solid var(--color-border-soft);
}

.adj-diff__row:last-child {
  border-bottom: none;
}

.adj-diff__td {
  flex: 1;
  font-size: 26rpx;
  line-height: 40rpx;
  color: var(--color-text-secondary);
}

.adj-diff__th--num,
.adj-diff__td--num {
  text-align: right;
}

.adj-diff__td--strong {
  color: var(--color-text-primary);
  font-weight: 600;
}

/* 降量行变化列用 accent 强调（浅底加深阶） */
.adj-diff__td--down {
  color: var(--color-accent-deep);
  font-weight: 600;
}

.adj-audit {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 38rpx;
  color: var(--color-text-muted);
  text-align: center;
}

/* —— loading / timeout —— */
.adj-loading {
  padding: 48rpx 24rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.adj-loading__spinner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid var(--color-border-soft);
  border-top-color: var(--color-accent);
  animation: adj-spin 0.8s linear infinite;
  margin-bottom: 12rpx;
}

@keyframes adj-spin {
  to {
    transform: rotate(360deg);
  }
}

.adj-loading__text {
  font-size: 28rpx;
  line-height: 44rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
}

.adj-loading__hint {
  font-size: 24rpx;
  line-height: 38rpx;
  color: var(--color-text-tertiary);
  text-align: center;
}
