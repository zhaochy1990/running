.gate {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 48rpx;
}

.gate__icon {
  width: 96rpx;
  height: 96rpx;
  margin-bottom: 32rpx;
  opacity: 0.55;
}

.gate__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  text-align: center;
}

.gate__subtitle {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

.gate__btn {
  margin-top: 48rpx;
  padding: 20rpx 96rpx;
  border-radius: 999rpx;
  background: var(--color-accent);
  color: var(--color-on-accent);
  font-size: 30rpx;
  font-weight: 600;
}
