/* 主题色令牌唯一真相源：styles/theme.wxss（#816；换主题只改该文件
   与镜像常量 utils/theme.ts）。本文件只保留非颜色工具令牌（间距 /
   圆角 / 字号 / 字重）与通用工具类，不定义任何色值。 */
@import "styles/theme.wxss";

/* 通用工具令牌（非颜色） */
page {
  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;

  --font-size-xs: 22rpx;
  --font-size-sm: 26rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-2xl: 44rpx;
  --font-size-3xl: 56rpx;

  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
}

/* 通用工具类 */
.container {
  padding: var(--spacing-lg);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-accent {
  color: var(--color-accent);
}

.text-sm {
  font-size: var(--font-size-sm);
}

.text-md {
  font-size: var(--font-size-md);
}

.text-lg {
  font-size: var(--font-size-lg);
}

.text-xl {
  font-size: var(--font-size-xl);
}

.font-medium {
  font-weight: var(--font-weight-medium);
}

.font-semibold {
  font-weight: var(--font-weight-semibold);
}

.font-bold {
  font-weight: var(--font-weight-bold);
}

/* 空态卡片（各页通用，自包含不依赖 .card；色值走主题令牌，随主题切换） */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: var(--color-card);
  border: 1rpx solid rgba(var(--color-overlay-rgb), 0.06);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  margin-bottom: 48rpx;
}

.empty-card__title {
  font-size: 27rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.empty-card__sub {
  font-size: 20rpx;
  color: var(--color-text-secondary);
  margin-top: 12rpx;
}
