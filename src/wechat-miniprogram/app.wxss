/* 全局样式变量 */
page {
  --color-primary: #1c1c1e;
  --color-secondary: #8a8a8e;
  --color-accent: #ff6b35;
  --color-success: #34c759;
  --color-warning: #ff9f0a;
  --color-danger: #ff3b30;
  --color-bg: #f7f7f8;
  --color-card: #ffffff;
  --color-border: #e5e5ea;
  --color-text-primary: #1c1c1e;
  --color-text-secondary: #8a8a8e;
  --color-text-tertiary: #c7c7cc;

  --spacing-xs: 8rpx;
  --spacing-sm: 16rpx;
  --spacing-md: 24rpx;
  --spacing-lg: 32rpx;
  --spacing-xl: 48rpx;

  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;

  --font-size-xs: 22rpx;
  --font-size-sm: 26rpx;
  --font-size-md: 28rpx;
  --font-size-lg: 32rpx;
  --font-size-xl: 36rpx;
  --font-size-2xl: 44rpx;
  --font-size-3xl: 56rpx;

  --font-weight-regular: 400;
  --font-weight-medium: 500;
  --font-weight-semibold: 600;
  --font-weight-bold: 700;
}

/* 通用工具类 */
.container {
  padding: var(--spacing-lg);
}

.card {
  background: var(--color-card);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-md);
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-between {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.text-primary {
  color: var(--color-text-primary);
}

.text-secondary {
  color: var(--color-text-secondary);
}

.text-accent {
  color: var(--color-accent);
}

.text-sm {
  font-size: var(--font-size-sm);
}

.text-md {
  font-size: var(--font-size-md);
}

.text-lg {
  font-size: var(--font-size-lg);
}

.text-xl {
  font-size: var(--font-size-xl);
}

.font-medium {
  font-weight: var(--font-weight-medium);
}

.font-semibold {
  font-weight: var(--font-weight-semibold);
}

.font-bold {
  font-weight: var(--font-weight-bold);
}

/* 空态卡片（各页通用，深色主题，自包含不依赖 .card） */
.empty-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #101111;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  border-radius: 24rpx;
  padding: 64rpx 32rpx;
  margin-bottom: 48rpx;
}

.empty-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #e3e2e5;
}

.empty-card__sub {
  font-size: 24rpx;
  color: #9c9c9d;
  margin-top: 12rpx;
}
